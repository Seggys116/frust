+fn put_text_blob(entry_dir: &Path, name: &str, bytes: Vec<u8>) -> io::Result<(Blob, Option<String>)> {
+    if bytes.len() > INLINE_TEXT_BYTES {
+        return put_blob(entry_dir, name, bytes.as_slice()).map(|blob| (blob, None));
+    }
+    match String::from_utf8(bytes) {
+        Ok(text) => {
+            let size = text.len() as u64;
+            let blake3 = blake3::hash(text.as_bytes()).to_hex().to_string();
+            stat_bytes(&STATS.hashed_bytes, size);
+            Ok((Blob { name: name.to_string(), size, blake3 }, Some(text)))
+        }
+        Err(err) => put_blob(entry_dir, name, err.as_bytes()).map(|blob| (blob, None)),
+    }
