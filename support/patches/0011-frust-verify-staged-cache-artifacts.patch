+/// What a staged copy of a blob must be, and how the destination is finished.
+struct StageSpec<'a> {
+    /// BLAKE3 hex of the blob.
+    hash: &'a str,
+    /// The blob's recorded size, when the caller has it.
+    size: Option<u64>,
+    stamp: FileTime,
+    /// Whether a cloned destination is read back and checked. Callers that verified the blob
+    /// just before cloning it can skip the extra pass.
+    check_clone: bool,
+}
+
+/// Reflink, else copy; never a hard link. The result is a private, writable file stamped
+/// `spec.stamp`: a shared inode would keep the blob's old mtime (stale-looking to Cargo's
+/// dependency checks) and Cargo's mtime shifts would write through to the shared blob.
+///
+/// A blob can share its inode with the target file it was stored from, so the staged bytes are
+/// checked against `spec`: the copy hashes while it copies, and a clone is read back from the
+/// destination. A failure removes `dst`; `Corrupt` means the blob is not what was stored.
+fn stage_blob(src: &Path, dst: &Path, spec: &StageSpec<'_>) -> Result<(), StageError> {
+    let mut input = File::open(src).map_err(|err| match err.kind() {
+        io::ErrorKind::NotFound => StageError::Corrupt("blob-missing"),
+        _ => StageError::Io(err),
+    })?;
+    let len = input.metadata()?.len();
+    if spec.size.is_some_and(|size| size != len) {
+        return Err(StageError::Corrupt("blob-size"));
+    }
+    let (mut output, cloned) = create_clone_or_empty(&input, src, dst)?;
+    let staged = fill_staged(&mut input, &mut output, len, cloned, spec).and_then(|()| {
+        make_writable_file(&output, dst)?;
+        Ok(filetime::set_file_handle_times(&output, None, Some(spec.stamp))?)
+    });
+    if staged.is_err() {
+        drop(output);
+        let _ = fs::remove_file(dst);
+    }
+    staged
+}
+
+/// Leaves `output` holding exactly the blob and proves it matches `spec`. A cloned destination
+/// already has the blob's data and is hashed in place; an empty one is filled by a single pass
+/// that hashes what it copies.
+fn fill_staged(
+    input: &mut File,
+    output: &mut File,
+    len: u64,
+    cloned: bool,
+    spec: &StageSpec<'_>,
+) -> Result<(), StageError> {
+    use io::{Seek, SeekFrom};
+    let (size, hash) = if cloned {
+        if !spec.check_clone {
+            return Ok(());
+        }
+        output.seek(SeekFrom::Start(0))?;
+        let result = stream_blake3(output, len, None)?;
+        stat_bytes(&STATS.hashed_bytes, result.0);
+        result
+    } else {
+        let result = stream_blake3(input, len, Some(output))?;
+        stat_bytes(&STATS.hashed_bytes, result.0);
+        stat_bytes(&STATS.written_bytes, result.0);
+        result
+    };
+    if spec.size.is_some_and(|expected| expected != size) {
+        return Err(StageError::Corrupt("blob-size"));
+    }
+    if !same_hash(&hash, spec.hash) {
+        return Err(StageError::Corrupt("blob-hash"));
+    }
+    Ok(())
+}
+
+fn same_hash(hash: &[u8; 32], hex_text: &str) -> bool {
+    blake3::Hash::from_hex(hex_text).is_ok_and(|expected| expected.as_bytes() == hash)
+}
+
+/// Clone-or-copy for callers that checked the blob themselves just before: a clone is trusted
+/// and a copy still verifies its own bytes.
+fn clone_or_copy(src: &Path, dst: &Path, expected: &str, stamp: FileTime) -> io::Result<()> {
+    let spec = StageSpec { hash: expected, size: None, stamp, check_clone: false };
+    stage_blob(src, dst, &spec).map_err(|err| match err {
+        StageError::Io(err) => err,
+        StageError::Corrupt(reason) => io::Error::other(format!("blob changed while restoring: {reason}")),
+    })
+}
+
+/// Reads a small blob whole, checking its size and BLAKE3 before anything uses the bytes.
+fn read_blob(entry_dir: &Path, blob: &Blob) -> Result<Vec<u8>, Fail> {
+    let mut file = File::open(entry_dir.join(&blob.blake3)).map_err(|err| match err.kind() {
+        io::ErrorKind::NotFound => Fail::Corrupt("blob-missing"),
+        _ => Fail::Reason("restore-failed"),
+    })?;
+    let mut bytes = Vec::new();
+    if let Ok(len) = file.metadata().map(|meta| meta.len()) {
+        if len != blob.size {
+            return Err(Fail::Corrupt("blob-size"));
+        }
+        let len = usize::try_from(len).map_err(|_| Fail::Corrupt("blob-size"))?;
+        bytes.try_reserve_exact(len).map_err(|_| Fail::Reason("restore-failed"))?;
+    }
+    file.read_to_end(&mut bytes).map_err(|_| Fail::Reason("restore-failed"))?;
+    stat_bytes(&STATS.hashed_bytes, bytes.len() as u64);
+    if bytes.len() as u64 != blob.size {
+        return Err(Fail::Corrupt("blob-size"));
+    }
+    if !same_hash(blake3::hash(&bytes).as_bytes(), &blob.blake3) {
+        return Err(Fail::Corrupt("blob-hash"));
+    }
+    Ok(bytes)
+}
