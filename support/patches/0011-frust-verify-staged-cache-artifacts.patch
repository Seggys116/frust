+/// Why one blob could not be staged: damage in the store, or trouble at the destination or while
+/// reading, which says nothing about the entry and must not cost it its place.
+#[derive(Debug)]
+enum StageError {
+    Corrupt(&'static str),
+    Io(io::Error),
+}
+
+impl From<io::Error> for StageError {
+    fn from(err: io::Error) -> StageError {
+        StageError::Io(err)
+    }
+}
+
+impl From<StageError> for Fail {
+    fn from(err: StageError) -> Fail {
+        match err {
+            StageError::Corrupt(reason) => Fail::Corrupt(reason),
+            StageError::Io(_) => Fail::Reason("restore-failed"),
+        }
+    }
+}
