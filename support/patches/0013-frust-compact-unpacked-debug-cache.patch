+
+    #[test]
+    fn malformed_archives_are_not_indexed() {
+        let good = gnu();
+        let corrupt = |at: &[u8], with: &[u8]| {
+            let mut bytes = good.clone();
+            let start = position(&bytes, at) as usize;
+            bytes[start..start + with.len()].copy_from_slice(with);
+            bytes
+        };
+        assert!(index_of(&good).is_some());
+        assert!(index_of(b"").is_none());
+        assert!(index_of(b"!<thin>\n").is_none());
+        assert!(index_of(&good[..good.len() - 3]).is_none(), "member runs past the end");
+        assert!(index_of(&good[..70]).is_none(), "name table runs past the end");
+        assert!(index_of(&good[..150]).is_none(), "cut inside a header");
+        assert!(index_of(&corrupt(b"`\n", b"~\n")).is_none(), "bad header terminator");
+        assert!(index_of(&corrupt(b"/0   ", b"/99  ")).is_none(), "long name outside the table");
+        assert!(index_of(&corrupt(b"18   ", b"+8   ")).is_none(), "signed size");
+        assert!(index_of(&corrupt(b"18   ", b"     ")).is_none(), "empty size");
+        assert!(index_of(&corrupt(b"18   ", b"99999")).is_none(), "size past the end");
+        let mut huge = good.clone();
+        let size_field = position(&good, b"18   ") as usize;
+        huge[size_field..size_field + 10].copy_from_slice(b"9999999999");
+        assert!(index_of(&huge).is_none(), "size near the field's maximum");
+        let inline = bsd();
+        let mut bytes = inline.clone();
+        let at = position(&inline, b"#1/28") as usize;
+        bytes[at..at + 5].copy_from_slice(b"#1/99");
+        assert!(index_of(&bytes).is_none(), "inline name longer than the member");
+    }
+
+    #[test]
+    fn comparison_hashes_only_exactly_equal_bytes() {
+        let dir = tempdir().unwrap();
+        let container_bytes: Vec<u8> = (0..3 * HASH_BUF + 11).map(|i| (i * 7 % 253) as u8).collect();
+        let container_path = dir.path().join("container");
+        fs::write(&container_path, &container_bytes).unwrap();
+        let sidecar_path = dir.path().join("sidecar");
+        let (offset, len) = (5usize, 2 * HASH_BUF + 3);
+        let range = &container_bytes[offset..offset + len];
+        let check = |bytes: &[u8], at: u64, len: u64| {
+            fs::write(&sidecar_path, bytes).unwrap();
+            let mut container = File::open(&container_path).unwrap();
+            hash_if_range_equal(&sidecar_path, &mut container, at, len).unwrap()
+        };
+        assert_eq!(check(range, offset as u64, len as u64), Some(*blake3::hash(range).as_bytes()));
+        let mut last = range.to_vec();
+        *last.last_mut().unwrap() ^= 1;
+        assert_eq!(check(&last, offset as u64, len as u64), None, "last byte differs");
+        let mut first = range.to_vec();
+        first[0] ^= 1;
+        assert_eq!(check(&first, offset as u64, len as u64), None, "first byte differs");
+        assert_eq!(check(range, offset as u64, len as u64 - 1), None, "length disagrees");
+        assert_eq!(check(&range[..len - 1], offset as u64, len as u64 - 1), Some(*blake3::hash(&range[..len - 1]).as_bytes()));
+        let tail = container_bytes.len() as u64 - 4;
+        assert_eq!(check(&container_bytes[tail as usize..], tail, 4), Some(*blake3::hash(&container_bytes[tail as usize..]).as_bytes()));
+        assert_eq!(check(&[0; 8], tail, 8), None, "range runs past the container");
+    }
+
+    #[test]
+    fn containers_only_offer_proven_ranges_of_rlibs() {
+        let dir = tempdir().unwrap();
+        let bytes = gnu();
+        let hash = hex(blake3::hash(&bytes).as_bytes());
+        fs::write(dir.path().join(&hash), &bytes).unwrap();
+        let rlib = Blob { name: "libfoo-abc.rlib".to_string(), size: bytes.len() as u64, blake3: hash.clone() };
+        let sidecar = dir.path().join("sidecar");
+        fs::write(&sidecar, SECOND).unwrap();
+
+        let mut containers = Containers::open(dir.path(), std::slice::from_ref(&rlib));
+        let (blob, range) = containers.locate(SECOND_NAME, &sidecar).unwrap().unwrap();
+        assert_eq!((blob.size, blob.blake3.as_str()), (SECOND.len() as u64, hex(blake3::hash(SECOND).as_bytes()).as_str()));
+        assert_eq!((range.container.as_str(), range.offset), (hash.as_str(), position(&bytes, SECOND)));
+        assert_eq!(containers.locate("other.o", &sidecar).unwrap(), None, "name not in the archive");
+        fs::write(&sidecar, b"second member bytes!?").unwrap();
+        assert_eq!(containers.locate(SECOND_NAME, &sidecar).unwrap(), None, "same size, other bytes");
+        fs::write(&sidecar, b"").unwrap();
+        assert_eq!(containers.locate(SECOND_NAME, &sidecar).unwrap(), None, "empty sidecar");
+
+        fs::write(&sidecar, SECOND).unwrap();
+        let rmeta = Blob { name: "libfoo-abc.rmeta".to_string(), ..rlib.clone() };
+        assert_eq!(Containers::open(dir.path(), &[rmeta]).locate(SECOND_NAME, &sidecar).unwrap(), None);
+        let wrong_size = Blob { size: rlib.size + 1, ..rlib.clone() };
+        assert_eq!(Containers::open(dir.path(), &[wrong_size]).locate(SECOND_NAME, &sidecar).unwrap(), None);
+        let missing = Blob { blake3: "0".repeat(64), ..rlib };
+        assert_eq!(Containers::open(dir.path(), &[missing]).locate(SECOND_NAME, &sidecar).unwrap(), None);
+    }
