+    pub(crate) fn unhex(text: &str) -> Vec<u8> {
+        let digits: Vec<u8> = text.bytes().filter(u8::is_ascii_hexdigit).collect();
+        assert!(digits.len() % 2 == 0, "odd number of hex digits");
+        digits
+            .chunks(2)
+            .map(|pair| u8::from_str_radix(std::str::from_utf8(pair).unwrap(), 16).unwrap())
+            .collect()
+    }
+
+    pub(crate) fn gnu() -> Vec<u8> {
+        unhex(GNU)
+    }
+
+    pub(crate) fn bsd() -> Vec<u8> {
+        unhex(BSD)
+    }
+
+    pub(crate) fn darwin() -> Vec<u8> {
+        unhex(DARWIN)
+    }
+
+    /// A BSD-style archive with inline names, which may repeat.
+    pub(crate) fn bsd_members(members: &[(&str, &[u8])]) -> Vec<u8> {
+        let mut out = b"!<arch>\n".to_vec();
+        for (name, data) in members {
+            let size = name.len() + data.len();
+            let header = format!("#1/{:<13}{:<12}{:<6}{:<6}{:<8}{:<10}`\n", name.len(), 0, 0, 0, "644", size);
+            assert_eq!(header.len(), 60);
+            out.extend(header.as_bytes());
+            out.extend(name.as_bytes());
+            out.extend(*data);
+            if size % 2 == 1 {
+                out.push(b'\n');
+            }
+        }
+        out
+    }
+}
