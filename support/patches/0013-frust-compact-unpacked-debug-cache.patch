+        assert_eq!(index.find(FIRST_NAME, FIRST.len() as u64 + 6), Some(position(&bytes, FIRST)));
+        assert_eq!(index.find(FIRST_NAME, FIRST.len() as u64 + 7), None);
+        assert!(index_of(b"!<arch>\n").unwrap().find("a.o", 1).is_none());
+    }
+
+    #[test]
+    fn repeated_names_have_no_candidate() {
+        let bytes = bsd_members(&[("foo-abc.x.rcgu.o", b"one"), ("foo-abc.y.rcgu.o", b"two"), ("foo-abc.x.rcgu.o", b"1")]);
+        let index = index_of(&bytes).unwrap();
+        assert_eq!(index.find("foo-abc.x.rcgu.o", 3), None);
+        assert_eq!(index.find("foo-abc.x.rcgu.o", 1), None);
+        assert_eq!(index.find("foo-abc.y.rcgu.o", 3), Some(position(&bytes, b"two")));
