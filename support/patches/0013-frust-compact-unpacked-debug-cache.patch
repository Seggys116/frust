+    /// Compiles and stores a unit whose rlib is `rlib` and whose debug sidecars are `sidecars`.
+    fn store_with_sidecars(cache: &UnitCache, cmd: &ProcessBuilder, rlib: &[u8], sidecars: &[(&str, &[u8])]) -> String {
+        let _ = cache.store.clone_supported.set(false);
+        let Lookup::Miss(pending) = cache.lookup(cmd) else { panic!("expected a miss") };
+        fake_compile(cache, &[], &[]);
+        fs::write(&cache.outputs[0], rlib).unwrap();
+        for (index, (name, bytes)) in sidecars.iter().enumerate() {
+            let path = cache.out_dir.join(name);
+            fs::write(&path, bytes).unwrap();
+            filetime::set_file_mtime(&path, sidecar_stamp(index)).unwrap();
+        }
+        cache.store(&pending);
+        pending.key
+    }
