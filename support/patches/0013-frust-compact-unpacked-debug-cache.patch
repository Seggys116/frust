+/// Stores a debug object as a range of an output archive when the archive holds exactly its
+/// bytes under its name, and as its own blob otherwise: any doubt about the member, the range
+/// or the bytes, or a blob of the same content already in the entry, keeps the standalone form.
+fn put_debug_object(
+    entry_dir: &Path,
+    name: &str,
+    path: &Path,
+    containers: &mut Containers,
+) -> io::Result<(Blob, Option<ArchiveRange>)> {
+    if let Ok(Some((blob, range))) = containers.locate(name, path) {
+        if entry_dir.join(&blob.blake3).exists() {
+            return Ok((blob, None));
+        }
+        return Ok((blob, Some(range)));
+    }
+    Ok((put_output_blob(entry_dir, name, path)?, None))
+}
