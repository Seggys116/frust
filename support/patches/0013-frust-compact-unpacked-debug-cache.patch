+    /// Removes every produced file, restores from the store and checks bytes and stamps.
+    fn assert_restores_sidecars(cache: &UnitCache, cmd: &ProcessBuilder, sidecars: &[(&str, &[u8])]) {
+        remove_outputs(cache);
