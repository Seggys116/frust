+            ("no such member", gnu(), vec![("foo-abc.other.rcgu.dwo", SECOND.to_vec())]),
+            ("truncated archive", gnu()[..gnu().len() - 4].to_vec(), vec![(SECOND_SIDECAR, SECOND.to_vec())]),
+            (
+                "repeated member name",
+                bsd_members(&[(SECOND_SIDECAR, SECOND), (SECOND_SIDECAR, SECOND)]),
+                vec![(SECOND_SIDECAR, SECOND.to_vec())],
+            ),
+            ("empty sidecar", gnu(), vec![(FIRST_SIDECAR, Vec::new())]),
+            ("sidecar longer than member", gnu(), vec![(FIRST_SIDECAR, [FIRST, b"extra bytes".as_slice()].concat())]),
+        ];
+        for (label, rlib, files) in cases {
+            let (tmp, store) = fixture();
+            let cache = unit_cache(tmp.path(), "a", &store);
+            let cmd = split_command(&cache);
+            let sidecars: Vec<(&str, &[u8])> = files.iter().map(|(name, bytes)| (*name, bytes.as_slice())).collect();
+            let key = store_with_sidecars(&cache, &cmd, &rlib, &sidecars);
+            let entry = read_entry(&store, &key);
+            assert_eq!(entry.debug_objects.len(), sidecars.len(), "{label}");
+            for obj in &entry.debug_objects {
+                assert!(obj.archive.is_none(), "{label}");
+                assert!(store.entry_dir(&key).join(&obj.blob.blake3).is_file(), "{label}: stored on its own");
+            }
+            let json: serde_json::Value =
+                serde_json::from_slice(&fs::read(store.entry_dir(&key).join(MANIFEST)).unwrap()).unwrap();
+            assert!(json["debug_objects"][0].get("archive").is_none(), "{label}: format unchanged");
+            assert_restores_sidecars(&cache, &cmd, &sidecars);
+        }
+    }
+
+    #[test]
+    fn a_blob_already_in_the_entry_is_reused_in_either_order() {
+        use archive_range::fixtures::{bsd_members, SECOND};
+        // Sidecars restore in name order; the one outside the archive comes first, then last.
+        for (inside, outside) in [("foo-abc.b.rcgu.o", "foo-abc.a.rcgu.o"), ("foo-abc.a.rcgu.o", "foo-abc.b.rcgu.o")] {
+            let (tmp, store) = fixture();
+            let cache = unit_cache(tmp.path(), "a", &store);
+            let cmd = split_command(&cache);
+            let rlib = bsd_members(&[(inside, SECOND)]);
+            let mut sidecars: Vec<(&str, &[u8])> = vec![(inside, SECOND), (outside, SECOND)];
+            sidecars.sort();
+            let key = store_with_sidecars(&cache, &cmd, &rlib, &sidecars);
+            let entry = read_entry(&store, &key);
+            let mut by_name: Vec<_> = entry.debug_objects.iter().collect();
+            by_name.sort_by(|a, b| a.blob.name.cmp(&b.blob.name));
+            assert_eq!(by_name.len(), 2);
+            assert_eq!(by_name[0].blob.blake3, by_name[1].blob.blake3);
+            let blob_file = store.entry_dir(&key).join(&by_name[0].blob.blake3);
+            assert!(blob_file.is_file(), "the standalone copy exists once");
+            // The member inside the archive is not recorded as a range once a blob holds it.
+            let ranged = by_name.iter().filter(|obj| obj.archive.is_some()).count();
+            assert_eq!(ranged, usize::from(inside < outside));
+            assert_eq!(entry_size(&entry), stored_file_bytes(&store, &key));
+            assert_restores_sidecars(&cache, &cmd, &sidecars);
+        }
+    }
+
+    #[test]
+    fn entries_written_without_ranges_still_restore() {
+        let (tmp, store) = fixture();
+        let cache = unit_cache(tmp.path(), "a", &store);
+        let cmd = split_command(&cache);
+        let sidecars: [(&str, &[u8]); 1] = [(SECOND_SIDECAR, b"debug symbols".as_slice())];
+        let key = store_with_sidecars(&cache, &cmd, b"rlib-bytes", &sidecars);
+        // A manifest from before ranges existed has no `archive` key and parses the same.
+        let path = store.entry_dir(&key).join(MANIFEST);
+        let json: serde_json::Value = serde_json::from_slice(&fs::read(&path).unwrap()).unwrap();
+        assert!(json["debug_objects"][0].get("archive").is_none());
+        let entry: Entry = serde_json::from_value(json).unwrap();
+        assert_eq!(entry.debug_objects[0].archive, None);
+        assert_restores_sidecars(&cache, &cmd, &sidecars);
+    }
