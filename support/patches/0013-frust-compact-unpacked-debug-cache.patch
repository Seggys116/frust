+    #[test]
+    fn members_of_llvm_ar_archives_are_found_in_every_format() {
+        for (format, bytes) in [("gnu", gnu()), ("bsd", bsd()), ("darwin", darwin())] {
+            let index = index_of(&bytes).unwrap_or_else(|| panic!("{format} archive indexed"));
+            for (name, data) in [(FIRST_NAME, FIRST), ("t.o", TINY), (SECOND_NAME, SECOND)] {
+                let at = index.find(name, data.len() as u64);
+                assert_eq!(at, Some(position(&bytes, data)), "{format} {name}");
+            }
+            assert_eq!(index.find("absent.o", 4), None, "{format}");
+            assert_eq!(index.find(SECOND_NAME, SECOND.len() as u64 + 8), None, "{format}: too large");
+            assert_eq!(index.find(SECOND_NAME, 4), None, "{format}: too much left over");
+        }
+    }
+
+    #[test]
+    fn darwin_alignment_padding_belongs_to_the_member() {
+        let bytes = darwin();
