+//! Finds debug sidecars that are already exact bytes inside a stored `.rlib`.
+//!
+//! A locator, not an archive reader: it walks GNU or BSD `ar` member headers just far enough to
+//! name a candidate range, and anything unusual yields no candidate. The unit cache compares a
+//! candidate byte for byte before recording it and hashes the range again on every restore.
+
+use super::*;
+use std::io::{Seek, SeekFrom};
+
+const MAGIC: &[u8; 8] = b"!<arch>\n";
+const HEADER_LEN: u64 = 60;
+const HEADER_END: &[u8; 2] = b"`\n";
+/// Darwin `ar` pads a member to eight bytes inside the header's size, so a member may carry a
+/// few bytes after the object it holds.
+const MAX_PADDING: u64 = 7;
+const MAX_MEMBERS: usize = 1 << 20;
+const MAX_NAME_TABLE: u64 = 16 << 20;
+const MAX_INLINE_NAME: u64 = 4096;
+
+/// Where a member's data starts and how many bytes follow, or a name seen more than once.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Member {
+    Unique { offset: u64, len: u64 },
+    Ambiguous,
+}
+
+#[derive(Debug)]
+pub(super) struct ArchiveIndex {
+    members: HashMap<String, Member>,
+}
+
+impl ArchiveIndex {
+    /// Indexes an archive of `file_len` bytes, or returns `None` when it is not a plain
+    /// archive that parses cleanly to its end.
+    pub(super) fn read(file: &mut File, file_len: u64) -> io::Result<Option<ArchiveIndex>> {
+        let mut magic = [0u8; MAGIC.len()];
+        file.seek(SeekFrom::Start(0))?;
+        if file_len < MAGIC.len() as u64 || file.read_exact(&mut magic).is_err() || &magic != MAGIC {
+            return Ok(None);
+        }
+        let mut members: HashMap<String, Member> = HashMap::default();
+        let mut long_names: Option<Vec<u8>> = None;
+        let mut pos = MAGIC.len() as u64;
+        while pos < file_len {
+            let mut header = [0u8; HEADER_LEN as usize];
+            if file_len - pos < HEADER_LEN {
+                return Ok(None);
+            }
+            file.seek(SeekFrom::Start(pos))?;
+            file.read_exact(&mut header)?;
+            if &header[58..] != HEADER_END {
+                return Ok(None);
+            }
+            let Some(size) = parse_decimal(&header[48..58]) else { return Ok(None) };
+            let data = pos + HEADER_LEN;
+            let Some(end) = data.checked_add(size).filter(|end| *end <= file_len) else {
+                return Ok(None);
+            };
+            let raw = trim_end(&header[..16], b' ');
+            let name = if raw == b"/" || raw == b"/SYM64/" {
+                None
+            } else if raw == b"//" {
+                if long_names.is_some() || size > MAX_NAME_TABLE {
+                    return Ok(None);
+                }
+                file.seek(SeekFrom::Start(data))?;
+                let mut table = vec![0u8; size as usize];
+                file.read_exact(&mut table)?;
+                long_names = Some(table);
+                None
+            } else if let Some(digits) = raw.strip_prefix(b"/").filter(|d| !d.is_empty()) {
+                let table = long_names.as_deref();
+                match (parse_decimal(digits), table) {
+                    (Some(at), Some(table)) => match gnu_long_name(table, at) {
+                        Some(name) => Some((name.to_vec(), data, size)),
+                        None => return Ok(None),
+                    },
+                    _ => return Ok(None),
+                }
+            } else if let Some(digits) = raw.strip_prefix(b"#1/") {
+                let Some(inline) = parse_decimal(digits).filter(|n| *n <= size.min(MAX_INLINE_NAME)) else {
+                    return Ok(None);
+                };
+                file.seek(SeekFrom::Start(data))?;
+                let mut name = vec![0u8; inline as usize];
+                file.read_exact(&mut name)?;
+                Some((trim_end(&name, 0).to_vec(), data + inline, size - inline))
+            } else {
+                let short = raw.strip_suffix(b"/").unwrap_or(raw);
+                Some((short.to_vec(), data, size))
+            };
+            if let Some((name, offset, len)) = name {
+                if let Ok(name) = String::from_utf8(name) {
+                    if members.len() >= MAX_MEMBERS {
+                        return Ok(None);
+                    }
+                    let member = if members.contains_key(&name) {
+                        Member::Ambiguous
+                    } else {
+                        Member::Unique { offset, len }
+                    };
+                    members.insert(name, member);
+                }
+            }
+            // Members start on even offsets; the pad byte may be missing after the last one.
+            pos = end + (end & 1);
+        }
+        Ok(Some(ArchiveIndex { members }))
+    }
+
+    /// Offset of the data of the one member called `name` that can hold `size` bytes.
+    pub(super) fn find(&self, name: &str, size: u64) -> Option<u64> {
+        match self.members.get(name)? {
+            Member::Unique { offset, len } if *len >= size && *len - size <= MAX_PADDING => Some(*offset),
+            _ => None,
+        }
+    }
+}
+
+fn gnu_long_name(table: &[u8], at: u64) -> Option<&[u8]> {
+    let rest = table.get(usize::try_from(at).ok()?..)?;
+    let stop = rest.iter().position(|byte| *byte == b'\n')?;
+    let name = &rest[..stop];
+    name.strip_suffix(b"/").or(Some(name))
+}
+
+fn trim_end(bytes: &[u8], pad: u8) -> &[u8] {
+    let len = bytes.iter().rposition(|byte| *byte != pad).map_or(0, |last| last + 1);
+    &bytes[..len]
+}
+
+fn parse_decimal(field: &[u8]) -> Option<u64> {
+    let digits = trim_end(field, b' ');
+    if digits.is_empty() || !digits.iter().all(u8::is_ascii_digit) {
+        return None;
+    }
+    std::str::from_utf8(digits).ok()?.parse().ok()
+}
+
+/// Hashes `path` while proving it equals `len` bytes of `container` at `offset`, else `Ok(None)`.
+pub(super) fn hash_if_range_equal(
+    path: &Path,
+    container: &mut File,
+    offset: u64,
+    len: u64,
+) -> io::Result<Option<[u8; 32]>> {
+    let mut sidecar = File::open(path)?;
+    if sidecar.metadata()?.len() != len {
+        return Ok(None);
+    }
+    container.seek(SeekFrom::Start(offset))?;
+    let chunk = usize::try_from(len.min(HASH_BUF as u64)).unwrap_or(HASH_BUF).max(1);
+    let (mut mine, mut theirs) = (vec![0u8; chunk], vec![0u8; chunk]);
+    let mut hasher = blake3::Hasher::new();
+    let mut left = len;
+    while left > 0 {
+        let take = usize::try_from(left.min(chunk as u64)).unwrap_or(chunk);
+        if sidecar.read_exact(&mut mine[..take]).is_err() {
+            return Ok(None);
+        }
+        match container.read_exact(&mut theirs[..take]) {
+            Ok(()) => {}
+            Err(err) if err.kind() == io::ErrorKind::UnexpectedEof => return Ok(None),
+            Err(err) => return Err(err),
+        }
+        if mine[..take] != theirs[..take] {
+            return Ok(None);
+        }
+        hasher.update(&mine[..take]);
+        left -= take as u64;
+    }
+    // The sidecar must end where the range does, even if it grew after the length check.
+    if sidecar.read(&mut mine[..1])? != 0 {
+        return Ok(None);
+    }
+    stat_bytes(&STATS.hashed_bytes, len);
+    Ok(Some(*hasher.finalize().as_bytes()))
+}
+
+/// The `.rlib` outputs of the entry being written, opened from the entry directory so a
+/// candidate is checked against the very bytes a restore will read.
+pub(super) struct Containers {
+    items: Vec<Container>,
+}
+
+struct Container {
+    blob: Blob,
+    file: File,
+    index: ArchiveIndex,
+}
+
+impl Containers {
+    pub(super) fn none() -> Containers {
+        Containers { items: Vec::new() }
+    }
+
+    /// Anything that cannot be opened or indexed is left out, which only costs the saving.
+    pub(super) fn open(entry_dir: &Path, outputs: &[Blob]) -> Containers {
+        let mut items = Vec::new();
+        for blob in outputs.iter().filter(|blob| blob.name.ends_with(".rlib")) {
+            let Ok(mut file) = File::open(entry_dir.join(&blob.blake3)) else { continue };
+            let Ok(meta) = file.metadata() else { continue };
+            if meta.len() != blob.size {
+                continue;
+            }
+            if let Ok(Some(index)) = ArchiveIndex::read(&mut file, blob.size) {
+                items.push(Container { blob: blob.clone(), file, index });
+            }
+        }
+        Containers { items }
+    }
+
+    /// The range of a container that holds exactly the bytes of the file at `path`, with the
+    /// hash those bytes were proven to have.
+    pub(super) fn locate(&mut self, name: &str, path: &Path) -> io::Result<Option<(Blob, ArchiveRange)>> {
+        let meta = fs::metadata(path)?;
+        let size = meta.len();
+        if !meta.is_file() || size == 0 {
+            return Ok(None);
+        }
+        for container in &mut self.items {
+            let Some(offset) = container.index.find(name, size) else { continue };
+            let Some(hash) = hash_if_range_equal(path, &mut container.file, offset, size)? else {
+                continue;
+            };
+            let blob = Blob { name: name.to_string(), size, blake3: hex(&hash) };
+            let range = ArchiveRange { container: container.blob.blake3.clone(), offset };
+            return Ok(Some((blob, range)));
+        }
+        Ok(None)
+    }
+}
+
+/// Copies one recorded range of a stored archive into a new private file, proving the bytes
+/// are the sidecar that was recorded. Never a link or a clone: the result is its own file.
+pub(super) fn stage_range(
+    src: &Path,
+    container_size: u64,
+    offset: u64,
+    dst: &Path,
+    spec: &StageSpec<'_>,
+) -> Result<(), StageError> {
+    let size = spec.size.ok_or(StageError::Corrupt("blob-size"))?;
+    if offset.checked_add(size).is_none_or(|end| end > container_size) {
+        return Err(StageError::Corrupt("range-bounds"));
+    }
+    let mut input = File::open(src).map_err(|err| match err.kind() {
+        io::ErrorKind::NotFound => StageError::Corrupt("blob-missing"),
+        _ => StageError::Io(err),
+    })?;
+    if input.metadata()?.len() != container_size {
+        return Err(StageError::Corrupt("blob-size"));
+    }
+    input.seek(SeekFrom::Start(offset))?;
+    let mut output = OpenOptions::new().write(true).create_new(true).open(dst)?;
+    let staged = copy_range(&mut input.take(size), &mut output, size, spec).and_then(|()| {
+        make_writable_file(&output, dst)?;
+        Ok(filetime::set_file_handle_times(&output, None, Some(spec.stamp))?)
+    });
+    if staged.is_err() {
+        drop(output);
+        let _ = fs::remove_file(dst);
+    }
+    staged
+}
+
+fn copy_range(input: &mut impl Read, output: &mut File, size: u64, spec: &StageSpec<'_>) -> Result<(), StageError> {
+    let (copied, hash) = stream_blake3(input, size, Some(output))?;
+    stat_bytes(&STATS.hashed_bytes, copied);
+    stat_bytes(&STATS.written_bytes, copied);
+    if copied != size {
+        return Err(StageError::Corrupt("blob-size"));
+    }
+    if !same_hash(&hash, spec.hash) {
+        return Err(StageError::Corrupt("blob-hash"));
+    }
+    Ok(())
+}
+
