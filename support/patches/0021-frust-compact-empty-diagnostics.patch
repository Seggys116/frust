+#[cfg(all(test, unix))]
+mod frust_empty_report_tests {
+    use super::*;
+    use std::os::unix::fs::MetadataExt;
+
+    const WARNING: &str = r#"{"$message_type":"diagnostic","level":"warning"}"#;
+
+    fn options(dir: &Path, name: &str) -> OutputOptions {
+        OutputOptions {
+            format: MessageFormat::Human,
+            cache_cell: Some((dir.join(name), OnceCell::new())),
+            show_diagnostics: true,
+            warnings_seen: 0,
+            errors_seen: 0,
+            shared_empty: Some(dir.join(SHARED_EMPTY_UNUSED_EXTERNS)),
+            held_empty: false,
+        }
+    }
+
+    fn cache(dir: &Path, name: &str, lines: &[&str], share: bool) -> fs::Metadata {
+        let mut options = options(dir, name);
+        options.clear_cache();
+        for line in lines {
+            options.cache_line(line).unwrap();
+        }
+        options.finish_cache(share).unwrap();
+        drop(options);
+        fs::symlink_metadata(dir.join(name)).unwrap()
+    }
+
+    fn empty() -> String {
+        format!("{EMPTY_UNUSED_EXTERNS}\n")
+    }
+
+    #[test]
+    fn empty_reports_link_one_read_only_copy() {
+        let dir = tempfile::tempdir().unwrap();
+        let a = cache(dir.path(), "a", &[EMPTY_UNUSED_EXTERNS], true);
+        let b = cache(dir.path(), "b", &[EMPTY_UNUSED_EXTERNS], true);
+        let shared = fs::metadata(dir.path().join(SHARED_EMPTY_UNUSED_EXTERNS)).unwrap();
+        assert_eq!(
+            (a.ino(), b.ino(), shared.nlink()),
+            (shared.ino(), shared.ino(), 3)
+        );
+        assert!(shared.permissions().readonly());
+        for name in ["a", "b"] {
+            assert_eq!(fs::read_to_string(dir.path().join(name)).unwrap(), empty());
+        }
+        assert_eq!(
+            fs::read_dir(dir.path()).unwrap().count(),
+            3,
+            "no temporary files left"
+        );
+    }
+
+    #[test]
+    fn other_messages_keep_private_bytes_in_order() {
+        let dir = tempfile::tempdir().unwrap();
+        let cases: [(&str, &[&str]); 4] = [
+            ("held", &[EMPTY_UNUSED_EXTERNS, WARNING]),
+            ("after", &[WARNING, EMPTY_UNUSED_EXTERNS]),
+            ("twice", &[EMPTY_UNUSED_EXTERNS, EMPTY_UNUSED_EXTERNS]),
+            (
+                "named",
+                &[
+                    r#"{"$message_type":"unused_extern","lint_level":"force-warn","unused_extern_names":["dep"]}"#,
+                ],
+            ),
+        ];
+        for (name, lines) in cases {
+            let meta = cache(dir.path(), name, lines, true);
+            assert_eq!(meta.nlink(), 1, "{name}");
+            let text: String = lines.iter().map(|line| format!("{line}\n")).collect();
+            assert_eq!(
+                fs::read_to_string(dir.path().join(name)).unwrap(),
+                text,
+                "{name}"
+            );
+        }
+        assert!(!dir.path().join(SHARED_EMPTY_UNUSED_EXTERNS).exists());
+        let mut silent = options(dir.path(), "silent");
+        silent.finish_cache(true).unwrap();
+        assert!(!dir.path().join("silent").exists());
+    }
+
+    #[test]
+    fn failures_and_conflicts_fall_back_to_private_files() {
+        let dir = tempfile::tempdir().unwrap();
+        let failed = cache(dir.path(), "failed", &[EMPTY_UNUSED_EXTERNS], false);
+        assert_eq!(failed.nlink(), 1);
+        let shared = dir.path().join(SHARED_EMPTY_UNUSED_EXTERNS);
+        for (name, setup) in [("conflict", 0), ("symlink", 1), ("directory", 2)] {
+            drop(fs::remove_file(&shared));
+            match setup {
+                0 => fs::write(&shared, "{}\n").unwrap(),
+                1 => {
+                    fs::write(dir.path().join("decoy"), "{}\n").unwrap();
+                    std::os::unix::fs::symlink(dir.path().join("decoy"), &shared).unwrap()
+                }
+                _ => fs::create_dir(&shared).unwrap(),
+            }
+            let meta = cache(dir.path(), name, &[EMPTY_UNUSED_EXTERNS], true);
+            assert!(meta.is_file() && meta.nlink() == 1, "{name}");
+            assert_eq!(
+                fs::read_to_string(dir.path().join(name)).unwrap(),
+                empty(),
+                "{name}"
+            );
+        }
+        assert_eq!(
+            fs::read_to_string(dir.path().join("failed")).unwrap(),
+            empty()
+        );
+        let mut unshared = options(dir.path(), "unshared");
+        unshared.shared_empty = None;
+        unshared.cache_line(EMPTY_UNUSED_EXTERNS).unwrap();
+        assert_eq!(
+            fs::read_to_string(dir.path().join("unshared")).unwrap(),
+            empty()
+        );
+    }
+
+    #[test]
+    fn rewriting_a_linked_cache_leaves_the_shared_copy_intact() {
+        let dir = tempfile::tempdir().unwrap();
+        let shared = dir.path().join(SHARED_EMPTY_UNUSED_EXTERNS);
+        cache(dir.path(), "a", &[EMPTY_UNUSED_EXTERNS], true);
+        cache(dir.path(), "b", &[EMPTY_UNUSED_EXTERNS], true);
+        cache(dir.path(), "a", &[WARNING], true);
+        let mut stale = options(dir.path(), "b");
+        stale.cache_line(WARNING).unwrap();
+        drop(stale);
+        for name in ["a", "b"] {
+            assert_eq!(
+                fs::read_to_string(dir.path().join(name)).unwrap(),
+                format!("{WARNING}\n")
+            );
+        }
+        assert_eq!(fs::read_to_string(&shared).unwrap(), empty());
+        assert_eq!(fs::metadata(&shared).unwrap().nlink(), 1);
+    }
+}
