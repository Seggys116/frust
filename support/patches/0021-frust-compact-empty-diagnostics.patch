+    /// Appends one line to the message cache. A first line that is exactly
+    /// [`EMPTY_UNUSED_EXTERNS`] is withheld until a second line or [`Self::finish_cache`].
+    fn cache_line(&mut self, line: &str) -> CargoResult<()> {
+        let Some((path, cell)) = &mut self.cache_cell else {
+            return Ok(());
+        };
+        if cell.get().is_none()
+            && !self.held_empty
+            && self.shared_empty.is_some()
+            && line == EMPTY_UNUSED_EXTERNS
+        {
+            self.held_empty = true;
+            return Ok(());
+        }
+        let f = cell.try_borrow_mut_with(|| create_message_cache(path))?;
+        if std::mem::take(&mut self.held_empty) {
+            f.write_all(EMPTY_UNUSED_EXTERNS.as_bytes())?;
+            f.write_all(b"\n")?;
+        }
+        debug_assert!(!line.contains('\n'));
+        f.write_all(line.as_bytes())?;
+        f.write_all(&[b'\n'])?;
+        Ok(())
+    }
+
+    /// Writes a withheld report, as a link to the shared copy when `share` is set
+    /// and the link verifies, or else as a private file.
+    fn finish_cache(&mut self, share: bool) -> CargoResult<()> {
+        if !std::mem::take(&mut self.held_empty) {
+            return Ok(());
+        }
+        let (Some((path, _)), Some(shared)) = (&self.cache_cell, &self.shared_empty) else {
+            return Ok(());
+        };
+        if share && link_shared_empty(shared, path) {
+            return Ok(());
+        }
+        let mut f = create_message_cache(path)?;
+        f.write_all(format!("{EMPTY_UNUSED_EXTERNS}\n").as_bytes())?;
+        Ok(())
+    }
