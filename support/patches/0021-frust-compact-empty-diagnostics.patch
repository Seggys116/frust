+/// rustc's unused-externs report for a crate using every extern, under the
+/// `--force-warn=unused_crate_dependencies` Cargo passes last.
+const EMPTY_UNUSED_EXTERNS: &str =
+    r#"{"$message_type":"unused_extern","lint_level":"force-warn","unused_extern_names":[]}"#;
+const SHARED_EMPTY_UNUSED_EXTERNS: &str = ".frust-empty-unused-externs-v1";
+
+/// Creates a message cache file, replacing rather than writing through an existing entry.
+fn create_message_cache(path: &Path) -> CargoResult<File> {
+    let create = || File::options().write(true).create_new(true).open(path);
+    let file = match create() {
+        Err(e) if e.kind() == io::ErrorKind::AlreadyExists => {
+            paths::remove_file(path)?;
+            create()
+        }
+        file => file,
+    };
+    file.with_context(|| format!("failed to create file `{}`", path.display()))
+}
+
+/// Hard-links `path` to the shared empty report, creating it if missing. Returns
+/// `false`, leaving `path` absent or replaceable, unless the link holds exactly the report.
+fn link_shared_empty(shared: &Path, path: &Path) -> bool {
+    let linked = match fs::hard_link(shared, path) {
+        Err(e) if e.kind() == io::ErrorKind::NotFound => {
+            publish_shared_empty(shared).and_then(|()| fs::hard_link(shared, path))
+        }
+        linked => linked,
+    };
+    match linked {
+        Ok(()) if holds_empty_report(path) => true,
+        Ok(()) => {
+            drop(fs::remove_file(path));
+            false
+        }
+        Err(e) => {
+            debug!("message cache `{}` not shared: {e}", path.display());
+            false
+        }
+    }
+}
+
+/// Publishes a complete, read-only shared report without replacing an existing one.
+fn publish_shared_empty(shared: &Path) -> io::Result<()> {
+    let dir = shared.parent().unwrap_or(Path::new("."));
+    let mut builder = tempfile::Builder::new();
+    builder.prefix(".frust-empty-unused-externs-");
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        builder.permissions(fs::Permissions::from_mode(0o444));
+    }
+    let mut tmp = builder.tempfile_in(dir)?;
+    tmp.write_all(format!("{EMPTY_UNUSED_EXTERNS}\n").as_bytes())?;
+    match tmp.persist_noclobber(shared) {
+        Err(e) if e.error.kind() != io::ErrorKind::AlreadyExists => Err(e.error),
+        _ => Ok(()),
+    }
+}
+
+/// Whether `path` is a regular file whose bytes are exactly the empty report line.
+fn holds_empty_report(path: &Path) -> bool {
+    let expected = EMPTY_UNUSED_EXTERNS.len() as u64 + 1;
+    if !fs::symlink_metadata(path).is_ok_and(|m| m.is_file() && m.len() == expected) {
+        return false;
+    }
+    let mut bytes = Vec::with_capacity(expected as usize + 1);
+    File::open(path)
+        .and_then(|file| file.take(expected + 1).read_to_end(&mut bytes))
+        .is_ok_and(|_| bytes.strip_suffix(b"\n") == Some(EMPTY_UNUSED_EXTERNS.as_bytes()))
+}
