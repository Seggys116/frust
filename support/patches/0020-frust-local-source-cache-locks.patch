+    /// Whether fetching `ids` may touch the package cache: an unloaded package
+    /// from a non-local source, an unknown id, or pending last-use data.
+    fn needs_cache_write_lock(&self, ids: &[PackageId]) -> CargoResult<bool> {
+        if !self.gctx.deferred_global_last_use()?.is_empty() {
+            return Ok(true);
+        }
+        let sources = self.sources.borrow();
+        Ok(ids.iter().any(|id| match self.packages.get(id) {
+            Some(slot) if slot.get().is_some() => false,
+            Some(_) => sources
+                .get(id.source_id())
+                .is_none_or(|source| !source.downloads_locally()),
+            None => true,
+        }))
+    }
