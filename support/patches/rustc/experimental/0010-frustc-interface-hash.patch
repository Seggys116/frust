+/// Appends the interface hash of this crate and of every dependency to the dep-info file.
+///
+/// Dep-info is written before metadata exists, so these lines are added once it has been
+/// encoded. A missing line only means that Cargo cannot skip a later rebuild.
+fn append_interface_dep_info(tcx: TyCtxt<'_>) {
+    if !rustc_session::frust::interface_hash_enabled()
+        || !tcx.sess.opts.output_types.contains_key(&OutputType::DepInfo)
+    {
+        return;
+    }
+    let Some(own) = tcx.untracked().local_interface_hash.get().copied() else { return };
+    let OutFileName::Real(path) = tcx.output_filenames(()).path(OutputType::DepInfo) else {
+        return;
+    };
+
+    // The text matches the 16 bytes that the metadata header stores for each crate.
+    let hex = |hash: rustc_data_structures::svh::Svh| -> String {
+        hash.as_fingerprint().to_le_bytes().iter().map(|byte| format!("{byte:02x}")).collect()
+    };
+    let mut lines = format!("# frust-iface:v1:{}\n", hex(own));
+    let cstore = CStore::from_tcx(tcx);
+    for &cnum in tcx.crates(()) {
+        lines.push_str(&format!("# frust-iface-dep:{}\n", hex(cstore.crate_header_hash(cnum))));
+    }
+    drop(cstore);
+
+    let appended = fs::OpenOptions::new().append(true).open(&path).and_then(|mut file| {
+        file.write_all(lines.as_bytes())
+    });
+    if let Err(err) = appended {
+        debug!("could not append interface hashes to {}: {err}", path.display());
+    }
+}
