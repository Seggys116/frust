+//! Switches that only the fRust compiler (`frustc`) honours.
+
+use std::sync::OnceLock;
+
+fn invoked_as_frustc() -> bool {
+    static CACHED: OnceLock<bool> = OnceLock::new();
+    *CACHED.get_or_init(|| {
+        std::env::current_exe()
+            .ok()
+            .and_then(|path| path.file_name().map(|name| name == "frustc"))
+            .unwrap_or(false)
+    })
+}
+
+/// Whether crate metadata publishes an interface hash instead of a body-sensitive one.
+///
+/// Only the exact value `1` enables it, and only for an executable named `frustc`, so a stock
+/// `rustc` never changes behaviour. Cargo sets the variable for every unit of one build.
+pub fn interface_hash_enabled() -> bool {
+    static CACHED: OnceLock<bool> = OnceLock::new();
+    *CACHED.get_or_init(|| {
+        invoked_as_frustc()
+            && std::env::var_os("FRUST_INTERFACE_HASH").as_deref() == Some(std::ffi::OsStr::new("1"))
+    })
+}
