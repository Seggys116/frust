@@ -1863,3 +1863,162 @@ extern "C" void LLVMRustComputeLTOCacheKey(RustStringRef KeyOut,
   OS << Key.str();
 }
 
+// Hash the merged fat-LTO module after panic-location lines are normalized.
+// Included here so this stays outside the earlier object-reuse patch.
+#include "llvm/IR/DerivedTypes.h"
+#include "llvm/IR/GlobalVariable.h"
+#include <array>
+#include <cstdio>
+#include <cstring>
+#include <limits>
+
+static uint64_t frust_read_le_or_be(StringRef Bytes, unsigned Off, unsigned Width,
+                                    bool LittleEndian) {
+  uint64_t Value = 0;
+  for (unsigned I = 0; I < Width; ++I) {
+    unsigned Shift = LittleEndian ? I * 8 : (Width - 1 - I) * 8;
+    Value |= uint64_t(uint8_t(Bytes[Off + I])) << Shift;
+  }
+  return Value;
+}
+
+static const GlobalVariable *frust_global_from_constant(const Constant *C, unsigned Depth) {
+  if (!C || Depth > 4)
+    return nullptr;
+  if (const auto *GV = dyn_cast<GlobalVariable>(C))
+    return GV;
+  if (const auto *GA = dyn_cast<GlobalAlias>(C))
+    return frust_global_from_constant(GA->getAliasee(), Depth + 1);
+  if (const auto *CE = dyn_cast<ConstantExpr>(C)) {
+    if (CE->getNumOperands() == 0)
+      return nullptr;
+    return frust_global_from_constant(cast<Constant>(CE->getOperand(0)), Depth + 1);
+  }
+  return nullptr;
+}
+
+// core::panic::Location on a 64-bit target is a packed { ptr, [16 x i8] }:
+// the pointer addresses a NUL-terminated path, and the 16 bytes are
+// file length, line, and column. Anything else stays in the hash unchanged.
+static bool frust_is_panic_location(const GlobalVariable &GV, bool LittleEndian,
+                                    uint8_t Out[16]) {
+  if (!GV.isConstant() || !GV.hasPrivateLinkage() || !GV.hasInitializer())
+    return false;
+  if (GV.getUnnamedAddr() != GlobalValue::UnnamedAddr::Global)
+    return false;
+  const auto *Init = dyn_cast<ConstantStruct>(GV.getInitializer());
+  if (!Init || Init->getNumOperands() != 2)
+    return false;
+  StructType *ST = Init->getType();
+  if (!ST->isPacked() || ST->getNumElements() != 2 || !ST->getElementType(0)->isPointerTy())
+    return false;
+  const auto *ArrayTy = dyn_cast<ArrayType>(ST->getElementType(1));
+  if (!ArrayTy || ArrayTy->getNumElements() != 16 || !ArrayTy->getElementType()->isIntegerTy(8))
+    return false;
+  const auto *Payload = dyn_cast<ConstantDataArray>(Init->getOperand(1));
+  if (!Payload)
+    return false;
+  StringRef Raw = Payload->getRawDataValues();
+  if (Raw.size() != 16)
+    return false;
+  uint64_t FileLen = frust_read_le_or_be(Raw, 0, 8, LittleEndian);
+  uint64_t Line = frust_read_le_or_be(Raw, 8, 4, LittleEndian);
+  uint64_t Column = frust_read_le_or_be(Raw, 12, 4, LittleEndian);
+  if (FileLen == 0 || FileLen > 4096 || Line == 0 || Line > 10000000 || Column == 0 ||
+      Column > 1000000)
+    return false;
+  const auto *File = frust_global_from_constant(dyn_cast<Constant>(Init->getOperand(0)), 0);
+  if (!File || !File->hasInitializer())
+    return false;
+  const auto *FileBytes = dyn_cast<ConstantDataArray>(File->getInitializer());
+  if (!FileBytes || !FileBytes->getElementType()->isIntegerTy(8))
+    return false;
+  StringRef Path = FileBytes->getRawDataValues();
+  if (Path.size() != FileLen + 1 || Path.back() != 0 || !Path.drop_back().contains(".rs"))
+    return false;
+  memcpy(Out, Raw.data(), 16);
+  return true;
+}
+
+struct FrustSpanRestore {
+  struct Item {
+    GlobalVariable *GV;
+    std::string Name;
+    Constant *Init;
+  };
+  SmallVector<Item, 32> Items;
+  ~FrustSpanRestore() {
+    for (auto It = Items.rbegin(); It != Items.rend(); ++It) {
+      It->GV->setInitializer(It->Init);
+      It->GV->setName(It->Name);
+    }
+  }
+};
+
+extern "C" uint64_t LLVMRustFatSpanHash(LLVMModuleRef M, uint8_t *HasDebugCompileUnit,
+                                        uint8_t *Payloads, uint32_t Capacity, uint32_t *Count) {
+  *HasDebugCompileUnit = 0;
+  *Count = 0;
+  if (!Payloads)
+    Capacity = 0;
+  Module *Mod = unwrap(M);
+  if (Mod->getNamedMetadata("llvm.dbg.cu")) {
+    *HasDebugCompileUnit = 1;
+    return 0;
+  }
+
+  bool LittleEndian = Mod->getDataLayout().isLittleEndian();
+  SmallVector<GlobalVariable *, 64> Locs;
+  SmallVector<std::array<uint8_t, 16>, 64> PayloadStore;
+  for (GlobalVariable &GV : Mod->globals()) {
+    uint8_t Tmp[16];
+    if (!frust_is_panic_location(GV, LittleEndian, Tmp))
+      continue;
+    std::array<uint8_t, 16> Bytes{};
+    memcpy(Bytes.data(), Tmp, 16);
+    PayloadStore.push_back(Bytes);
+    Locs.push_back(&GV);
+  }
+  if (PayloadStore.size() > std::numeric_limits<uint32_t>::max()) {
+    *Count = std::numeric_limits<uint32_t>::max();
+    *HasDebugCompileUnit = 1;
+    return 0;
+  }
+  *Count = static_cast<uint32_t>(PayloadStore.size());
+  if (PayloadStore.size() > Capacity)
+    return 0;
+
+  for (size_t I = 0; I < PayloadStore.size(); ++I)
+    memcpy(Payloads + I * 16, PayloadStore[I].data(), 16);
+
+  FrustSpanRestore Restore;
+  LLVMContext &Ctx = Mod->getContext();
+  for (size_t I = 0; I < Locs.size(); ++I) {
+    GlobalVariable *GV = Locs[I];
+    auto *Init = cast<ConstantStruct>(GV->getInitializer());
+    uint8_t Zeroed[16];
+    memcpy(Zeroed, PayloadStore[I].data(), 16);
+    Zeroed[8] = 0;
+    Zeroed[9] = 0;
+    Zeroed[10] = 0;
+    Zeroed[11] = 0;
+    Constant *NewPayload = ConstantDataArray::get(Ctx, ArrayRef<uint8_t>(Zeroed, 16));
+    Constant *Fields[2] = {cast<Constant>(Init->getOperand(0)), NewPayload};
+    Constant *NewInit = ConstantStruct::get(Init->getType(), ArrayRef<Constant *>(Fields, 2));
+    char Name[32];
+    snprintf(Name, sizeof(Name), "frust.span.%08u", static_cast<unsigned>(I));
+    Restore.Items.push_back(FrustSpanRestore::Item{GV, GV->getName().str(), GV->getInitializer()});
+    GV->setInitializer(NewInit);
+    GV->setName(Name);
+    if (GV->getName() != Name) {
+      // Non-zero tells the caller to ignore the hash. The destructor restores
+      // the module before this return completes.
+      *HasDebugCompileUnit = 1;
+      *Count = 0;
+      return 0;
+    }
+  }
+  // The hash runs while the normalized names and zeroed lines are in place.
+  // FrustSpanRestore then puts the caller's module back before we return.
+  return frust_sorted_codegen_hash(*Mod);
+}
diff --git a/compiler/rustc_codegen_llvm/src/back/fat_span.rs b/compiler/rustc_codegen_llvm/src/back/fat_span.rs
