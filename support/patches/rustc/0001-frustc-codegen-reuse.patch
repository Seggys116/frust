+// Hash used to reuse a whole object file after optimization. Symbol order is
+// not part of the key: a hit copies one complete object, so a different legal
+// layout of the same symbols stays consistent. Debug-info nodes are omitted;
+// callers skip the cache when llvm.dbg.cu is present. Global initializers are
+// included because StructuralHash does not hash them.
+static stable_hash frust_hash_constant(const Constant *C,
+                                       DenseSet<const GlobalValue *> &Stack) {
+  SmallVector<stable_hash, 8> H;
+  H.push_back(C->getValueID());
+  H.push_back(static_cast<stable_hash>(C->getType()->getTypeID()));
+
+  if (const auto *GV = dyn_cast<GlobalValue>(C)) {
+    H.push_back(xxh3_64bits(GV->getName()));
+    if (const auto *GVar = dyn_cast<GlobalVariable>(GV)) {
+      if (GVar->hasInitializer() && Stack.insert(GV).second) {
+        H.push_back(frust_hash_constant(GVar->getInitializer(), Stack));
+        Stack.erase(GV);
+      }
+    } else if (const auto *A = dyn_cast<GlobalAlias>(GV)) {
+      if (const auto *Aliasee = A->getAliasee()) {
+        if (Stack.insert(GV).second) {
+          H.push_back(frust_hash_constant(Aliasee, Stack));
+          Stack.erase(GV);
+        }
+      }
+    }
+    return stable_hash_combine(ArrayRef<stable_hash>(H));
+  }
+
+  if (const auto *CI = dyn_cast<ConstantInt>(C)) {
+    const APInt &V = CI->getValue();
+    H.push_back(V.getBitWidth());
+    for (unsigned I = 0; I < V.getNumWords(); ++I)
+      H.push_back(V.getRawData()[I]);
+    return stable_hash_combine(ArrayRef<stable_hash>(H));
+  }
+
+  if (const auto *CF = dyn_cast<ConstantFP>(C)) {
+    APInt Bits = CF->getValueAPF().bitcastToAPInt();
+    H.push_back(Bits.getBitWidth());
+    for (unsigned I = 0; I < Bits.getNumWords(); ++I)
+      H.push_back(Bits.getRawData()[I]);
+    return stable_hash_combine(ArrayRef<stable_hash>(H));
+  }
+
+  if (const auto *CDS = dyn_cast<ConstantDataSequential>(C)) {
+    H.push_back(xxh3_64bits(CDS->getRawDataValues()));
+    return stable_hash_combine(ArrayRef<stable_hash>(H));
+  }
+
+  if (isa<ConstantAggregateZero>(C) || isa<UndefValue>(C) || isa<PoisonValue>(C))
+    return stable_hash_combine(ArrayRef<stable_hash>(H));
+
+  if (const auto *BA = dyn_cast<BlockAddress>(C)) {
+    H.push_back(xxh3_64bits(BA->getFunction()->getName()));
+    if (const BasicBlock *BB = BA->getBasicBlock())
+      H.push_back(xxh3_64bits(BB->getName()));
+    return stable_hash_combine(ArrayRef<stable_hash>(H));
+  }
+
+  for (const Use &Op : C->operands()) {
+    if (const auto *OpC = dyn_cast<Constant>(Op))
+      H.push_back(frust_hash_constant(OpC, Stack));
+  }
+  return stable_hash_combine(ArrayRef<stable_hash>(H));
+}
+
+static stable_hash frust_hash_md(const Metadata *MD, unsigned Depth) {
+  if (!MD || Depth > 6)
+    return 0;
+  if (isa<DINode>(MD))
+    return 0;
+  if (const auto *S = dyn_cast<MDString>(MD))
+    return xxh3_64bits(S->getString());
+  if (const auto *C = dyn_cast<ConstantAsMetadata>(MD)) {
+    DenseSet<const GlobalValue *> Stack;
+    return stable_hash_combine(static_cast<stable_hash>(3),
+                               frust_hash_constant(C->getValue(), Stack));
+  }
+  if (const auto *V = dyn_cast<ValueAsMetadata>(MD)) {
+    if (const auto *C = dyn_cast<Constant>(V->getValue())) {
+      DenseSet<const GlobalValue *> Stack;
+      return stable_hash_combine(static_cast<stable_hash>(4),
+                                 frust_hash_constant(C, Stack));
+    }
+    return 5;
+  }
+  if (const auto *N = dyn_cast<MDNode>(MD)) {
+    stable_hash H = N->getNumOperands() + 17;
+    for (unsigned I = 0; I < N->getNumOperands(); ++I)
+      H = stable_hash_combine(H, frust_hash_md(N->getOperand(I).get(), Depth + 1));
+    return H;
+  }
+  return 2;
+}
+
+static stable_hash frust_function_meta(const Function &F) {
+  stable_hash H = 0;
+  for (const BasicBlock &BB : F) {
+    for (const Instruction &I : BB) {
+      SmallVector<std::pair<unsigned, MDNode *>, 8> MDS;
+      I.getAllMetadata(MDS);
+      for (const auto &MD : MDS) {
+        if (!MD.second || isa<DINode>(MD.second))
+          continue;
+        H = stable_hash_combine(H, static_cast<stable_hash>(MD.first),
+                                frust_hash_md(MD.second, 0));
+      }
+    }
+  }
+  return H;
+}
+
+static stable_hash frust_function_extra(const Function &F) {
+  SmallVector<stable_hash, 8> Parts;
+  Parts.push_back(StructuralHash(F, /*DetailedHash=*/true));
+  Parts.push_back(frust_function_meta(F));
+  Parts.push_back(static_cast<stable_hash>(F.getLinkage()));
+  Parts.push_back(static_cast<stable_hash>(F.getVisibility()));
+  Parts.push_back(static_cast<stable_hash>(F.getCallingConv()));
+  Parts.push_back(F.isDSOLocal());
+  Parts.push_back(xxh3_64bits(F.hasSection() ? F.getSection() : ""));
+  AttributeList Attrs = F.getAttributes();
+  for (unsigned I = 0; I < Attrs.getNumAttrSets(); ++I)
+    Parts.push_back(xxh3_64bits(StringRef(Attrs.getAsString(I))));
+  if (const Constant *Pers = F.hasPersonalityFn() ? F.getPersonalityFn() : nullptr) {
+    DenseSet<const GlobalValue *> Stack;
+    Parts.push_back(frust_hash_constant(Pers, Stack));
+  }
+  return stable_hash_combine(ArrayRef<stable_hash>(Parts));
+}
+
+static stable_hash frust_global_extra(const GlobalVariable &GV) {
+  SmallVector<stable_hash, 12> Parts;
+  Parts.push_back(static_cast<stable_hash>(GV.getLinkage()));
+  Parts.push_back(static_cast<stable_hash>(GV.getVisibility()));
+  Parts.push_back(static_cast<stable_hash>(GV.getUnnamedAddr()));
+  Parts.push_back(GV.isConstant());
+  Parts.push_back(static_cast<stable_hash>(GV.getThreadLocalMode()));
+  Parts.push_back(GV.getAlign().valueOrOne().value());
+  Parts.push_back(GV.isDSOLocal());
+  Parts.push_back(xxh3_64bits(GV.hasSection() ? GV.getSection() : ""));
+  Parts.push_back(xxh3_64bits(GV.hasComdat() ? GV.getComdat()->getName() : ""));
+  Parts.push_back(static_cast<stable_hash>(GV.getValueType()->getTypeID()));
+  DenseSet<const GlobalValue *> Stack;
+  if (GV.hasInitializer())
+    Parts.push_back(frust_hash_constant(GV.getInitializer(), Stack));
+  return stable_hash_combine(ArrayRef<stable_hash>(Parts));
+}
+
+static stable_hash frust_sorted_codegen_hash(const Module &M) {
+  stable_hash H = xxh3_64bits(M.getDataLayoutStr());
+  H = stable_hash_combine(H, xxh3_64bits(M.getTargetTriple().str()));
+  SmallVector<Module::ModuleFlagEntry, 8> Flags;
+  M.getModuleFlagsMetadata(Flags);
+  llvm::sort(Flags, [](const Module::ModuleFlagEntry &L, const Module::ModuleFlagEntry &R) {
+    return L.Key->getString() < R.Key->getString();
+  });
+  for (const Module::ModuleFlagEntry &Flag : Flags) {
+    H = stable_hash_combine(H, xxh3_64bits(Flag.Key->getString()),
+                            static_cast<stable_hash>(Flag.Behavior),
+                            frust_hash_md(Flag.Val, 0));
+  }
+  for (const Module::GlobalAsmFragment &Frag : M.getModuleInlineAsm()) {
+    H = stable_hash_combine(H, xxh3_64bits(Frag.Asm));
+    H = stable_hash_combine(H, xxh3_64bits(Frag.Props.TargetCPU));
+    H = stable_hash_combine(H, xxh3_64bits(Frag.Props.TargetFeatures));
+  }
+
+  SmallVector<std::pair<std::string, stable_hash>, 64> Items;
+  for (const GlobalVariable &GV : M.globals())
+    Items.emplace_back(GV.getName().str(), frust_global_extra(GV));
+  for (const GlobalAlias &A : M.aliases()) {
+    DenseSet<const GlobalValue *> Stack;
+    Items.emplace_back(A.getName().str(), frust_hash_constant(&A, Stack));
+  }
+  for (const GlobalIFunc &I : M.ifuncs()) {
+    DenseSet<const GlobalValue *> Stack;
+    stable_hash IH = xxh3_64bits(I.getName());
+    if (const Constant *R = I.getResolver())
+      IH = stable_hash_combine(IH, frust_hash_constant(R, Stack));
+    Items.emplace_back(I.getName().str(), IH);
+  }
+  llvm::sort(Items, [](const auto &L, const auto &R) {
+    return L.first < R.first || (L.first == R.first && L.second < R.second);
+  });
+  for (const auto &Item : Items)
+    H = stable_hash_combine(H, xxh3_64bits(StringRef(Item.first)), Item.second);
+
+  Items.clear();
+  for (const Function &F : M)
+    Items.emplace_back(F.getName().str(), frust_function_extra(F));
+  llvm::sort(Items, [](const auto &L, const auto &R) {
+    return L.first < R.first || (L.first == R.first && L.second < R.second);
+  });
+  for (const auto &Item : Items)
+    H = stable_hash_combine(H, xxh3_64bits(StringRef(Item.first)), Item.second);
+  return H;
+}
