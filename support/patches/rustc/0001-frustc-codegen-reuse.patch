+fn invoked_as_frustc() -> bool {
+    static CACHED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *CACHED.get_or_init(|| {
+        std::env::current_exe()
+            .ok()
+            .and_then(|path| path.file_name().map(|name| name == "frustc"))
+            .unwrap_or(false)
+    })
+}
+
+fn opt_level_tag(level: config::OptLevel) -> &'static str {
+    match level {
+        config::OptLevel::No => "0",
+        config::OptLevel::Less => "1",
+        config::OptLevel::More => "2",
+        config::OptLevel::Aggressive => "3",
+        config::OptLevel::Size => "s",
+        config::OptLevel::SizeMin => "z",
+    }
+}
+
+/// Stable object cache for frustc. The directory is the object file's parent,
+/// which is the Cargo `--out-dir` and survives incremental sessions. The
+/// per-invocation suffix on the temporary object name is not part of the key.
+fn frust_codegen_cache_path(
+    cgcx: &CodegenContext,
+    config: &ModuleConfig,
+    module: &llvm::Module,
+    obj_out: &Path,
+) -> Option<PathBuf> {
+    if !invoked_as_frustc() {
+        return None;
+    }
+    let mut has_debug = 0u8;
+    let hash = unsafe { llvm::LLVMRustModuleCodegenHash(module, &mut has_debug) };
+    if has_debug != 0 {
+        return None;
+    }
+    let parent = obj_out.parent()?;
+    let builtins = if config.no_builtins { "1" } else { "0" };
+    let opt = opt_level_tag(cgcx.opt_level);
+    let name = format!("v1-{opt}-{builtins}-{hash:016x}.o");
+    Some(parent.join("frust-codegen-cache").join(name))
+}
+
+fn copy_cached_object(cache: &Path, output: &Path) -> bool {
+    let Ok(meta) = fs::metadata(cache) else {
+        return false;
+    };
+    if !meta.is_file() || meta.len() == 0 {
+        return false;
+    }
+    fs::copy(cache, output).is_ok()
+}
+
+fn store_cached_object(cache: &Path, output: &Path) {
+    let Some(parent) = cache.parent() else {
+        return;
+    };
+    if fs::create_dir_all(parent).is_err() {
+        return;
+    }
+    let tmp = cache.with_extension("tmp");
+    if fs::copy(output, &tmp).is_err() {
+        return;
+    }
+    if fs::rename(&tmp, cache).is_err() {
+        let _ = fs::remove_file(&tmp);
+    }
+}
