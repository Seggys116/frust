+extern "C" uint64_t LLVMRustModuleCodegenHash(LLVMModuleRef M,
+                                              uint8_t *HasDebugCompileUnit) {
+  Module *Mod = unwrap(M);
+  bool HasDebug = Mod->getNamedMetadata("llvm.dbg.cu") != nullptr;
+  *HasDebugCompileUnit = HasDebug;
+  if (HasDebug)
+    return 0;
+  return frust_sorted_codegen_hash(*Mod);
+}
