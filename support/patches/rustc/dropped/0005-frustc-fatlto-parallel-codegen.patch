+/// Target-machine options are not all present in the pre-optimization IR.
+/// The fingerprint is part of the cache name so a CPU or relocation change misses.
+fn fat_pipeline_fingerprint(sess: &Session, cgcx: &CodegenContext, bitcode: BitcodeSection) -> u64 {
+    let config = &cgcx.module_config;
+    let function_sections =
+        sess.opts.unstable_opts.function_sections.unwrap_or(sess.target.function_sections);
+    let trap_unreachable =
+        sess.opts.unstable_opts.trap_unreachable.unwrap_or(sess.target.trap_unreachable);
+    let relax_elf =
+        sess.opts.unstable_opts.relax_elf_relocations.unwrap_or(sess.target.relax_elf_relocations);
+    let use_ctors =
+        sess.opts.unstable_opts.use_ctors_section.unwrap_or(sess.target.use_ctors_section);
+    let large = sess.opts.unstable_opts.large_data_threshold.unwrap_or(0);
+    let bitcode_tag = match bitcode {
+        BitcodeSection::None => "none",
+        BitcodeSection::Full => "full",
+    };
+    let text = format!(
+        "bitcode={bitcode_tag}\nbuiltins={}\nvec_loop={}\nvec_slp={}\nmerge={}\nlifetime={}\ncpu={}\ntune={}\nfeatures={}\ntriple={}\nreloc={}\ncode={}\ntls={}\npanic={}\nframe={}\nfunc_sections={}\ntrap={}\nrelax={}\nctors={}\nfloat={}\nsingle={}\nunique={}\nlarge={large}\nmsvc={}\narch={}\nprefer_dynamic={}\nthreads={FRUST_FAT_CODEGEN_THREADS}\n",
+        bit_flag(config.no_builtins),
+        bit_flag(config.vectorize_loop),
+        bit_flag(config.vectorize_slp),
+        bit_flag(config.merge_functions),
+        bit_flag(config.emit_lifetime_markers),
+        llvm_util::target_cpu(sess),
+        llvm_util::tune_cpu(sess).unwrap_or(""),
+        sess.global_backend_features.join(","),
+        versioned_llvm_target(sess),
+        reloc_tag(sess.relocation_model()),
+        code_model_tag(sess.code_model()),
+        tls_tag(sess.tls_model()),
+        panic_tag(sess.panic_strategy()),
+        frame_pointer_tag(sess.opts.cg.force_frame_pointers),
+        bit_flag(function_sections),
+        bit_flag(trap_unreachable),
+        bit_flag(relax_elf),
+        bit_flag(use_ctors),
+        float_abi_tag(sess.target.llvm_floatabi),
+        bit_flag(sess.target.singlethread(&sess.internal_target_features)),
+        bit_flag(!sess.opts.unstable_opts.no_unique_section_names),
+        bit_flag(cgcx.msvc_imps_needed),
+        cgcx.target_arch,
+        bit_flag(cgcx.prefer_dynamic),
+    );
+    fnv1a64(text.as_bytes())
+}
