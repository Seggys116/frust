+/// Object reused when the merged pre-optimization module and the fat-LTO
+/// pipeline match a previous `frustc` compile. A miss still runs the pass
+/// manager. `rustc` does not consult this cache.
+pub(crate) fn preopt_fat_cache_path(
+    sess: &Session,
+    cgcx: &CodegenContext,
+    module: &ModuleCodegen<ModuleLlvm>,
+) -> Option<PathBuf> {
+    if !invoked_as_frustc() || cgcx.lto != Lto::Fat {
+        return None;
+    }
+    let config = &cgcx.module_config;
+    let EmitObj::ObjectCode(bitcode) = config.emit_obj else {
+        return None;
+    };
+    if cgcx.save_temps
+        || config.emit_asm
+        || config.emit_ir
+        || config.emit_bc
+        || config.emit_thin_lto_summary
+        || split_dwarf_object(cgcx)
+        || fat_reuse_refused(sess, config)
+    {
+        return None;
+    }
+    let mut has_debug = 0u8;
+    let hash = unsafe { llvm::LLVMRustModuleCodegenHash(module.module_llvm.llmod(), &mut has_debug) };
+    if has_debug != 0 {
+        return None;
+    }
+    let obj_out = cgcx.output_filenames.temp_path_for_cgu(OutputType::Object, &module.name);
+    let parent = obj_out.parent()?;
+    let opt = opt_level_tag(cgcx.opt_level);
+    let pipeline = fat_pipeline_fingerprint(sess, cgcx, bitcode);
+    let name = format!("fatpar-v1-{opt}-{pipeline:016x}-{hash:016x}.o");
+    Some(parent.join("frust-codegen-cache").join(name))
+}
+
+pub(crate) fn load_preopt_fat_object(
+    cgcx: &CodegenContext,
+    module: &ModuleCodegen<ModuleLlvm>,
+    cache: &Path,
+) -> Option<CompiledModule> {
+    let obj_out = cgcx.output_filenames.temp_path_for_cgu(OutputType::Object, &module.name);
+    if let Some(parent) = obj_out.parent() {
+        fs::create_dir_all(parent).ok()?;
+    }
+    if !copy_cached_object(cache, &obj_out) {
+        return None;
+    }
+    Some(CompiledModule {
+        name: module.name.clone(),
+        kind: module.kind,
+        object: Some(obj_out),
+        global_asm_object: None,
+        dwarf_object: None,
+        bytecode: None,
+        assembly: None,
+        llvm_ir: None,
+    })
+}
+
+pub(crate) fn store_preopt_fat_object(cache: &Path, compiled: &CompiledModule) {
+    let Some(object) = compiled.object.as_deref() else {
+        return;
+    };
+    store_cached_object(cache, object);
+}
