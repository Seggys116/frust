+/// Parallel machine codegen for one fat-LTO object. The optimization pipeline
+/// has already finished. `false` means the caller must emit the object itself.
+fn write_parallel_fat_object<'ll>(
+    cgcx: &CodegenContext,
+    target: &'ll llvm::TargetMachine,
+    no_builtins: bool,
+    m: &'ll llvm::Module,
+    output: &Path,
+    verify_llvm_ir: bool,
+) -> bool {
+    if !invoked_as_frustc() || cgcx.lto != Lto::Fat || FRUST_FAT_CODEGEN_THREADS < 2 {
+        return false;
+    }
+    let output_c = path_to_c_string(output);
+    let result = unsafe {
+        llvm::LLVMRustWriteParallelObject(
+            target,
+            m,
+            output_c.as_ptr(),
+            FRUST_FAT_CODEGEN_THREADS,
+            no_builtins,
+            verify_llvm_ir,
+        )
+    };
+    result == llvm::LLVMRustResult::Success
+}
