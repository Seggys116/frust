+// Codegen one split partition into Path. Returns true on failure.
+// The bitcode is independent of the caller's LLVMContext, so this can run
+// on a worker thread.
+static bool frust_codegen_partition(const TargetMachine *OrigTM,
+                                    StringRef BC, StringRef Path,
+                                    bool NoBuiltins, bool VerifyIR) {
+  LLVMContext Ctx;
+  Expected<std::unique_ptr<Module>> Parsed = parseBitcodeFile(
+      MemoryBufferRef(BC, "frust-fat-part.bc"), Ctx);
+  if (!Parsed)
+    return true;
+  std::unique_ptr<Module> Part = std::move(*Parsed);
+  std::unique_ptr<TargetMachine> TM(OrigTM->getTarget().createTargetMachine(
+      OrigTM->getTargetTriple(), OrigTM->getTargetCPU(),
+      OrigTM->getTargetFeatureString(), OrigTM->Options,
+      OrigTM->getRelocationModel(), OrigTM->getCodeModel(),
+      OrigTM->getOptLevel()));
+  if (!TM)
+    return true;
+
+  std::error_code EC;
+  raw_fd_ostream OS(Path, EC, sys::fs::OF_None);
+  if (EC)
+    return true;
+
+  LLVMPassManagerRef PMR = LLVMCreatePassManager();
+  LLVMRustAddLibraryInfo(wrap(TM.get()), PMR, wrap(Part.get()), NoBuiltins);
+  legacy::PassManager *PM = unwrap<legacy::PassManager>(PMR);
+  bool EmitFailed = TM->addPassesToEmitFile(
+      *PM, OS, nullptr, CodeGenFileType::ObjectFile, !VerifyIR);
+  if (!EmitFailed)
+    PM->run(*Part);
+  OS.flush();
+  LLVMDisposePassManager(PMR);
+  return EmitFailed;
+}
+
+// Split a finished fat-LTO module and codegen the partitions in parallel,
+// then `ld -r` them into one object. The IR pipeline has already run.
+// The original module is left intact. Returns Failure without writing Output
+// when the split cannot be completed, so the caller can emit serially.
+extern "C" LLVMRustResult
+LLVMRustWriteParallelObject(LLVMTargetMachineRef TMRef, LLVMModuleRef MRef,
+                            const char *Output, unsigned Threads,
+                            bool NoBuiltins, bool VerifyIR) {
+  if (!TMRef || !MRef || !Output || Threads < 2)
+    return LLVMRustResult::Failure;
+  TargetMachine *OrigTM = unwrap(TMRef);
+  Module *Mod = unwrap(MRef);
+  unsigned Defined = 0;
+  for (const Function &F : *Mod)
+    if (!F.isDeclaration())
+      ++Defined;
+  if (Defined < 2)
+    return LLVMRustResult::Failure;
+
+  std::vector<SmallString<0>> Parts;
+  Parts.reserve(Threads);
+  SplitModule(
+      *Mod, Threads,
+      [&](std::unique_ptr<Module> Part) {
+        SmallString<0> BC;
+        raw_svector_ostream BCOS(BC);
+        WriteBitcodeToFile(*Part, BCOS);
+        Parts.push_back(std::move(BC));
+      },
+      /*PreserveLocals=*/false, /*RoundRobin=*/false);
+  if (Parts.size() < 2)
+    return LLVMRustResult::Failure;
+
+  std::vector<std::string> ObjPaths;
+  ObjPaths.reserve(Parts.size());
+  for (unsigned I = 0; I < Parts.size(); ++I)
+    ObjPaths.push_back(std::string(Output) + ".part" + std::to_string(I) + ".o");
+
+  std::atomic<int> Failed(0);
+  {
+    DefaultThreadPool Pool(hardware_concurrency(static_cast<unsigned>(Parts.size())));
+    for (unsigned I = 0; I < Parts.size(); ++I) {
+      Pool.async([&, I]() {
+        if (frust_codegen_partition(OrigTM, Parts[I], ObjPaths[I], NoBuiltins,
+                                    VerifyIR))
+          Failed.store(1, std::memory_order_relaxed);
+      });
+    }
+    Pool.wait();
+  }
+  if (Failed.load(std::memory_order_relaxed)) {
+    for (const std::string &PartPath : ObjPaths)
+      sys::fs::remove(PartPath);
+    return LLVMRustResult::Failure;
+  }
+
+  auto LdOrErr = sys::findProgramByName("ld");
+  if (!LdOrErr) {
+    for (const std::string &PartPath : ObjPaths)
+      sys::fs::remove(PartPath);
+    return LLVMRustResult::Failure;
+  }
+  std::string Ld = std::move(*LdOrErr);
+  std::vector<StringRef> Args;
+  Args.push_back(Ld);
+  Args.push_back("-r");
+  Args.push_back("-o");
+  Args.push_back(Output);
+  for (const std::string &PartPath : ObjPaths)
+    Args.push_back(PartPath);
+  std::string ErrMsg;
+  int RC = sys::ExecuteAndWait(Ld, Args, std::nullopt, {}, 0, 0, &ErrMsg);
+  for (const std::string &PartPath : ObjPaths)
+    sys::fs::remove(PartPath);
+  if (RC != 0) {
+    sys::fs::remove(Output);
+    return LLVMRustResult::Failure;
+  }
+  return LLVMRustResult::Success;
+}
