+// Order-sensitive key for the fat-LTO object cache. A hit requires the merged
+// module's list order, not a sorted name list. Walking in place avoids the
+// name vector on the miss path. Callers still run the normal fat-LTO pipeline
+// when this key misses.
+static stable_hash frust_stream_codegen_hash(const Module &M) {
+  stable_hash H = xxh3_64bits(M.getDataLayoutStr());
+  H = stable_hash_combine(H, xxh3_64bits(M.getTargetTriple().str()));
+  SmallVector<Module::ModuleFlagEntry, 8> Flags;
+  M.getModuleFlagsMetadata(Flags);
+  for (const Module::ModuleFlagEntry &Flag : Flags) {
+    H = stable_hash_combine(H, xxh3_64bits(Flag.Key->getString()),
+                            static_cast<stable_hash>(Flag.Behavior),
+                            frust_hash_md(Flag.Val, 0));
+  }
+  for (const Module::GlobalAsmFragment &Frag : M.getModuleInlineAsm()) {
+    H = stable_hash_combine(H, xxh3_64bits(Frag.Asm));
+    H = stable_hash_combine(H, xxh3_64bits(Frag.Props.TargetCPU));
+    H = stable_hash_combine(H, xxh3_64bits(Frag.Props.TargetFeatures));
+  }
+  for (const GlobalVariable &GV : M.globals())
+    H = stable_hash_combine(H, xxh3_64bits(GV.getName()), frust_global_extra(GV));
+  for (const GlobalAlias &A : M.aliases()) {
+    DenseSet<const GlobalValue *> Stack;
+    H = stable_hash_combine(H, xxh3_64bits(A.getName()), frust_hash_constant(&A, Stack));
+  }
+  for (const GlobalIFunc &I : M.ifuncs()) {
+    DenseSet<const GlobalValue *> Stack;
+    stable_hash IH = 0;
+    if (const Constant *Resolver = I.getResolver())
+      IH = frust_hash_constant(Resolver, Stack);
+    H = stable_hash_combine(H, xxh3_64bits(I.getName()), IH);
+  }
+  for (const Function &F : M)
+    H = stable_hash_combine(H, xxh3_64bits(F.getName()), frust_function_extra(F));
+  for (const NamedMDNode &NMD : M.named_metadata()) {
+    H = stable_hash_combine(H, xxh3_64bits(NMD.getName()));
+    for (unsigned I = 0; I < NMD.getNumOperands(); ++I)
+      H = stable_hash_combine(H, frust_hash_md(NMD.getOperand(I), 0));
+  }
+  return H;
+}
+
+extern "C" uint64_t LLVMRustModuleStreamHash(LLVMModuleRef M,
+                                             uint8_t *HasDebugCompileUnit) {
+  Module *Mod = unwrap(M);
+  bool HasDebug = Mod->getNamedMetadata("llvm.dbg.cu") != nullptr;
+  *HasDebugCompileUnit = HasDebug;
+  if (HasDebug)
+    return 0;
+  return frust_stream_codegen_hash(*Mod);
+}
