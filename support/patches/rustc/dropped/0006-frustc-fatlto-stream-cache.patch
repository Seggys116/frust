+fn split_dwarf_object(cgcx: &CodegenContext) -> bool {
+    cgcx.target_can_use_split_dwarf
+        && cgcx.split_debuginfo != SplitDebuginfo::Off
+        && cgcx.split_dwarf_kind == SplitDwarfKind::Split
+}
+
+/// Profiles, sanitizers, plugins, and extra passes are not in the key.
+/// Missing the cache is safe.
+fn fatkey_refused(sess: &Session, config: &ModuleConfig) -> bool {
+    config.passes.iter().any(|pass| !pass.is_empty())
+        || config.pgo_gen.enabled()
+        || config.pgo_use.is_some()
+        || config.pgo_sample_use.is_some()
+        || config.sanitizer != SanitizerSet::empty()
+        || config.sanitizer_cfi_diag.is_some()
+        || config.sanitizer_cfi_recover.is_some()
+        || config.sanitizer_recover != SanitizerSet::empty()
+        || config.sanitizer_memory_track_origins != 0
+        || !config.sanitizer_dataflow_abilist.is_empty()
+        || config.instrument_coverage
+        || config.debug_info_for_profiling
+        || config.no_prepopulate_passes
+        || !config.llvm_plugins.is_empty()
+        || !config.offload.is_empty()
+        || config.autodiff.contains(&config::AutoDiff::Enable)
+        || !sess.opts.cg.llvm_args.is_empty()
+}
+
+fn bit_flag(value: bool) -> u8 {
+    u8::from(value)
+}
+
+fn fnv1a64(bytes: &[u8]) -> u64 {
+    let mut hash = 0xcbf29ce484222325u64;
+    for byte in bytes {
+        hash ^= u64::from(*byte);
+        hash = hash.wrapping_mul(0x0000_0100_0000_01b3);
+    }
+    hash
+}
+
+fn reloc_tag(model: RelocModel) -> &'static str {
+    match model {
+        RelocModel::Static => "static",
+        RelocModel::Pic => "pic",
+        RelocModel::Pie => "pie",
+        RelocModel::DynamicNoPic => "dynamic-no-pic",
+        RelocModel::Ropi => "ropi",
+        RelocModel::Rwpi => "rwpi",
+        RelocModel::RopiRwpi => "ropi-rwpi",
+    }
+}
+
+fn code_model_tag(model: Option<CodeModel>) -> &'static str {
+    match model {
+        None => "default",
+        Some(CodeModel::Tiny) => "tiny",
+        Some(CodeModel::Small) => "small",
+        Some(CodeModel::Kernel) => "kernel",
+        Some(CodeModel::Medium) => "medium",
+        Some(CodeModel::Large) => "large",
+    }
+}
+
+fn tls_tag(model: TlsModel) -> &'static str {
+    match model {
+        TlsModel::GeneralDynamic => "global-dynamic",
+        TlsModel::LocalDynamic => "local-dynamic",
+        TlsModel::InitialExec => "initial-exec",
+        TlsModel::LocalExec => "local-exec",
+        TlsModel::Emulated => "emulated",
+    }
+}
+
+fn float_abi_tag(abi: Option<FloatAbi>) -> &'static str {
+    match abi {
+        None => "default",
+        Some(FloatAbi::Soft) => "soft",
+        Some(FloatAbi::Hard) => "hard",
+    }
+}
+
+fn panic_tag(strategy: PanicStrategy) -> &'static str {
+    match strategy {
+        PanicStrategy::Unwind => "unwind",
+        PanicStrategy::Abort => "abort",
+        PanicStrategy::ImmediateAbort => "immediate-abort",
+    }
+}
+
+fn frame_pointer_tag(kind: FramePointer) -> &'static str {
+    match kind {
+        FramePointer::Always => "always",
+        FramePointer::NonLeaf => "non-leaf",
+        FramePointer::MayOmit => "may-omit",
+    }
+}
