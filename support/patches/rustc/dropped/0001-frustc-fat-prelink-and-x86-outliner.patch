+#if defined(__linux__)
+  // The frustc hardlink enables the x86 machine outliner. Invoking rustc does not.
+  if (TM != nullptr && OptLevel != CodeGenOptLevelEnum::None &&
+      (Trip.getArch() == Triple::x86 || Trip.getArch() == Triple::x86_64)) {
+    char exe_path[4096];
+    ssize_t len = ::readlink("/proc/self/exe", exe_path, sizeof(exe_path));
+    if (len > 0 && len < static_cast<ssize_t>(sizeof(exe_path))) {
+      StringRef base = llvm::sys::path::filename(StringRef(exe_path, static_cast<size_t>(len)));
+      if (base == "frustc") {
+        TM->setMachineOutliner(true);
+        TM->setSupportsDefaultOutlining(true);
+        // X86 leaves shouldOutlineFromFunctionByDefault false, so TargetDefault
+        // adds the pass and then skips every function. AlwaysOutline uses
+        // X86InstrInfo::isFunctionSafeToOutlineFrom.
+        llvm::cl::Option *OutlinerOpt =
+            llvm::cl::getRegisteredOptions().lookup("enable-machine-outliner");
+        if (OutlinerOpt == nullptr ||
+            OutlinerOpt->addOccurrence(0, "enable-machine-outliner", "always")) {
+          report_fatal_error("frustc could not enable the machine outliner");
+        }
+      }
+    }
+  }
+#endif
