+//! Remembers that `Cargo.lock` was already up to date for an exact set of inputs.
+//!
+//! A build begins by resolving the whole workspace with every feature on, only to write
+//! `Cargo.lock` when something changed, and then resolves again for the packages and features
+//! requested. When nothing changed since a build that found `Cargo.lock` current, the first
+//! resolution reads the registry index for every locked package to arrive at a graph that equals
+//! the lock file. Its result is the lock file itself.
+//!
+//! After the first resolution of a build leaves the lock file unchanged, fRust's Cargo stores a
+//! digest of everything that resolution depends on in the build directory. A later build
+//! whose digest matches loads `Cargo.lock` as the whole-workspace resolve and performs only the
+//! second, requested resolution, which still consults the registry for the packages it needs.
+//! Any difference in the digest runs both resolutions as before, so an edited manifest, a
+//! changed lock file, other configuration or a different Cargo build is never answered from the
+//! memo.
+//!
+//! The digest covers the Cargo build, the lock file text and its location, the manifest of the
+//! workspace root and of every member, the manifest (and the manifests above it, for inherited
+//! fields) of every other path package in the lock file, the merged configuration values, the
+//! `CARGO_*` environment and the unstable flags. The offline and locked flags are not part of it: a lock file that is current needs no network and no update either way. Registry and git
+//! packages are identified by version, checksum and revision in `Cargo.lock`, so the index is not
+//! part of it: locked packages are not re-resolved against newer index entries. A workspace with
+//! `[patch]`, `[replace]` or `paths` overrides never uses the memo.
+//!
+//! `FRUST_RESOLVE_MEMO=off` disables it. `FRUST_RESOLVE_MEMO=verify` still resolves the whole
+//! workspace and fails when that disagrees with a recorded memo, for tests.
+
+use std::collections::BTreeSet;
+use std::fs;
+use std::io::Write as _;
+use std::path::{Path, PathBuf};
+
+use crate::context::GlobalContext;
+use crate::resolver::Resolve;
+use crate::workspace::Workspace;
+
+const MEMO_FORMAT: &str = "frust-resolve-memo-1";
+const ENV: &str = "FRUST_RESOLVE_MEMO";
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub(crate) enum Mode {
+    Off,
+    On,
+    Verify,
+}
+
+pub(crate) fn mode(gctx: &GlobalContext) -> Mode {
+    if gctx.get_env_os("FRUST_INVOCATION").is_none_or(|value| value != "fcargo") {
+        return Mode::Off;
+    }
+    match gctx.get_env_os(ENV).and_then(|value| value.to_str()) {
+        Some("off" | "0") => Mode::Off,
+        Some("verify") => Mode::Verify,
+        _ => Mode::On,
+    }
+}
+
+/// A digest of the inputs of the whole-workspace resolution and where it is remembered.
+pub(crate) struct Memo {
+    path: PathBuf,
+    key: [u8; 32],
+}
+
+impl Memo {
+    /// The memo for this workspace, or `None` when the workspace is not eligible or an input
+    /// could not be read. `lock` is the text of `Cargo.lock` and `resolve` the whole-workspace
+    /// resolve it decodes to, or that was resolved from it.
+    pub(crate) fn for_workspace(
+        ws: &Workspace<'_>,
+        lock: &str,
+        resolve: &Resolve,
+    ) -> Option<Memo> {
+        let gctx = ws.gctx();
+        if ws.is_ephemeral() || !ws.require_optional_deps() {
+            return None;
+        }
+        if !ws.root_replace().is_empty() || !ws.root_patch().ok()?.is_empty() {
+            return None;
+        }
+        if gctx.paths_overrides().ok()?.is_some() {
+            return None;
+        }
+        let key = digest(ws, lock, resolve)?;
+        let target = ws.build_dir().into_path_unlocked();
+        let mut identity = blake3::Hasher::new();
+        identity.update(ws.root_manifest().as_os_str().as_encoded_bytes());
+        let id = identity.finalize().to_hex();
+        let path = target.join(format!(".frust-resolve-memo-{}", &id.as_str()[..16]));
+        Some(Memo { path, key })
+    }
+
+    /// Whether a build with exactly these inputs found `Cargo.lock` up to date.
+    pub(crate) fn is_recorded(&self) -> bool {
+        fs::read(&self.path).is_ok_and(|stored| stored == self.key)
+    }
+
+    /// Remembers the digest and says whether it did. A missing build directory, a read-only
+    /// directory or any other failure only means the next build resolves in full.
+    pub(crate) fn record(&self) -> bool {
+        let Some(dir) = self.path.parent().filter(|dir| dir.is_dir()) else {
+            return false;
+        };
+        let Some(name) = self.path.file_name().and_then(|name| name.to_str()) else {
+            return false;
+        };
+        let staged = dir.join(format!("{name}.{}", std::process::id()));
+        let written = fs::File::create(&staged).and_then(|mut file| file.write_all(&self.key));
+        if written.is_err() || fs::rename(&staged, &self.path).is_err() {
+            let _ = fs::remove_file(&staged);
+            return false;
+        }
+        true
+    }
+}
+
+struct Digest(blake3::Hasher);
+
+impl Digest {
+    fn put(&mut self, tag: &str, bytes: &[u8]) {
+        self.0.update(&(tag.len() as u64).to_le_bytes());
+        self.0.update(tag.as_bytes());
+        self.0.update(&(bytes.len() as u64).to_le_bytes());
+        self.0.update(bytes);
+    }
+
+    fn put_path(&mut self, tag: &str, path: &Path) {
+        self.put(tag, path.as_os_str().as_encoded_bytes());
+    }
+}
+
+fn digest(ws: &Workspace<'_>, lock: &str, resolve: &Resolve) -> Option<[u8; 32]> {
+    let gctx = ws.gctx();
+    let mut digest = Digest(blake3::Hasher::new());
+    digest.put("format", MEMO_FORMAT.as_bytes());
+    digest.put("cargo", crate::version().to_string().as_bytes());
+    digest.put_path("lock-root", ws.lock_root().as_path_unlocked());
+    digest.put("lock", lock.as_bytes());
+
+    // Manifests the resolution reads from disk.
+    let mut manifests: BTreeSet<PathBuf> = BTreeSet::new();
+    manifests.insert(ws.root_manifest().to_path_buf());
+    for member in ws.members() {
+        manifests.insert(member.manifest_path().to_path_buf());
+    }
+    for id in resolve.iter() {
+        let source = id.source_id();
+        if !source.is_path() || ws.is_member_id(id) {
+            continue;
+        }
+        let dir = source.url().to_file_path().ok()?;
+        manifests.insert(dir.join("Cargo.toml"));
+        // A package outside the workspace can inherit fields from a workspace above it.
+        for ancestor in dir.ancestors().skip(1) {
+            let candidate = ancestor.join("Cargo.toml");
+            if candidate.is_file() {
+                manifests.insert(candidate);
+            }
+        }
+    }
+    for path in &manifests {
+        digest.put_path("manifest", path);
+        digest.put("manifest-bytes", &fs::read(path).ok()?);
+    }
+
+    // Configuration files and `--config` values, in a stable order.
+    let values = gctx.values().ok()?;
+    let mut keys: Vec<&String> = values.keys().collect();
+    keys.sort();
+    for key in keys {
+        digest.put("config", key.as_bytes());
+        digest.put("config-value", format!("{:?}", values[key]).as_bytes());
+    }
+    let mut environment: Vec<(&str, &str)> =
+        gctx.env().filter(|(key, _)| key.starts_with("CARGO")).collect();
+    environment.sort_unstable();
+    for (key, value) in environment {
+        digest.put("env", key.as_bytes());
+        digest.put("env-value", value.as_bytes());
+    }
+    digest.put("unstable", format!("{:?}", gctx.cli_unstable()).as_bytes());
+    Some(*digest.0.finalize().as_bytes())
+}
