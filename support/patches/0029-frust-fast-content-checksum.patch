+/// What reading a file against its recorded length found.
+pub(crate) enum FileDigest {
+    /// The file has the recorded length. This is its checksum.
+    Checksum(Checksum),
+    /// The file's length differs from the recorded one. It is at least this long, and exactly
+    /// this long unless it is longer than the recorded length plus one.
+    Length(u64),
+}
+
+thread_local! {
+    static XXH3_READ_BUFFER: std::cell::RefCell<Vec<u8>> = const { std::cell::RefCell::new(Vec::new()) };
+}
+
+/// Reads `path` once into a reused buffer and returns its XXH3 checksum, or its length when that
+/// differs from `expected_len`. This replaces a metadata call, an open and a loop of 16 KiB reads
+/// by an open and, for most files, a single read. `expected_len` must not exceed
+/// [`XXH3_MAX_FILE_LEN`].
+pub(crate) fn xxh3_file_digest(path: &Path, expected_len: u64) -> io::Result<FileDigest> {
+    if expected_len > XXH3_MAX_FILE_LEN {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "recorded length exceeds the XXH3 limit",
+        ));
+    }
+    let mut file = File::open(path)?;
+    let expected = expected_len as usize;
+    let capacity = expected + 1;
+    XXH3_READ_BUFFER.with(|cell| {
+        let mut buffer = cell.borrow_mut();
+        if buffer.len() < capacity {
+            buffer.resize(capacity, 0);
+        }
+        let mut filled = 0;
+        loop {
+            match file.read(&mut buffer[filled..capacity]) {
+                Ok(0) => break,
+                Ok(count) => filled += count,
+                Err(error) if error.kind() == io::ErrorKind::Interrupted => continue,
+                Err(error) => return Err(error),
+            }
+            if filled == capacity {
+                // Longer than recorded, so it differs whatever its content is.
+                return Ok(FileDigest::Length(filled as u64));
+            }
+            if filled == expected && expected_len < SINGLE_READ_FILE_LEN {
+                break;
+            }
+        }
+        if filled != expected {
+            return Ok(FileDigest::Length(filled as u64));
+        }
+        let mut value = [0; 32];
+        value[..16].copy_from_slice(&crate::frust_xxh3::xxh3_128(&buffer[..filled]));
+        Ok(FileDigest::Checksum(Checksum::new(ChecksumAlgo::Xxh3, value)))
+    })
+}
