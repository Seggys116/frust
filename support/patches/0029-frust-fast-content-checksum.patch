+//! XXH3 with a 128-bit result, seed 0 and the default secret, over a whole buffer.
+//!
+//! fRust's Cargo uses it to fingerprint source files on every build. It reads and hashes a file at
+//! memory speed, several times faster than BLAKE3 on ARM and x86 without wide vector extensions,
+//! and every byte of the input decides the result. It is not a cryptographic hash. A
+//! fingerprint only has to notice that a file changed, and no party is trying to forge one.
+//! The output matches the reference implementation (xxHash 0.8) for every input length; the tests
+//! hold vectors for each length class.
+
+const PRIME32_1: u64 = 0x9E37_79B1;
+const PRIME32_2: u64 = 0x85EB_CA77;
+const PRIME32_3: u64 = 0xC2B2_AE3D;
+const PRIME64_1: u64 = 0x9E37_79B1_85EB_CA87;
+const PRIME64_2: u64 = 0xC2B2_AE3D_27D4_EB4F;
+const PRIME64_3: u64 = 0x1656_67B1_9E37_79F9;
+const PRIME64_4: u64 = 0x85EB_CA77_C2B2_AE63;
+const PRIME64_5: u64 = 0x27D4_EB2F_1656_67C5;
+const PRIME_MX1: u64 = 0x1656_6791_9E37_79F9;
+const PRIME_MX2: u64 = 0x9FB2_1C65_1E98_DF25;
+
+const SECRET_SIZE: usize = 192;
+const SECRET: [u8; SECRET_SIZE] = [
+    0xb8, 0xfe, 0x6c, 0x39, 0x23, 0xa4, 0x4b, 0xbe, 0x7c, 0x01, 0x81, 0x2c, 0xf7, 0x21, 0xad, 0x1c,
+    0xde, 0xd4, 0x6d, 0xe9, 0x83, 0x90, 0x97, 0xdb, 0x72, 0x40, 0xa4, 0xa4, 0xb7, 0xb3, 0x67, 0x1f,
+    0xcb, 0x79, 0xe6, 0x4e, 0xcc, 0xc0, 0xe5, 0x78, 0x82, 0x5a, 0xd0, 0x7d, 0xcc, 0xff, 0x72, 0x21,
+    0xb8, 0x08, 0x46, 0x74, 0xf7, 0x43, 0x24, 0x8e, 0xe0, 0x35, 0x90, 0xe6, 0x81, 0x3a, 0x26, 0x4c,
+    0x3c, 0x28, 0x52, 0xbb, 0x91, 0xc3, 0x00, 0xcb, 0x88, 0xd0, 0x65, 0x8b, 0x1b, 0x53, 0x2e, 0xa3,
+    0x71, 0x64, 0x48, 0x97, 0xa2, 0x0d, 0xf9, 0x4e, 0x38, 0x19, 0xef, 0x46, 0xa9, 0xde, 0xac, 0xd8,
+    0xa8, 0xfa, 0x76, 0x3f, 0xe3, 0x9c, 0x34, 0x3f, 0xf9, 0xdc, 0xbb, 0xc7, 0xc7, 0x0b, 0x4f, 0x1d,
+    0x8a, 0x51, 0xe0, 0x4b, 0xcd, 0xb4, 0x59, 0x31, 0xc8, 0x9f, 0x7e, 0xc9, 0xd9, 0x78, 0x73, 0x64,
+    0xea, 0xc5, 0xac, 0x83, 0x34, 0xd3, 0xeb, 0xc3, 0xc5, 0x81, 0xa0, 0xff, 0xfa, 0x13, 0x63, 0xeb,
+    0x17, 0x0d, 0xdd, 0x51, 0xb7, 0xf0, 0xda, 0x49, 0xd3, 0x16, 0x55, 0x26, 0x29, 0xd4, 0x68, 0x9e,
+    0x2b, 0x16, 0xbe, 0x58, 0x7d, 0x47, 0xa1, 0xfc, 0x8f, 0xf8, 0xb8, 0xd1, 0x7a, 0xd0, 0x31, 0xce,
+    0x45, 0xcb, 0x3a, 0x8f, 0x95, 0x16, 0x04, 0x28, 0xaf, 0xd7, 0xfb, 0xca, 0xbb, 0x4b, 0x40, 0x7e,
+];
+
+const STRIPE_LEN: usize = 64;
+const SECRET_CONSUME_RATE: usize = 8;
+const MID_SIZE_MAX: usize = 240;
+const SECRET_SIZE_MIN: usize = 136;
+const MID_SIZE_START_OFFSET: usize = 3;
+const MID_SIZE_LAST_OFFSET: usize = 17;
+const SECRET_MERGEACCS_START: usize = 11;
+
+#[inline(always)]
+fn read32(bytes: &[u8], at: usize) -> u32 {
+    u32::from_le_bytes(bytes[at..at + 4].try_into().unwrap())
+}
+
+#[inline(always)]
+fn read64(bytes: &[u8], at: usize) -> u64 {
+    u64::from_le_bytes(bytes[at..at + 8].try_into().unwrap())
+}
+
+#[inline(always)]
+fn mul128(a: u64, b: u64) -> (u64, u64) {
+    let product = u128::from(a) * u128::from(b);
+    (product as u64, (product >> 64) as u64)
+}
+
+#[inline(always)]
+fn mul128_fold64(a: u64, b: u64) -> u64 {
+    let (low, high) = mul128(a, b);
+    low ^ high
+}
+
+#[inline(always)]
+fn xorshift64(value: u64, shift: u32) -> u64 {
+    value ^ (value >> shift)
+}
+
+#[inline(always)]
+fn avalanche(mut h: u64) -> u64 {
+    h = xorshift64(h, 37);
+    h = h.wrapping_mul(PRIME_MX1);
+    xorshift64(h, 32)
+}
+
+#[inline(always)]
+fn avalanche64(mut h: u64) -> u64 {
+    h = xorshift64(h, 33);
+    h = h.wrapping_mul(PRIME64_2);
+    h = xorshift64(h, 29);
+    h = h.wrapping_mul(PRIME64_3);
+    xorshift64(h, 32)
+}
+
+fn len_1_to_3(input: &[u8]) -> (u64, u64) {
+    let len = input.len();
+    let c1 = u32::from(input[0]);
+    let c2 = u32::from(input[len >> 1]);
+    let c3 = u32::from(input[len - 1]);
+    let combined_low = (c1 << 16) | (c2 << 24) | c3 | ((len as u32) << 8);
+    let combined_high = combined_low.swap_bytes().rotate_left(13);
+    let bitflip_low = u64::from(read32(&SECRET, 0) ^ read32(&SECRET, 4));
+    let bitflip_high = u64::from(read32(&SECRET, 8) ^ read32(&SECRET, 12));
+    (
+        avalanche64(u64::from(combined_low) ^ bitflip_low),
+        avalanche64(u64::from(combined_high) ^ bitflip_high),
+    )
+}
+
+fn len_4_to_8(input: &[u8]) -> (u64, u64) {
+    let len = input.len();
+    let input_low = u64::from(read32(input, 0));
+    let input_high = u64::from(read32(input, len - 4));
+    let input64 = input_low.wrapping_add(input_high << 32);
+    let bitflip = read64(&SECRET, 16) ^ read64(&SECRET, 24);
+    let keyed = input64 ^ bitflip;
+    let (mut low, mut high) = mul128(keyed, PRIME64_1.wrapping_add((len as u64) << 2));
+    high = high.wrapping_add(low << 1);
+    low ^= high >> 3;
+    low = xorshift64(low, 35);
+    low = low.wrapping_mul(PRIME_MX2);
+    low = xorshift64(low, 28);
+    (low, avalanche(high))
+}
+
+fn len_9_to_16(input: &[u8]) -> (u64, u64) {
+    let len = input.len();
+    let bitflip_low = read64(&SECRET, 32) ^ read64(&SECRET, 40);
+    let bitflip_high = read64(&SECRET, 48) ^ read64(&SECRET, 56);
+    let input_low = read64(input, 0);
+    let mut input_high = read64(input, len - 8);
+    let (mut low, mut high) = mul128(input_low ^ input_high ^ bitflip_low, PRIME64_1);
+    low = low.wrapping_add(((len - 1) as u64) << 54);
+    input_high ^= bitflip_high;
+    high = high.wrapping_add(
+        input_high.wrapping_add((input_high & 0xFFFF_FFFF).wrapping_mul(PRIME32_2 - 1)),
+    );
+    low ^= high.swap_bytes();
+    let (low2, mut high2) = mul128(low, PRIME64_2);
+    high2 = high2.wrapping_add(high.wrapping_mul(PRIME64_2));
+    (avalanche(low2), avalanche(high2))
+}
+
+#[inline(always)]
+fn mix16(input: &[u8], at: usize, secret_at: usize) -> u64 {
+    let low = read64(input, at);
+    let high = read64(input, at + 8);
+    mul128_fold64(
+        low ^ read64(&SECRET, secret_at),
+        high ^ read64(&SECRET, secret_at + 8),
+    )
+}
+
+#[inline(always)]
+fn mix32(acc: (u64, u64), input: &[u8], at1: usize, at2: usize, secret_at: usize) -> (u64, u64) {
+    let mut low = acc.0.wrapping_add(mix16(input, at1, secret_at));
+    low ^= read64(input, at2).wrapping_add(read64(input, at2 + 8));
+    let mut high = acc.1.wrapping_add(mix16(input, at2, secret_at + 16));
+    high ^= read64(input, at1).wrapping_add(read64(input, at1 + 8));
+    (low, high)
+}
+
+fn finish_mid(acc: (u64, u64), len: usize) -> (u64, u64) {
+    let low = acc.0.wrapping_add(acc.1);
+    let high = acc
+        .0
+        .wrapping_mul(PRIME64_1)
+        .wrapping_add(acc.1.wrapping_mul(PRIME64_4))
+        .wrapping_add((len as u64).wrapping_mul(PRIME64_2));
+    (avalanche(low), 0u64.wrapping_sub(avalanche(high)))
+}
+
+fn len_17_to_128(input: &[u8]) -> (u64, u64) {
+    let len = input.len();
+    let mut acc = ((len as u64).wrapping_mul(PRIME64_1), 0u64);
+    if len > 32 {
+        if len > 64 {
+            if len > 96 {
+                acc = mix32(acc, input, 48, len - 64, 96);
+            }
+            acc = mix32(acc, input, 32, len - 48, 64);
+        }
+        acc = mix32(acc, input, 16, len - 32, 32);
+    }
+    acc = mix32(acc, input, 0, len - 16, 0);
+    finish_mid(acc, len)
+}
+
+fn len_129_to_240(input: &[u8]) -> (u64, u64) {
+    let len = input.len();
+    let rounds = len / 32;
+    let mut acc = ((len as u64).wrapping_mul(PRIME64_1), 0u64);
+    for i in 0..4 {
+        acc = mix32(acc, input, 32 * i, 32 * i + 16, 32 * i);
+    }
+    acc = (avalanche(acc.0), avalanche(acc.1));
+    for i in 4..rounds {
+        acc = mix32(
+            acc,
+            input,
+            32 * i,
+            32 * i + 16,
+            MID_SIZE_START_OFFSET + 32 * (i - 4),
+        );
+    }
+    acc = mix32(
+        acc,
+        input,
+        len - 16,
+        len - 32,
+        SECRET_SIZE_MIN - MID_SIZE_LAST_OFFSET - 16,
+    );
+    finish_mid(acc, len)
+}
+
+type Accumulators = [u64; 8];
+
+#[inline(always)]
+fn accumulate_stripe(acc: &mut Accumulators, input: &[u8], secret_at: usize) {
+    let stripe: &[u8; STRIPE_LEN] = input[..STRIPE_LEN].try_into().unwrap();
+    let key: &[u8; STRIPE_LEN] = SECRET[secret_at..secret_at + STRIPE_LEN].try_into().unwrap();
+    let mut data = [0u64; 8];
+    let mut keyed = [0u64; 8];
+    for i in 0..8 {
+        data[i] = u64::from_le_bytes(stripe[8 * i..8 * i + 8].try_into().unwrap());
+        keyed[i] = data[i] ^ u64::from_le_bytes(key[8 * i..8 * i + 8].try_into().unwrap());
+    }
+    for i in 0..8 {
+        acc[i ^ 1] = acc[i ^ 1].wrapping_add(data[i]);
+        acc[i] = acc[i].wrapping_add((keyed[i] & 0xFFFF_FFFF).wrapping_mul(keyed[i] >> 32));
+    }
+}
+
+#[inline(always)]
+fn scramble(acc: &mut Accumulators) {
+    let at = SECRET_SIZE - STRIPE_LEN;
+    for (i, lane) in acc.iter_mut().enumerate() {
+        let mut value = xorshift64(*lane, 47);
+        value ^= read64(&SECRET, at + 8 * i);
+        *lane = value.wrapping_mul(PRIME32_1);
+    }
+}
+
+fn merge_accumulators(acc: &Accumulators, secret_at: usize, start: u64) -> u64 {
+    let mut result = start;
+    for i in 0..4 {
+        result = result.wrapping_add(mul128_fold64(
+            acc[2 * i] ^ read64(&SECRET, secret_at + 16 * i),
+            acc[2 * i + 1] ^ read64(&SECRET, secret_at + 16 * i + 8),
+        ));
+    }
+    avalanche(result)
+}
+
+fn long(input: &[u8]) -> (u64, u64) {
+    let len = input.len();
+    let mut acc: Accumulators = [
+        PRIME32_3, PRIME64_1, PRIME64_2, PRIME64_3, PRIME64_4, PRIME32_2, PRIME64_5, PRIME32_1,
+    ];
+    let stripes_per_block = (SECRET_SIZE - STRIPE_LEN) / SECRET_CONSUME_RATE;
+    let block_len = STRIPE_LEN * stripes_per_block;
+    let blocks = (len - 1) / block_len;
+    for block in 0..blocks {
+        let base = block * block_len;
+        for stripe in 0..stripes_per_block {
+            accumulate_stripe(
+                &mut acc,
+                &input[base + stripe * STRIPE_LEN..],
+                stripe * SECRET_CONSUME_RATE,
+            );
+        }
+        scramble(&mut acc);
+    }
+    let stripes = ((len - 1) - block_len * blocks) / STRIPE_LEN;
+    let base = blocks * block_len;
+    for stripe in 0..stripes {
+        accumulate_stripe(
+            &mut acc,
+            &input[base + stripe * STRIPE_LEN..],
+            stripe * SECRET_CONSUME_RATE,
+        );
+    }
+    accumulate_stripe(
+        &mut acc,
+        &input[len - STRIPE_LEN..],
+        SECRET_SIZE - STRIPE_LEN - 7,
+    );
+    (
+        merge_accumulators(
+            &acc,
+            SECRET_MERGEACCS_START,
+            (len as u64).wrapping_mul(PRIME64_1),
+        ),
+        merge_accumulators(
+            &acc,
+            SECRET_SIZE - STRIPE_LEN - SECRET_MERGEACCS_START,
+            !(len as u64).wrapping_mul(PRIME64_2),
+        ),
+    )
+}
+
+/// The 128-bit XXH3 hash of `input`: the low half in the first eight bytes and the high half in
+/// the last eight, both little endian.
+pub(crate) fn xxh3_128(input: &[u8]) -> [u8; 16] {
+    let (low, high) = match input.len() {
+        0 => {
+            let bitflip_low = read64(&SECRET, 64) ^ read64(&SECRET, 72);
+            let bitflip_high = read64(&SECRET, 80) ^ read64(&SECRET, 88);
+            (avalanche64(bitflip_low), avalanche64(bitflip_high))
+        }
+        1..=3 => len_1_to_3(input),
+        4..=8 => len_4_to_8(input),
+        9..=16 => len_9_to_16(input),
+        17..=128 => len_17_to_128(input),
+        129..=MID_SIZE_MAX => len_129_to_240(input),
+        _ => long(input),
+    };
+    let mut out = [0u8; 16];
+    out[..8].copy_from_slice(&low.to_le_bytes());
+    out[8..].copy_from_slice(&high.to_le_bytes());
+    out
+}
