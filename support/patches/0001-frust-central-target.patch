+    /// When `fcargo` invokes Cargo and the user did not choose a directory,
+    /// place outputs in the namespaced fRust target root.
+    fn apply_frust_central_target(&mut self) -> CargoResult<()> {
+        if !frust_central_target_enabled() {
+            return Ok(());
+        }
+        if self.target_dir.is_some() || self.build_dir.is_some() {
+            return Ok(());
+        }
+        if self.is_ephemeral || self.root_maybe().is_embedded() {
+            return Ok(());
+        }
+        let home = std::env::var_os("HOME")
+            .map(PathBuf::from)
+            .filter(|path| path.is_absolute())
+            .context("fRust could not find an absolute HOME for config.json")?;
+        let xdg_config = std::env::var("XDG_CONFIG_HOME").ok();
+        let xdg_cache = std::env::var("XDG_CACHE_HOME").ok();
+        let os = if cfg!(target_os = "macos") {
+            crate::frust_paths::HostOs::Macos
+        } else {
+            crate::frust_paths::HostOs::Linux
+        };
+        let roots = crate::frust_paths::load_roots_from_host(
+            os,
+            &home,
+            xdg_config.as_deref(),
+            xdg_cache.as_deref(),
+        )
+        .map_err(|err| anyhow!(err.diagnostic()))?;
+        let _cache = crate::frust_paths::open_artifact_cache(&roots.artifacts_dir);
+        let namespaced = crate::frust_paths::namespaced_target_dir(
+            &roots.targets_dir,
+            &frust_toolchain_id()?,
+            self.root(),
+        );
+        self.set_target_dir(Filesystem::new(namespaced));
+        Ok(())
+    }
