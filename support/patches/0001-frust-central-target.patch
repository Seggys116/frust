+fn frust_toolchain_id() -> CargoResult<String> {
+    if let Ok(value) = std::env::var("FRUST_TOOLCHAIN_ID") {
+        return accept_toolchain_id(value);
+    }
+    if let Ok(exe) = std::env::current_exe() {
+        if let Some(root) = exe.parent().and_then(|dir| dir.parent()) {
+            let path = root.join("frust-toolchain-id");
+            match std::fs::read_to_string(&path) {
+                Ok(text) => return accept_toolchain_id(text.trim().to_string()),
+                Err(err) if err.kind() == std::io::ErrorKind::NotFound => {}
+                Err(err) => bail!("fRust could not read {}: {err}", path.display()),
+            }
+        }
+    }
+    Ok("frust-unidentified".to_string())
+}
+
+fn accept_toolchain_id(id: String) -> CargoResult<String> {
+    if id.is_empty() || id.contains('/') || id.contains('\\') || id.as_bytes().contains(&0) {
+        bail!(
+            "fRust rejected toolchain id `{id}`. Use a non-empty FRUST_TOOLCHAIN_ID or frust-toolchain-id value without slashes."
+        );
+    }
+    Ok(id)
+}
