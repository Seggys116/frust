+fn frust_central_target_enabled() -> bool {
+    if std::env::var("FRUST_CENTRAL_TARGET").ok().as_deref() == Some("off") {
+        return false;
+    }
+    if std::env::var("FRUST_INVOCATION").ok().as_deref() == Some("fcargo") {
+        return true;
+    }
+    std::env::args().next().is_some_and(|argv0| {
+        Path::new(&argv0)
+            .file_name()
+            .and_then(|name| name.to_str())
+            == Some("fcargo")
+    })
+}
