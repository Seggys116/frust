+/// Seeds `checksum_cache` with the stored checksums of files whose witnessed
+/// identity is unchanged, so a content check need not read them again.
+pub fn reuse_witnessed_checksums(
+    info: &RustcDepInfo,
+    checksum_cache: &mut HashMap<PathBuf, Checksum>,
+) {
+    for (path, (witness, checksum)) in &info.witnesses {
+        if !checksum_cache.contains_key(path) && witness::matches(path, witness) {
+            checksum_cache.insert(path.clone(), *checksum);
+        }
+    }
 }
 
