+#[cfg(test)]
+mod witness_trailer {
+    use super::*;
+
+    const SOURCE: &[u8] = b"fn main() {}\n";
+
+    fn sample() -> EncodedDepInfo {
+        let checksum = Checksum::compute(ChecksumAlgo::Blake3, SOURCE).unwrap();
+        let file = |name: &str| {
+            let entry = Some((SOURCE.len() as u64, checksum.to_string()));
+            (
+                DepInfoPathType::PackageRootRelative,
+                PathBuf::from(name),
+                entry,
+            )
+        };
+        let witness = FileWitness {
+            dev: 1,
+            ino: 2,
+            ctime: -3,
+            ctime_nsec: 4,
+            len: SOURCE.len() as u64,
+        };
+        EncodedDepInfo {
+            files: vec![file("src/lib.rs"), file("src/main.rs")],
+            env: vec![("A".into(), None)],
+            witnesses: Some(EncodedWitnesses {
+                boot: b"boot".to_vec(),
+                files: vec![(1, witness)],
+            }),
+        }
+    }
+
+    fn plain() -> EncodedDepInfo {
+        EncodedDepInfo {
+            witnesses: None,
+            ..sample()
+        }
+    }
+
+    #[test]
+    fn round_trip_after_unchanged_prefix() {
+        let data = sample().serialize().unwrap();
+        assert_eq!(EncodedDepInfo::parse(&data).unwrap(), sample());
+        // Parsers without the trailer read the same leading bytes and stop there.
+        let prefix = plain().serialize().unwrap();
+        assert!(data.len() > prefix.len() && data.starts_with(&prefix));
+    }
+
+    #[test]
+    fn malformed_trailer_is_discarded_whole() {
+        let data = sample().serialize().unwrap();
+        let start = plain().serialize().unwrap().len();
+        for end in start + 1..data.len() {
+            assert_eq!(EncodedDepInfo::parse(&data[..end]), Some(plain()), "{end}");
+        }
+        let mut extra = data.clone();
+        extra.push(0);
+        assert_eq!(EncodedDepInfo::parse(&extra), Some(plain()));
+        let mut magic = data.clone();
+        magic[start] = b'X';
+        assert_eq!(EncodedDepInfo::parse(&magic), Some(plain()));
+        let mut tie = data;
+        *tie.last_mut().unwrap() ^= 1;
+        assert_eq!(EncodedDepInfo::parse(&tie), Some(plain()));
+    }
+
+    #[test]
+    fn witness_needs_matching_blake3_entry() {
+        let mut info = sample();
+        info.witnesses.as_mut().unwrap().files[0].1.len += 1;
+        let data = info.serialize().unwrap();
+        assert_eq!(data, plain().serialize().unwrap());
+
+        // An explicit rustc checksum in another algorithm never carries a witness.
+        let mut info = sample();
+        let sha256 = Checksum::compute(ChecksumAlgo::Sha256, SOURCE).unwrap();
+        info.files[1].2 = Some((SOURCE.len() as u64, sha256.to_string()));
+        assert_eq!(
+            EncodedDepInfo::parse(&info.serialize().unwrap())
+                .unwrap()
+                .witnesses,
+            None
+        );
+
+        let mut info = sample();
+        info.witnesses.as_mut().unwrap().files[0].0 = 7;
+        assert_eq!(
+            EncodedDepInfo::parse(&info.serialize().unwrap())
+                .unwrap()
+                .witnesses,
+            None
+        );
+    }
+}
