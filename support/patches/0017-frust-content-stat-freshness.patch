+#[cfg(all(test, unix))]
+mod witness_freshness {
+    use super::*;
+    use crate::compiler::fingerprint::StaleItem;
+    use crate::compiler::fingerprint::find_stale_file;
+    use crate::context::FingerprintMethod;
+    use std::fs;
+    use std::time::Duration;
+
+    struct Fixture {
+        _root: tempfile::TempDir,
+        pkg: PathBuf,
+        build: PathBuf,
+        source: PathBuf,
+        dep_info: PathBuf,
+    }
+
+    impl Fixture {
+        /// Writes `contents`, lets its ctime settle and records dep-info as a
+        /// frustc compilation would, listing `listed` (default: the source).
+        fn build(contents: &str, listed: Option<&str>) -> Fixture {
+            let root = tempfile::tempdir().unwrap();
+            let pkg = root.path().join("pkg");
+            let build = root.path().join("build");
+            fs::create_dir_all(pkg.join("src")).unwrap();
+            fs::create_dir_all(&build).unwrap();
+            let source = pkg.join("src/lib.rs");
+            fs::write(&source, contents).unwrap();
+            if let Some(link) = listed {
+                std::os::unix::fs::symlink(&source, pkg.join(link)).unwrap();
+            }
+            std::thread::sleep(Duration::from_millis(250));
+            let invocation = FileTime::now();
+            let listed = listed.map_or(source.clone(), |link| pkg.join(link));
+            let rustc_dep_info = build.join("lib.d");
+            let output = build.join("liblib.rmeta");
+            let rule = format!("{0}: {1}\n\n{1}:\n", output.display(), listed.display());
+            fs::write(&rustc_dep_info, rule).unwrap();
+            let dep_info = build.join("dep-lib-lib");
+            translate_dep_info(
+                &rustc_dep_info,
+                &dep_info,
+                &pkg,
+                &pkg,
+                &build,
+                &ProcessBuilder::new("frustc"),
+                invocation,
+                true,
+                &Arc::new(HashMap::default()),
+            )
+            .unwrap();
+            filetime::set_file_mtime(&dep_info, invocation).unwrap();
+            Fixture {
+                _root: root,
+                pkg,
+                build,
+                source,
+                dep_info,
+            }
+        }
+
+        fn info(&self) -> RustcDepInfo {
+            parse_dep_info(&self.pkg, &self.build, &self.dep_info)
+                .unwrap()
+                .unwrap()
+        }
+
+        /// Whether this host and filesystem should record a witness.
+        fn expects_witness(&self) -> bool {
+            use std::os::unix::fs::MetadataExt;
+            let nsec = fs::metadata(&self.source).unwrap().ctime_nsec();
+            witness::supported(&self.pkg) && nsec != 0
+        }
+
+        /// Runs the content freshness check; also reports whether a witness
+        /// replaced reading the source.
+        fn check(&self) -> (Option<StaleItem>, bool) {
+            let info = self.info();
+            let mut checksums = HashMap::default();
+            reuse_witnessed_checksums(&info, &mut checksums);
+            let reused = checksums.keys().any(|path| path.ends_with("src/lib.rs"));
+            let stale = find_stale_file(
+                &mut HashMap::default(),
+                &mut checksums,
+                &self.dep_info,
+                info.files.iter().map(|(file, checksum)| (file, *checksum)),
+                FingerprintMethod::Content,
+            );
+            (stale, reused)
+        }
+
+        /// Restores the target as an archive would: new inode, newer stamp.
+        fn restore_target(&self) {
+            let bytes = fs::read(&self.dep_info).unwrap();
+            fs::remove_file(&self.dep_info).unwrap();
+            fs::write(&self.dep_info, bytes).unwrap();
+            let stamp = FileTime::from_unix_time(FileTime::now().unix_seconds() + 60, 0);
+            filetime::set_file_mtime(&self.dep_info, stamp).unwrap();
+        }
+    }
+
+    #[test]
+    fn stable_source_reuses_witness() {
+        let unit = Fixture::build("fn a() {}\n", None);
+        let expected = unit.expects_witness();
+        assert_eq!(!unit.info().witnesses.is_empty(), expected);
+        let (stale, reused) = unit.check();
+        assert!(stale.is_none(), "{stale:?}");
+        assert_eq!(reused, expected);
+    }
+
+    #[test]
+    fn in_place_same_size_edit_with_restored_mtime_rebuilds() {
+        let unit = Fixture::build("fn a() {}\n", None);
+        let mtime = FileTime::from_last_modification_time(&fs::metadata(&unit.source).unwrap());
+        fs::write(&unit.source, "fn b() {}\n").unwrap();
+        filetime::set_file_mtime(&unit.source, mtime).unwrap();
+        unit.restore_target();
+        let (stale, reused) = unit.check();
+        assert!(!reused);
+        assert!(
+            matches!(stale, Some(StaleItem::ChangedChecksum { .. })),
+            "{stale:?}"
+        );
+    }
+
+    #[test]
+    fn metadata_preserving_restore_of_different_source_rebuilds() {
+        let unit = Fixture::build("fn a() {}\n", None);
+        let mtime = FileTime::from_last_modification_time(&fs::metadata(&unit.source).unwrap());
+        let staged = unit.pkg.join("src/lib.rs.restore");
+        fs::write(&staged, "fn b() {}\n").unwrap();
+        filetime::set_file_mtime(&staged, mtime).unwrap();
+        fs::rename(&staged, &unit.source).unwrap();
+        unit.restore_target();
+        let (stale, reused) = unit.check();
+        assert!(!reused);
+        assert!(
+            matches!(stale, Some(StaleItem::ChangedChecksum { .. })),
+            "{stale:?}"
+        );
+    }
+
+    #[test]
+    fn metadata_preserving_restore_of_same_source_stays_fresh_by_hash() {
+        let unit = Fixture::build("fn a() {}\n", None);
+        let mtime = FileTime::from_last_modification_time(&fs::metadata(&unit.source).unwrap());
+        let staged = unit.pkg.join("src/lib.rs.restore");
+        fs::write(&staged, "fn a() {}\n").unwrap();
+        filetime::set_file_mtime(&staged, mtime).unwrap();
+        fs::rename(&staged, &unit.source).unwrap();
+        unit.restore_target();
+        let (stale, reused) = unit.check();
+        assert!(!reused);
+        assert!(stale.is_none(), "{stale:?}");
+    }
+
+    #[test]
+    fn removed_source_is_stale() {
+        let unit = Fixture::build("fn a() {}\n", None);
+        fs::remove_file(&unit.source).unwrap();
+        let (stale, reused) = unit.check();
+        assert!(!reused);
+        assert!(stale.is_some());
+    }
+
+    #[test]
+    fn witness_from_another_boot_is_ignored() {
+        let unit = Fixture::build("fn a() {}\n", None);
+        let mut encoded = EncodedDepInfo::parse(&fs::read(&unit.dep_info).unwrap()).unwrap();
+        let Some(trailer) = encoded.witnesses.as_mut() else {
