+//! Kernel-assigned identities of source files that Cargo hashed itself.
+//!
+//! Userspace cannot set ctime, and a restore that keeps mtime still creates a
+//! new inode or ctime, so an exact match of device, inode, ctime and length in
+//! the same boot on a trusted local filesystem shows the hashed bytes are
+//! unchanged. ctime is compared for equality, never ordered against a stamp.
+
+use std::fs::File;
+use std::fs::Metadata;
+use std::path::Path;
+
+use filetime::FileTime;
+
+/// The identity of one regular file as observed while Cargo hashed it.
+#[derive(Copy, Clone, Debug, PartialEq, Eq)]
+pub struct FileWitness {
+    pub dev: u64,
+    pub ino: u64,
+    pub ctime: i64,
+    pub ctime_nsec: u32,
+    pub len: u64,
+}
+
+/// Records a witness for a file hashed through `handle`, whose metadata was
+/// `before` and `after` the hash, if `path` names it without a final symlink.
+pub fn capture(
+    path: &Path,
+    handle: &File,
+    before: &Metadata,
+    after: &Metadata,
+    invocation_time: FileTime,
+) -> Option<FileWitness> {
+    let witness = of(before)?;
+    if of(after)? != witness || !settled(&witness, invocation_time) {
+        return None;
+    }
+    if of(&std::fs::symlink_metadata(path).ok()?)? != witness {
+        return None;
+    }
+    (boot_id().is_some() && sys::trusted_file(handle)).then_some(witness)
+}
+
+/// Whether the file at `path` still has exactly the identity in `witness`.
+pub fn matches(path: &Path, witness: &FileWitness) -> bool {
+    match std::fs::symlink_metadata(path) {
+        Ok(meta) => of(&meta) == Some(*witness) && sys::trusted_path(path),
+        Err(_) => false,
+    }
+}
+
+/// The running kernel boot, so device numbers from another boot never alias.
+pub fn boot_id() -> Option<&'static [u8]> {
+    static BOOT: std::sync::OnceLock<Option<Vec<u8>>> = std::sync::OnceLock::new();
+    BOOT.get_or_init(sys::boot_id)
+        .as_deref()
+        .filter(|id| !id.is_empty())
+}
+
+/// Whether witnesses can be recorded for files under `path` on this host.
+#[cfg(test)]
+pub fn supported(path: &Path) -> bool {
+    boot_id().is_some() && sys::trusted_path(path)
+}
+
+#[cfg(unix)]
+fn of(meta: &Metadata) -> Option<FileWitness> {
+    use std::os::unix::fs::MetadataExt;
+
+    if !meta.file_type().is_file() {
+        return None;
+    }
+    Some(FileWitness {
+        dev: meta.dev(),
+        ino: meta.ino(),
+        ctime: meta.ctime(),
+        ctime_nsec: u32::try_from(meta.ctime_nsec()).ok()?,
+        len: meta.len(),
+    })
+}
+
+#[cfg(not(unix))]
+fn of(_meta: &Metadata) -> Option<FileWitness> {
+    None
+}
+
+/// Whether any change after `invocation_time` must give the file a new ctime.
+fn settled(witness: &FileWitness, invocation_time: FileTime) -> bool {
+    // Coarse kernel clocks may reuse a ctime; a zero fraction hints at 1s stamps.
+    let margin: i128 = if witness.ctime_nsec == 0 {
+        2_000_000_000
+    } else {
+        100_000_000
+    };
+    let ns = |secs: i64, nanos: u32| i128::from(secs) * 1_000_000_000 + i128::from(nanos);
+    let invocation = ns(
+        invocation_time.unix_seconds(),
+        invocation_time.nanoseconds(),
+    );
+    ns(witness.ctime, witness.ctime_nsec) + margin <= invocation
+}
+
+#[cfg(any(target_os = "linux", target_os = "macos"))]
+mod sys {
+    #[cfg(target_os = "macos")]
+    use std::ffi::CStr;
+    use std::ffi::CString;
+    use std::fs::File;
+    use std::mem::MaybeUninit;
+    use std::os::fd::AsRawFd;
+    use std::os::unix::ffi::OsStrExt;
+    use std::path::Path;
+
+    pub fn trusted_file(file: &File) -> bool {
+        let mut stat = MaybeUninit::<libc::statfs>::uninit();
+        // SAFETY: fstatfs initializes the structure on success.
+        let ok = unsafe { libc::fstatfs(file.as_raw_fd(), stat.as_mut_ptr()) } == 0;
+        // SAFETY: fstatfs returned success.
+        ok && trusted(unsafe { stat.assume_init() })
+    }
+
+    pub fn trusted_path(path: &Path) -> bool {
+        let Ok(path) = CString::new(path.as_os_str().as_bytes()) else {
+            return false;
+        };
+        let mut stat = MaybeUninit::<libc::statfs>::uninit();
+        // SAFETY: statfs initializes the structure on success, and path is NUL terminated.
+        let ok = unsafe { libc::statfs(path.as_ptr(), stat.as_mut_ptr()) } == 0;
+        // SAFETY: statfs returned success.
+        ok && trusted(unsafe { stat.assume_init() })
+    }
+
+    #[cfg(target_os = "linux")]
+    pub fn boot_id() -> Option<Vec<u8>> {
+        let id = std::fs::read("/proc/sys/kernel/random/boot_id").ok()?;
+        Some(id.trim_ascii().to_vec())
+    }
+
+    /// In-kernel local filesystems that stamp ctime; others fall back.
+    #[cfg(target_os = "linux")]
+    fn trusted(stat: libc::statfs) -> bool {
+        const EXT4: u32 = 0xEF53;
+        const XFS: u32 = 0x5846_5342;
+        const BTRFS: u32 = 0x9123_683E;
+        const TMPFS: u32 = 0x0102_1994;
+        const F2FS: u32 = 0xF2F5_2010;
+        const BCACHEFS: u32 = 0xCA45_1A4E;
+        matches!(
+            stat.f_type as u32,
+            EXT4 | XFS | BTRFS | TMPFS | F2FS | BCACHEFS
+        )
+    }
+
+    #[cfg(target_os = "macos")]
+    pub fn boot_id() -> Option<Vec<u8>> {
+        let mut buf = [0u8; 64];
+        let mut len = buf.len();
+        // SAFETY: the name is NUL terminated and len bounds the output buffer.
+        let status = unsafe {
+            libc::sysctlbyname(
+                c"kern.bootsessionuuid".as_ptr(),
+                buf.as_mut_ptr().cast(),
+                &mut len,
+                std::ptr::null_mut(),
+                0,
+            )
+        };
+        if status != 0 {
+            return None;
+        }
+        let id = CStr::from_bytes_until_nul(buf.get(..len)?).ok()?;
+        Some(id.to_bytes().to_vec())
+    }
+
+    /// Local APFS and HFS+ volumes only; network and FUSE mounts fall back.
+    #[cfg(target_os = "macos")]
+    fn trusted(stat: libc::statfs) -> bool {
+        // SAFETY: f_fstypename is a NUL terminated array filled by statfs.
+        let name = unsafe { CStr::from_ptr(stat.f_fstypename.as_ptr()) };
+        stat.f_flags & libc::MNT_LOCAL as u32 != 0 && matches!(name.to_bytes(), b"apfs" | b"hfs")
+    }
+}
+
+#[cfg(not(any(target_os = "linux", target_os = "macos")))]
+mod sys {
+    use std::fs::File;
+    use std::path::Path;
+
+    pub fn boot_id() -> Option<Vec<u8>> {
+        None
+    }
+
+    pub fn trusted_file(_file: &File) -> bool {
+        false
+    }
+
+    pub fn trusted_path(_path: &Path) -> bool {
+        false
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn witness(ctime: i64, ctime_nsec: u32) -> FileWitness {
+        FileWitness {
+            dev: 1,
+            ino: 2,
+            ctime,
+            ctime_nsec,
+            len: 3,
+        }
+    }
+
+    #[test]
+    fn settled_requires_margin_before_invocation() {
+        let invocation = FileTime::from_unix_time(1_000, 500_000_000);
+        assert!(settled(&witness(1_000, 400_000_000), invocation));
+        assert!(!settled(&witness(1_000, 400_000_001), invocation));
+        assert!(!settled(&witness(1_001, 0), invocation));
+        // One-second timestamps need a wider margin.
+        assert!(!settled(&witness(999, 0), invocation));
+        assert!(settled(&witness(998, 0), invocation));
+    }
+}
