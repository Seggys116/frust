+        };
+        trailer.boot = b"another-boot".to_vec();
+        fs::write(&unit.dep_info, encoded.serialize().unwrap()).unwrap();
+        assert!(unit.info().witnesses.is_empty());
+        let (stale, reused) = unit.check();
+        assert!(!reused);
+        assert!(stale.is_none(), "{stale:?}");
+    }
+
+    #[test]
+    fn symlinked_source_has_no_witness() {
+        let unit = Fixture::build("fn a() {}\n", Some("src/link.rs"));
+        assert!(unit.info().witnesses.is_empty());
+        let (stale, reused) = unit.check();
+        assert!(!reused);
+        assert!(stale.is_none(), "{stale:?}");
+    }
+}
