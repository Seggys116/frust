+/// The BLAKE3 prefix that ties a witness to its file entry, if they agree.
+fn witness_tie(entry: &Option<(u64, String)>, witness: &FileWitness) -> Option<[u8; 8]> {
+    let (len, checksum) = entry.as_ref()?;
+    let checksum = Checksum::from_str(checksum).ok()?;
+    if *len != witness.len || checksum.algo() != ChecksumAlgo::Blake3 {
+        return None;
+    }
+    checksum.value()[..8].try_into().ok()
 }
 
