@@ -0,0 +1,106 @@
+use super::BuildRunner;
+use crate::compiler::CompileMode;
+use std::collections::{BTreeMap, BTreeSet};
+use std::fs;
+use std::io;
+use std::path::Path;
+
+const KEEP_INACTIVE: usize = 3;
+const MARKER_PREFIX: &str = ".frust-published-bin-v2-";
+
+pub(super) fn collect(build: &BuildRunner<'_, '_>) {
+    let Some(layout) = build.frust_locked_unit_layout() else {
+        return;
+    };
+    if build
+        .bcx
+        .gctx
+        .get_env_os("FRUST_GC")
+        .is_some_and(|value| value == "0")
+    {
+        return;
+    }
+    let result = prune(build, layout.build());
+    if let Err(error) = result {
+        tracing::debug!(%error, "fRust managed build retention skipped");
+    }
+}
+
+fn prune(build: &BuildRunner<'_, '_>, build_dir: &Path) -> io::Result<()> {
+    let roots: Vec<_> = build
+        .compilation
+        .binaries
+        .iter()
+        .filter_map(|binary| {
+            let unit = &binary.unit;
+            if unit.mode != CompileMode::Build || !unit.target.is_bin() || unit.artifact.is_true() {
+                return None;
+            }
+            let output = build.files().out_dir_new_layout(unit);
+            // Only reclaim units whose executable Cargo publishes outside the unit directory.
+            (!binary.path.starts_with(&output))
+                .then(|| output.with_file_name(format!("{MARKER_PREFIX}{}", unit.target.name())))
+        })
+        .collect();
+    if roots.iter().all(|marker| marker.is_file()) {
+        return Ok(());
+    }
+    if !is_real_dir(build_dir) || !build_dir.parent().is_some_and(is_real_dir) {
+        return Ok(());
+    }
+
+    let mut packages = BTreeMap::new();
+    for marker in &roots {
+        if let Some(unit_dir) = marker.parent()
+            && let Some(package) = unit_dir.parent()
+            && package.parent() == Some(build_dir)
+            && let Some(hash) = unit_dir.file_name()
+            && let Some(name) = marker.file_name()
+        {
+            packages
+                .entry((package.to_path_buf(), name.to_owned()))
+                .or_insert_with(BTreeSet::new)
+                .insert(hash.to_owned());
+        }
+    }
+    for ((path, marker), live) in packages {
+        if !is_real_dir(&path) {
+            continue;
+        }
+        let mut inactive = Vec::new();
+        for entry in fs::read_dir(path)? {
+            let entry = entry?;
+            let name = entry.file_name();
+            let valid_hash = name.to_str().is_some_and(|text| {
+                text.len() == 16 && text.bytes().all(|byte| byte.is_ascii_hexdigit())
+            });
+            if !valid_hash || live.contains(&name) || !entry.file_type()?.is_dir() {
+                continue;
+            }
+            let unit = entry.path();
+            if unit.join(&marker).is_file() && is_real_dir(&unit.join("fingerprint")) {
+                inactive.push((entry.metadata()?.modified()?, unit));
+            }
+        }
+        inactive.sort_unstable_by(|left, right| right.cmp(left));
+        for (_, unit) in inactive.into_iter().skip(KEEP_INACTIVE) {
+            fs::remove_dir_all(unit)?;
+        }
+    }
+
+    for marker in roots {
+        if marker.parent().is_some_and(is_real_dir) && !marker.exists() {
+            drop(
+                fs::OpenOptions::new()
+                    .write(true)
+                    .create_new(true)
+                    .open(marker)?,
+            );
+        }
+    }
+    Ok(())
+}
+
+fn is_real_dir(path: &Path) -> bool {
+    fs::symlink_metadata(path).is_ok_and(|metadata| metadata.is_dir())
+}
