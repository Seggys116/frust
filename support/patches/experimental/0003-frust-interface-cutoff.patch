+//! Tests for the fRust interface-hash cutoff (`FRUST_INTERFACE_CUTOFF=1`).
+//!
+//! A stand-in `frustc` runs the real rustc and then appends the interface
+//! lines that frustc writes: the crate hash slot of its own `.rmeta` and of
+//! every `--extern` `.rmeta`. With a stock rustc that slot holds the SVH, so a
+//! dependency rebuilt from identical sources keeps its hash while any source
+//! change alters it. That is enough to exercise every Cargo decision.
+
+use std::ffi::OsString;
+use std::fs;
+use std::path::PathBuf;
+use std::sync::{Mutex, OnceLock};
+
+use crate::prelude::*;
+use cargo_test_support::{Execs, Project, basic_manifest, paths, project, str};
+
+static FRUSTC: OnceLock<Mutex<Option<PathBuf>>> = OnceLock::new();
+
+const SHIM: &str = r##"
+use std::fs::{self, OpenOptions};
+use std::io::Write;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+fn main() {
+    let args = std::env::args()
+        .skip(1)
+        .flat_map(|arg| if let Some(file) = arg.strip_prefix("@") {
+            fs::read_to_string(file).unwrap().lines().map(String::from).collect()
+        } else {
+            vec![arg]
+        })
+        .collect::<Vec<_>>();
+    let real = std::env::var_os("FRUST_TEST_REAL_RUSTC").unwrap_or_else(|| "rustc".into());
+    let status = Command::new(real)
+        .args(&args)
+        .env_remove("FRUST_INTERFACE_HASH")
+        .status()
+        .unwrap();
+    let hash = std::env::var("FRUST_INTERFACE_HASH").as_deref() == Ok("1");
+    let crate_name = value(&args, "--crate-name").filter(|name| name != "___");
+    if let Some(name) = &crate_name {
+        if status.success() && hash {
+            annotate(&args, name);
+        }
+        if let Some(log) = std::env::var_os("FRUST_TEST_LOG") {
+            let mut file = OpenOptions::new().create(true).append(true).open(log).unwrap();
+            file.write_all(format!("{name} hash={}\n", u8::from(hash)).as_bytes()).unwrap();
+        }
+    }
+    std::process::exit(status.code().unwrap_or(1));
+}
+
+fn value(args: &[String], flag: &str) -> Option<String> {
+    let index = args.iter().position(|arg| arg == flag)?;
+    args.get(index + 1).cloned()
+}
+
+fn annotate(args: &[String], crate_name: &str) {
+    let Some(out_dir) = value(args, "--out-dir") else { return };
+    let extra = args
+        .iter()
+        .find_map(|arg| arg.strip_prefix("extra-filename="))
+        .unwrap_or("");
+    let out_dir = PathBuf::from(out_dir);
+    let dep_info = out_dir.join(format!("{crate_name}{extra}.d"));
+    if !dep_info.exists() {
+        return;
+    }
+    let mut text = String::new();
+    if let Some(own) = slot(&out_dir.join(format!("lib{crate_name}{extra}.rmeta"))) {
+        text.push_str(&format!("# frust-iface:v1:{own}\n"));
+    }
+    let mut iter = args.iter();
+    while let Some(arg) = iter.next() {
+        if arg != "--extern" {
+            continue;
+        }
+        let Some(spec) = iter.next() else { break };
+        if let Some((_, path)) = spec.split_once('=') {
+            if let Some(dep) = slot(Path::new(path)) {
+                text.push_str(&format!("# frust-iface-dep:{dep}\n"));
+            }
+        }
+    }
+    let mut file = OpenOptions::new().append(true).open(&dep_info).unwrap();
+    file.write_all(text.as_bytes()).unwrap();
+}
+
+fn slot(path: &Path) -> Option<String> {
+    let bytes = fs::read(path).ok()?;
+    if bytes.len() < 40 || !bytes.starts_with(b"rust\0\0\0") {
+        return None;
+    }
+    Some(bytes[24..40].iter().map(|b| format!("{b:02x}")).collect())
+}
+"##;
+
+/// Builds the stand-in compiler, an executable named exactly `frustc`.
+fn frustc() -> PathBuf {
+    let mut lock = FRUSTC.get_or_init(Default::default).lock().unwrap();
+    if let Some(path) = &*lock {
+        return path.clone();
+    }
+    let p = project()
+        .at(paths::global_root().join("frustc-shim"))
+        .file("Cargo.toml", &basic_manifest("frustc", "1.0.0"))
+        .file("src/main.rs", SHIM)
+        .build();
+    p.cargo("build").run();
+    let path = p.bin("frustc");
+    *lock = Some(path.clone());
+    path
+}
+
+fn real_rustc() -> OsString {
+    // The stand-in must wrap a compiler whose metadata header the cutoff recognises.
+    std::env::var_os("FRUST_TEST_RUSTC")
+        .or_else(|| std::env::var_os("RUSTC"))
+        .unwrap_or_else(|| "rustc".into())
+}
+
+fn log_path() -> PathBuf {
+    paths::root().join("rustc.log")
+}
+
+/// The crates the stand-in compiled since the last call, sorted, with whether
+/// `FRUST_INTERFACE_HASH=1` reached them.
+fn take_log() -> Vec<String> {
+    let path = log_path();
+    let text = fs::read_to_string(&path).unwrap_or_default();
+    let _ = fs::remove_file(&path);
+    let mut lines: Vec<String> = text.lines().map(String::from).collect();
+    lines.sort();
+    lines
+}
+
+fn cargo_with(p: &Project, cmd: &str, mode: bool) -> Execs {
+    let mut execs = p.cargo(cmd);
+    execs
+        .env("RUSTC", frustc())
+        .env("FRUST_TEST_REAL_RUSTC", real_rustc())
+        .env("FRUST_TEST_LOG", log_path())
+        .env_remove("FRUST_INVOCATION")
+        .env_remove("FRUST_INTERFACE_VERIFY")
+        .env_remove("FRUST_INTERFACE_HASH");
+    if mode {
+        execs.env("FRUST_INTERFACE_CUTOFF", "1");
+    } else {
+        execs.env_remove("FRUST_INTERFACE_CUTOFF");
+    }
+    execs
+}
+
+fn remove_outputs(p: &Project, pattern: &str) {
+    let mut removed = 0;
+    for path in p.glob(format!("target/**/{pattern}")) {
+        fs::remove_file(path.unwrap()).unwrap();
+        removed += 1;
+    }
+    assert!(removed > 0, "no output matched {pattern}");
+}
+
+fn manifest(name: &str, deps: &str) -> String {
+    format!(
+        r#"
+            [package]
+            name = "{name}"
+            version = "0.1.0"
+            edition = "2021"
+
+            [dependencies]
+            {deps}
+        "#
+    )
+}
+
+/// `foo` (bin) depends on `b` (lib), which depends on `a` (lib).
+fn chain_project() -> Project {
+    project()
+        .file("Cargo.toml", &manifest("foo", r#"b = { path = "b" }"#))
+        .file("src/main.rs", r#"fn main() { println!("{}", b::value()); }"#)
+        .file("b/Cargo.toml", &manifest("b", r#"a = { path = "../a" }"#))
+        .file("b/src/lib.rs", "pub fn value() -> u32 { a::base() + 1 }")
+        .file("a/Cargo.toml", &manifest("a", ""))
+        .file("a/src/lib.rs", "pub fn base() -> u32 { 41 }")
+        .build()
+}
+
+#[cargo_test(ignore_windows = "the mode keys on an executable named exactly `frustc`")]
+fn mode_is_passed_to_rustc_and_tracked_by_the_fingerprint() {
+    let p = chain_project();
+    cargo_with(&p, "build", true).run();
+    assert_eq!(take_log(), ["a hash=1", "b hash=1", "foo hash=1"]);
+
+    cargo_with(&p, "build", true).run();
+    assert_eq!(take_log(), Vec::<String>::new());
+
+    // Turning the mode off rebuilds everything, and an inherited variable does not leak in.
+    cargo_with(&p, "build", false)
+        .env("FRUST_INTERFACE_HASH", "1")
+        .run();
+    assert_eq!(take_log(), ["a hash=0", "b hash=0", "foo hash=0"]);
+
+    cargo_with(&p, "build", true).run();
+    assert_eq!(take_log(), ["a hash=1", "b hash=1", "foo hash=1"]);
+}
+
+#[cargo_test(ignore_windows = "the mode keys on an executable named exactly `frustc`")]
+fn mode_requires_frustc() {
+    let p = chain_project();
