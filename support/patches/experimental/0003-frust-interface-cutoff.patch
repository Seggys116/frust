+    /// A minimal ELF64 object with one symbol, laid out like the objects rustc writes.
+    fn tiny_elf(symbol: &str, code: &[u8]) -> Vec<u8> {
+        let mut strtab = vec![0u8];
+        let name_off = strtab.len() as u32;
+        strtab.extend_from_slice(symbol.as_bytes());
+        strtab.push(0);
+        let mut shstrtab = vec![0u8];
+        let mut add = |name: &str| {
+            let at = shstrtab.len() as u32;
+            shstrtab.extend_from_slice(name.as_bytes());
+            shstrtab.push(0);
+            at
+        };
+        let (n_text, n_sym, n_str, n_shstr) = (add(".text"), add(".symtab"), add(".strtab"), add(".shstrtab"));
+        let mut symtab = vec![0u8; ELF_SYMBOL_LEN];
+        let mut sym = vec![0u8; ELF_SYMBOL_LEN];
+        sym[..4].copy_from_slice(&name_off.to_le_bytes());
+        sym[4] = 0x12;
+        sym[6..8].copy_from_slice(&1u16.to_le_bytes());
+        symtab.extend_from_slice(&sym);
+
+        let mut out = vec![0u8; ELF_HEADER_LEN];
+        out[..4].copy_from_slice(b"\x7fELF");
+        out[4] = 2;
+        out[5] = 1;
+        let mut place = |out: &mut Vec<u8>, data: &[u8]| {
+            let at = out.len();
+            out.extend_from_slice(data);
+            (at as u64, data.len() as u64)
+        };
+        let text = place(&mut out, code);
+        let syms = place(&mut out, &symtab);
+        let strs = place(&mut out, &strtab);
+        let shstrs = place(&mut out, &shstrtab);
+        let shoff = out.len() as u64;
+        let header = |name: u32, ty: u32, loc: (u64, u64), link: u32, entsize: u64| {
+            let mut h = vec![0u8; ELF_SECTION_LEN];
+            h[..4].copy_from_slice(&name.to_le_bytes());
+            h[4..8].copy_from_slice(&ty.to_le_bytes());
+            h[24..32].copy_from_slice(&loc.0.to_le_bytes());
+            h[32..40].copy_from_slice(&loc.1.to_le_bytes());
+            h[40..44].copy_from_slice(&link.to_le_bytes());
+            h[56..64].copy_from_slice(&entsize.to_le_bytes());
+            h
+        };
+        out.extend(vec![0u8; ELF_SECTION_LEN]);
+        out.extend(header(n_text, 1, text, 0, 0));
+        out.extend(header(n_sym, SHT_SYMTAB, syms, 3, ELF_SYMBOL_LEN as u64));
+        out.extend(header(n_str, SHT_STRTAB, strs, 0, 0));
+        out.extend(header(n_shstr, SHT_STRTAB, shstrs, 0, 0));
+        out[0x28..0x30].copy_from_slice(&shoff.to_le_bytes());
+        out[0x3a..0x3c].copy_from_slice(&(ELF_SECTION_LEN as u16).to_le_bytes());
+        out[0x3c..0x3e].copy_from_slice(&5u16.to_le_bytes());
+        out[0x3e..0x40].copy_from_slice(&4u16.to_le_bytes());
+        out
+    }
