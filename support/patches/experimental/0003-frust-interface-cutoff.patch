+fn stale_build_script_run_runs_rustc() {
+    let p = project()
+        .file("Cargo.toml", &manifest("foo", r#"b = { path = "b" }"#))
+        .file("src/main.rs", r#"fn main() { println!("{}", b::value()); }"#)
+        .file("b/Cargo.toml", &manifest("b", ""))
+        .file(
+            "b/build.rs",
+            r#"fn main() { println!("cargo::rerun-if-changed=input.txt"); }"#,
+        )
+        .file("b/input.txt", "one")
+        .file("b/src/lib.rs", "pub fn value() -> u32 { 42 }")
+        .build();
+    cargo_with(&p, "build", true).run();
+    assert_eq!(
+        take_log(),
+        ["b hash=1", "build_script_build hash=1", "foo hash=1"]
+    );
+
+    p.root().join("b/input.txt").move_into_the_future();
+    cargo_with(&p, "build", true).run();
+    assert_eq!(take_log(), ["b hash=1", "foo hash=1"]);
+}
