+/// Collects the `# frust-iface` dep-info lines. Any malformed or conflicting
+/// line discards the whole set, so a unit is never skipped on partial data.
+#[derive(Default)]
+struct InterfaceLines {
+    own: Option<InterfaceHash>,
+    deps: Vec<InterfaceHash>,
+    invalid: bool,
+}
+
+impl InterfaceLines {
+    fn own(&mut self, hash: Option<InterfaceHash>) {
+        match (hash, self.own) {
+            (Some(hash), Some(prev)) if hash != prev => self.invalid = true,
+            (Some(hash), _) => self.own = Some(hash),
+            (None, _) => self.invalid = true,
+        }
+    }
+
+    fn dep(&mut self, hash: Option<InterfaceHash>) {
+        match hash {
+            Some(hash) => self.deps.push(hash),
+            None => self.invalid = true,
+        }
+    }
+
+    fn finish(mut self) -> Option<InterfaceInfo> {
+        if self.invalid {
+            return None;
+        }
+        let own = self.own?;
+        self.deps.sort_unstable();
+        self.deps.dedup();
+        Some(InterfaceInfo {
+            own,
+            deps: self.deps,
+        })
+    }
+}
+
+/// Parses the text after `# frust-iface:`, which is `v1`, one of `:`, `=` or a
+/// space, and the hex hash. Other format versions are rejected.
+fn parse_own_interface_line(rest: &str) -> Option<InterfaceHash> {
+    let rest = rest.strip_prefix("v1")?;
+    let rest = rest.strip_prefix(|c: char| matches!(c, ':' | '=' | ' '))?;
+    decode_interface_hash(rest.split_whitespace().next()?)
+}
+
+/// Parses the text after `# frust-iface-dep:`, the hex hash optionally
+/// followed by whitespace and further annotations.
+fn parse_dep_interface_line(rest: &str) -> Option<InterfaceHash> {
+    decode_interface_hash(rest.split_whitespace().next()?)
+}
+
+/// Decodes exactly [`INTERFACE_HASH_LEN`] bytes of hex.
+pub fn decode_interface_hash(text: &str) -> Option<InterfaceHash> {
+    if text.len() != INTERFACE_HASH_LEN * 2 {
+        return None;
+    }
+    let mut hash = [0; INTERFACE_HASH_LEN];
+    hex::decode_to_slice(text, &mut hash).ok()?;
+    Some(hash)
+}
