+//! fRust interface-hash cutoff: with `frustc` and `FRUST_INTERFACE_CUTOFF=1`,
+//! a `lib`/`rlib` unit that is dirty only because dependencies were rebuilt
+//! keeps (and touches) its outputs when every direct dependency's rmeta
+//! interface hash is one it was compiled against. Any doubt runs rustc.
+//! `FRUST_INTERFACE_VERIFY=1` compiles skipped units anyway and compares.
+
+use std::ffi::{OsStr, OsString};
+use std::fs::File;
+use std::io::Read;
+use std::path::{Path, PathBuf};
+
+use anyhow::{bail, format_err};
+use cargo_util::{ProcessBuilder, paths};
+use filetime::FileTime;
+use tracing::{debug, info};
+
+use super::dep_info::{INTERFACE_HASH_LEN, InterfaceHash};
+use super::{
+    DirtyReason, Fingerprint, FsStatus, build_root, calculate, dep_info_loc, parse_dep_info,
+};
+use crate::compiler::{BuildContext, BuildRunner, CompileMode, CrateType, FileFlavor, Unit};
+use crate::util;
+use crate::util::errors::CargoResult;
+
+const CUTOFF_ENV: &str = "FRUST_INTERFACE_CUTOFF";
+const VERIFY_ENV: &str = "FRUST_INTERFACE_VERIFY";
+const RUSTC_ENV: &str = "FRUST_INTERFACE_HASH";
+
+/// `METADATA_HEADER` of the pinned rustc (`METADATA_VERSION` 12). Another
+/// version may move the crate-hash slot, so it never matches.
+const RMETA_HEADER: &[u8; 8] = b"rust\0\0\0\x0c";
+/// The header, the root position and the unhashed-root position precede the slot.
+const INTERFACE_HASH_OFFSET: usize = 24;
+/// rustc's `METADATA_FILENAME` inside an rlib.
+const RLIB_METADATA_MEMBER: &str = "lib.rmeta";
+
+pub(super) fn rustc_is_frustc(bcx: &BuildContext<'_, '_>) -> bool {
+    bcx.rustc().path.file_name() == Some(OsStr::new("frustc"))
+}
+
+pub(super) fn enabled(bcx: &BuildContext<'_, '_>, unit: &Unit) -> bool {
+    let mode = unit.mode;
+    let runs_rustc = !(mode.is_doc()
+        || mode.is_doc_scrape()
+        || mode.is_doc_test()
+        || mode.is_run_custom_build());
+    runs_rustc && rustc_is_frustc(bcx) && bcx.gctx.get_env(CUTOFF_ENV).ok() == Some("1")
+}
+
+pub fn configure_interface_hash(bcx: &BuildContext<'_, '_>, unit: &Unit, cmd: &mut ProcessBuilder) {
+    if enabled(bcx, unit) {
+        cmd.env(RUSTC_ENV, "1");
+    } else if rustc_is_frustc(bcx) {
+        // Only Cargo's fingerprint tracks the mode, so an inherited value must not leak in.
+        cmd.env_remove(RUSTC_ENV);
+    }
+}
+
+/// The runtime cutoff check for one library unit, prepared on the main thread.
+pub struct InterfaceCutoff {
+    desc: String,
+    pkg_root: PathBuf,
+    build_root: PathBuf,
+    dep_info: PathBuf,
+    rmeta: PathBuf,
+    rlib: PathBuf,
+    outputs: Vec<PathBuf>,
+    deps: Vec<DepInterface>,
+    verify_dir: Option<PathBuf>,
+}
+
+struct DepInterface {
+    name: String,
+    rmeta: PathBuf,
+}
+
+/// Prepares the cutoff check for a dirty unit, or logs why rustc must run.
+/// Must run before `prepare_target` truncates the stored fingerprint hash.
+pub(super) fn plan(
+    build_runner: &mut BuildRunner<'_, '_>,
+    unit: &Unit,
+    fingerprint: &Fingerprint,
+    reason: &DirtyReason,
+    stored_hash: Option<&str>,
+    forced: bool,
+) -> Option<InterfaceCutoff> {
+    if !enabled(build_runner.bcx, unit) {
+        return None;
+    }
+    let desc = format!("`{}` ({})", unit.pkg.name(), unit.target.description_named());
+    match try_plan(build_runner, unit, fingerprint, reason, stored_hash, forced, &desc) {
+        Ok(Ok(plan)) => {
+            debug!(
+                "interface cutoff: {desc} may skip rustc, checking {} dependencies once they are built",
+                plan.deps.len()
+            );
+            Some(plan)
+        }
+        Ok(Err(why)) => {
+            info!("interface cutoff: rustc runs for {desc}: {why}");
+            None
+        }
+        Err(e) => {
+            info!("interface cutoff: rustc runs for {desc}: {e:#}");
+            None
+        }
+    }
+}
+
+fn try_plan(
+    build_runner: &mut BuildRunner<'_, '_>,
+    unit: &Unit,
+    fingerprint: &Fingerprint,
+    reason: &DirtyReason,
+    stored_hash: Option<&str>,
+    forced: bool,
+    desc: &str,
+) -> CargoResult<Result<InterfaceCutoff, String>> {
+    if forced {
+        return Ok(Err(
+            "the unit or one of its dependencies is forced to rebuild".into()
+        ));
+    }
+    if !matches!(
+        reason,
+        DirtyReason::FsStatusOutdated(
+            FsStatus::StaleDependency { .. } | FsStatus::StaleDepFingerprint { .. }
+        )
+    ) {
+        return Ok(Err(format!(
+            "the dirty reason is not a stale dependency: {reason:?}"
+        )));
+    }
+    if let Some(why) = unit_ineligibility(build_runner, unit) {
+        return Ok(Err(why.to_string()));
+    }
+    // Also covers inputs `Fingerprint::compare` does not report; a failed build
+    // leaves the stored hash empty, so its successor always runs rustc.
+    let current_hash = util::to_hex(fingerprint.hash_u64());
+    if stored_hash != Some(current_hash.as_str()) {
+        return Ok(Err(
+            "the fingerprint differs from the last successful build".into()
+        ));
+    }
+
+    let unit_outputs = build_runner.outputs(unit)?;
+    let rmeta = unit_outputs
+        .iter()
+        .find(|output| output.flavor == FileFlavor::Rmeta)
+        .map(|output| output.path.clone());
+    let rlib = unit_outputs
+        .iter()
+        .find(|output| {
+            output.flavor == FileFlavor::Linkable
+                && output.path.extension() == Some(OsStr::new("rlib"))
+        })
+        .map(|output| output.path.clone());
+    let (Some(rmeta), Some(rlib)) = (rmeta, rlib) else {
+        return Ok(Err("the unit has no separate .rmeta and .rlib outputs".into()));
+    };
+
+    let mut own_mtime = None;
+    for output in &fingerprint.outputs {
+        let Ok(mtime) = paths::mtime(output) else {
+            return Ok(Err(format!("cannot read the mtime of {}", output.display())));
+        };
+        own_mtime = own_mtime.max(Some(mtime));
+    }
+    let Some(own_mtime) = own_mtime else {
+        return Ok(Err("the unit has no tracked outputs".into()));
+    };
+
+    let mut deps = Vec::new();
+    let mut stale_deps = 0;
+    for dep in Vec::from(build_runner.unit_deps(unit)) {
+        // Mirrors `calculate_normal`: plain binaries never make a unit stale.
+        if dep.unit.target.is_bin() && !dep.unit.artifact.is_true() {
+            continue;
+        }
+        let dep_fingerprint = calculate(build_runner, &dep.unit)?;
+        let name = dep.unit.pkg.name();
+        let dep_rmeta = if is_interface_lib(build_runner.bcx, &dep.unit) {
+            build_runner
+                .outputs(&dep.unit)?
+                .iter()
+                .find(|output| output.flavor == FileFlavor::Rmeta)
+                .map(|output| output.path.clone())
+        } else {
+            None
+        };
+        // The same staleness test as `Fingerprint::check_filesystem`, without stopping at the first.
+        let stale = match &dep_fingerprint.fs_status {
+            FsStatus::UpToDate { mtimes } => {
+                let dep_mtime = if build_runner.only_requires_rmeta(unit, &dep.unit) {
+                    let rmeta_mtime = mtimes
+                        .iter()
+                        .find(|(path, _)| path.extension() == Some(OsStr::new("rmeta")))
+                        .map(|(_, mtime)| *mtime);
+                    if rmeta_mtime.is_none() {
+                        return Ok(Err(format!(
+                            "dependency `{name}` has no tracked .rmeta output"
+                        )));
+                    }
+                    rmeta_mtime
+                } else {
+                    mtimes.values().max().copied()
+                };
+                dep_mtime.is_some_and(|mtime| mtime > own_mtime)
+            }
+            FsStatus::Stale
+            | FsStatus::StaleItem(_)
+            | FsStatus::StaleDependency { .. }
+            | FsStatus::StaleDepFingerprint { .. } => true,
+        };
+        if stale {
+            stale_deps += 1;
+            if dep_rmeta.is_none() {
+                let kind = if dep.unit.mode.is_run_custom_build() {
+                    "a build-script run"
+                } else if dep.unit.target.proc_macro() {
+                    "a proc-macro"
+                } else {
+                    "not a library built with interface hashes"
+                };
+                return Ok(Err(format!("stale dependency `{name}` is {kind}")));
+            }
+        }
+        if let Some(rmeta) = dep_rmeta {
+            deps.push(DepInterface {
+                name: dep.extern_crate_name.to_string(),
+                rmeta,
+            });
+        }
+    }
+    if stale_deps == 0 {
+        return Ok(Err("no stale dependency was found".into()));
+    }
+
+    // `check_filesystem` stopped at the first stale dependency, before the unit's own inputs.
+    let build_root = build_root(build_runner);
+    let gctx = build_runner.bcx.gctx;
+    let cargo_exe = gctx.cargo_exe()?;
+    for local in fingerprint.local.lock().unwrap().iter() {
+        if let Some(item) = local.find_stale_item(
+            &mut build_runner.mtime_cache,
+            &mut build_runner.checksum_cache,
+            &unit.pkg,
+            &build_root,
+            cargo_exe,
+            gctx,
+        )? {
+            item.log();
+            return Ok(Err(format!(
+                "its own inputs changed ({} is stale)",
+                local.kind()
+            )));
+        }
+    }
+
+    let verify_dir = (gctx.get_env(VERIFY_ENV).ok() == Some("1")).then(|| {
+        build_runner
+            .files()
+            .fingerprint_dir(unit)
+            .join("frust-iface-verify")
+    });
+    Ok(Ok(InterfaceCutoff {
+        desc: desc.to_string(),
+        pkg_root: unit.pkg.root().to_path_buf(),
+        build_root,
+        dep_info: dep_info_loc(build_runner, unit),
+        rmeta,
+        rlib,
+        outputs: fingerprint.outputs.clone(),
+        deps,
+        verify_dir,
+    }))
+}
+
+fn unit_ineligibility(build_runner: &BuildRunner<'_, '_>, unit: &Unit) -> Option<&'static str> {
+    let why = if unit.mode != CompileMode::Build {
+        "only `build` mode units can skip rustc"
+    } else if !unit.target.is_lib() || unit.target.proc_macro() {
+        "only library targets that are not proc-macros can skip rustc"
+    } else if !unit
+        .target
+        .rustc_crate_types()
+        .iter()
+        .all(|crate_type| matches!(crate_type, CrateType::Lib | CrateType::Rlib))
+    {
+        "crate types other than lib and rlib always relink"
+    } else if unit.artifact.is_true() {
+        "artifact dependencies always run rustc"
+    } else if build_runner.bcx.extra_args_for(unit).is_some() {
+        "extra `cargo rustc` arguments are present"
+    } else {
+        return None;
+    };
+    Some(why)
+}
+
+fn is_interface_lib(bcx: &BuildContext<'_, '_>, unit: &Unit) -> bool {
+    unit.target.is_lib()
+        && !unit.target.proc_macro()
+        && unit.mode == CompileMode::Build
+        && !unit.artifact.is_true()
+        && enabled(bcx, unit)
+}
+
+impl InterfaceCutoff {
+    /// Call once the dependencies' rmeta files exist, before this unit's outputs are removed.
+    pub fn can_skip(&self) -> bool {
+        match self.check() {
+            Ok(()) => {
+                info!(
+                    "interface cutoff: skipping rustc for {}: no direct dependency interface changed",
+                    self.desc
+                );
+                true
+            }
+            Err(why) => {
+                info!("interface cutoff: rustc runs for {}: {why}", self.desc);
+                false
+            }
+        }
+    }
+
+    fn check(&self) -> Result<(), String> {
+        if let Some(missing) = self.outputs.iter().find(|output| !output.exists()) {
+            return Err(format!("output {} is missing", missing.display()));
+        }
+        let info = parse_dep_info(&self.pkg_root, &self.build_root, &self.dep_info)
+            .map_err(|e| format!("cannot read dep-info: {e:#}"))?
+            .ok_or_else(|| format!("dep-info {} is unreadable", self.dep_info.display()))?;
+        let interface = info
+            .interface
+            .ok_or("the dep-info records no interface hashes")?;
+        if read_interface_hash(&self.rmeta)? != interface.own {
+            return Err("the .rmeta header does not match the recorded interface hash".into());
+        }
+        for dep in &self.deps {
+            let hash = read_interface_hash(&dep.rmeta)?;
+            if !interface.deps.contains(&hash) {
+                return Err(format!(
+                    "the interface of `{}` changed to {}",
+                    dep.name,
+                    hex::encode(hash)
+                ));
+            }
+        }
+        Ok(())
+    }
+
+    pub fn verify_requested(&self) -> bool {
+        self.verify_dir.is_some()
+    }
+
+    /// Touches the kept outputs and the dep-info so the next build is fresh.
+    pub fn mark_skipped(&self, timestamp: FileTime) {
+        for output in &self.outputs {
+            paths::set_file_time_no_err(output, timestamp);
+        }
+        paths::set_file_time_no_err(&self.dep_info, timestamp);
+    }
+
+    /// Recompiles into a scratch directory with an empty incremental cache and
+    /// fails unless object code and interface hash match the kept outputs.
+    pub fn verify(&self, rustc: &ProcessBuilder) -> CargoResult<()> {
+        let Some(dir) = &self.verify_dir else {
+            return Ok(());
+        };
+        if dir.exists() {
+            paths::remove_dir_all(dir)?;
+        }
+        let out_dir = dir.join("out");
+        let incremental_dir = dir.join("incremental");
+        paths::create_dir_all(&out_dir)?;
+        let args = redirect_args(rustc.get_args(), &out_dir, &incremental_dir).map_err(|why| {
+            format_err!(
+                "cannot verify the interface cutoff for {}: {why}",
+                self.desc
+            )
+        })?;
+        let mut cmd = rustc.clone();
+        cmd.args_replace(&args);
+        info!("interface cutoff: verifying {} with {cmd}", self.desc);
+
+        let mut diagnostics = String::new();
+        let result = cmd.exec_with_streaming(
+            &mut |_| Ok(()),
+            &mut |line| {
+                if let Some(rendered) = rendered_diagnostic(line) {
+                    diagnostics.push_str(&rendered);
+                }
+                Ok(())
+            },
+            false,
+        );
+        if let Err(e) = result {
+            return Err(e.context(format!(
+                "interface cutoff verification could not compile {}\n{diagnostics}",
+                self.desc
+            )));
+        }
+
+        let fresh = |kept: &Path| kept.file_name().map(|name| out_dir.join(name));
+        let (Some(fresh_rlib), Some(fresh_rmeta)) = (fresh(&self.rlib), fresh(&self.rmeta)) else {
+            bail!("cannot name the verification outputs for {}", self.desc);
+        };
+        if let Some(detail) = self.compare(&fresh_rlib, &fresh_rmeta)? {
+            bail!(
+                "fRust interface cutoff verification failed for {}: {detail}\n\
+                 rustc was skipped because no direct dependency interface changed, \
+                 but a fresh compile differs from the kept outputs.\n\
+                 The fresh outputs are kept in `{}`.",
+                self.desc,
+                dir.display()
+            );
+        }
+        paths::remove_dir_all(dir)?;
+        info!("interface cutoff: verified {}", self.desc);
+        Ok(())
+    }
+
+    fn compare(&self, fresh_rlib: &Path, fresh_rmeta: &Path) -> CargoResult<Option<String>> {
+        let kept = paths::read_bytes(&self.rlib)?;
+        let fresh = paths::read_bytes(fresh_rlib)?;
+        if let Err(detail) = compare_rlib_objects(&kept, &fresh) {
+            return Ok(Some(detail));
+        }
+        let kept_hash = read_interface_hash(&self.rmeta).map_err(anyhow::Error::msg)?;
+        let fresh_hash = read_interface_hash(fresh_rmeta).map_err(anyhow::Error::msg)?;
+        if kept_hash != fresh_hash {
+            return Ok(Some(format!(
+                "the interface hash changed from {} to {}",
+                hex::encode(kept_hash),
+                hex::encode(fresh_hash)
+            )));
+        }
+        Ok(None)
+    }
+}
+
+fn read_interface_hash(path: &Path) -> Result<InterfaceHash, String> {
+    let mut header = [0; INTERFACE_HASH_OFFSET + INTERFACE_HASH_LEN];
+    File::open(path)
+        .and_then(|mut file| file.read_exact(&mut header))
+        .map_err(|e| format!("cannot read the metadata header of {}: {e}", path.display()))?;
+    interface_hash_from_header(&header).ok_or_else(|| {
+        format!(
+            "{} does not start with the expected metadata header",
+            path.display()
+        )
+    })
+}
+
+fn interface_hash_from_header(bytes: &[u8]) -> Option<InterfaceHash> {
+    if !bytes.starts_with(RMETA_HEADER) {
+        return None;
+    }
+    bytes
+        .get(INTERFACE_HASH_OFFSET..INTERFACE_HASH_OFFSET + INTERFACE_HASH_LEN)?
+        .try_into()
+        .ok()
+}
+
+/// Explicit output paths cannot be redirected and are rejected.
+fn redirect_args<'a>(
+    mut args: impl Iterator<Item = &'a OsString>,
+    out_dir: &Path,
+    incremental_dir: &Path,
+) -> Result<Vec<OsString>, String> {
+    let mut result = Vec::new();
+    let mut redirected = false;
+    while let Some(arg) = args.next() {
+        match arg.to_str() {
+            Some("--out-dir") => {
+                args.next().ok_or("`--out-dir` has no value")?;
+                result.push(arg.clone());
+                result.push(out_dir.as_os_str().to_os_string());
+                redirected = true;
+            }
+            Some(flag) if flag.starts_with("--out-dir=") => {
+                result.push(prefixed("--out-dir=", out_dir));
+                redirected = true;
+            }
+            Some("-C") => {
+                let value = args.next().ok_or("`-C` has no value")?;
+                result.push(arg.clone());
+                if value
+                    .to_str()
+                    .is_some_and(|value| value.starts_with("incremental="))
+                {
+                    result.push(prefixed("incremental=", incremental_dir));
+                } else {
+                    result.push(value.clone());
+                }
+            }
+            Some(flag) if flag.starts_with("-Cincremental=") => {
+                result.push(prefixed("-Cincremental=", incremental_dir));
+            }
+            Some(flag) if flag.starts_with("-o") => {
+                return Err("an explicit `-o` output path cannot be redirected".into());
+            }
+            Some("--emit") => {
+                let value = args.next().ok_or("`--emit` has no value")?;
+                if value.to_str().map_or(true, |value| value.contains('=')) {
+                    return Err("an explicit `--emit` output path cannot be redirected".into());
+                }
+                result.push(arg.clone());
+                result.push(value.clone());
+            }
+            Some(flag) if flag.strip_prefix("--emit=").is_some_and(|kinds| kinds.contains('=')) => {
+                return Err("an explicit `--emit` output path cannot be redirected".into());
+            }
+            _ => result.push(arg.clone()),
+        }
+    }
+    if !redirected {
+        return Err("the rustc command has no `--out-dir`".into());
+    }
+    Ok(result)
+}
+
+fn prefixed(prefix: &str, path: &Path) -> OsString {
+    let mut arg = OsString::from(prefix);
+    arg.push(path);
+    arg
+}
+
+fn rendered_diagnostic(line: &str) -> Option<String> {
+    let value: serde_json::Value = serde_json::from_str(line).ok()?;
+    value.get("rendered")?.as_str().map(str::to_owned)
+}
+
+/// Compares object members byte for byte; member headers (timestamps), the
+/// metadata member and symbol tables are not compared.
+fn compare_rlib_objects(kept: &[u8], fresh: &[u8]) -> Result<(), String> {
+    let kept = rlib_objects(kept).map_err(|e| format!("cannot read the kept rlib: {e}"))?;
+    let fresh = rlib_objects(fresh).map_err(|e| format!("cannot read the fresh rlib: {e}"))?;
+    let kept_names: Vec<&str> = kept.iter().map(|(name, _)| name.as_str()).collect();
+    let fresh_names: Vec<&str> = fresh.iter().map(|(name, _)| name.as_str()).collect();
+    if kept_names != fresh_names {
+        let only_kept: Vec<&str> = kept_names
+            .iter()
+            .filter(|name| !fresh_names.contains(*name))
+            .take(5)
+            .copied()
+            .collect();
+        let only_fresh: Vec<&str> = fresh_names
+            .iter()
+            .filter(|name| !kept_names.contains(*name))
+            .take(5)
+            .copied()
+            .collect();
+        return Err(format!(
+            "the object members differ (only kept: [{}]; only fresh: [{}])",
+            only_kept.join(", "),
+            only_fresh.join(", ")
+        ));
+    }
+    for ((name, kept), (_, fresh)) in kept.iter().zip(&fresh) {
+        if !same_member(name, kept, fresh) {
+            let offset = kept
+                .iter()
+                .zip(fresh.iter())
+                .position(|(a, b)| a != b)
+                .unwrap_or(kept.len().min(fresh.len()));
+            return Err(format!(
+                "object `{name}` differs ({} bytes kept, {} bytes fresh, first difference at byte {offset})",
+                kept.len(),
+                fresh.len()
+            ));
+        }
+    }
+    Ok(())
+}
+
+/// Object members of a GNU or BSD `ar` archive, sorted by name.
+fn rlib_objects(data: &[u8]) -> Result<Vec<(String, &[u8])>, String> {
+    const MAGIC: &[u8] = b"!<arch>\n";
+    const HEADER_LEN: usize = 60;
+    if !data.starts_with(MAGIC) {
+        return Err("not an ar archive".into());
+    }
+    let mut pos = MAGIC.len();
+    let mut long_names: &[u8] = &[];
+    let mut members = Vec::new();
+    while pos < data.len() {
+        let header = data
+            .get(pos..pos + HEADER_LEN)
+            .ok_or("truncated member header")?;
+        if &header[58..60] != b"`\n" {
+            return Err("corrupt member header".into());
+        }
+        let size = parse_decimal(&header[48..58]).ok_or("corrupt member size")?;
+        let start = pos + HEADER_LEN;
+        let end = start
+            .checked_add(size)
+            .filter(|end| *end <= data.len())
+            .ok_or("member extends past the end of the archive")?;
+        let mut body = &data[start..end];
+        pos = end + (size & 1);
+
+        let raw = trim_trailing(&header[..16], b' ');
+        let name: &[u8] = if raw == b"/" || raw == b"/SYM64/" {
+            continue;
+        } else if raw == b"//" {
+            long_names = body;
+            continue;
+        } else if let Some(len) = raw.strip_prefix(b"#1/") {
+            let len = parse_decimal(len).ok_or("corrupt BSD member name length")?;
+            let name = body
+                .get(..len)
+                .ok_or("BSD member name extends past the member")?;
+            body = &body[len..];
+            trim_trailing(name, 0)
+        } else if let Some(offset) = raw.strip_prefix(b"/") {
+            let offset = parse_decimal(offset).ok_or("corrupt GNU member name offset")?;
+            let tail = long_names
+                .get(offset..)
+                .ok_or("GNU member name offset is out of range")?;
+            let end = tail.iter().position(|b| *b == b'\n').unwrap_or(tail.len());
+            let name = &tail[..end];
+            name.strip_suffix(b"/").unwrap_or(name)
+        } else {
+            raw.strip_suffix(b"/").unwrap_or(raw)
+        };
+        if name.starts_with(b"__.SYMDEF") || name == RLIB_METADATA_MEMBER.as_bytes() {
+            continue;
+        }
+        members.push((normalize_member_name(&String::from_utf8_lossy(name)), body));
+    }
+    members.sort_by(|a, b| a.0.cmp(&b.0));
+    Ok(members)
+}
+
+/// Whether two members agree, ignoring the invocation suffix in the object-name manifest.
+fn same_member(name: &str, kept: &[u8], fresh: &[u8]) -> bool {
+    kept == fresh
+        || (name.ends_with(".rmeta-link")
+            && strip_invocation_suffixes(kept) == strip_invocation_suffixes(fresh))
+        || (name.ends_with(".rcgu.o") && elf_equal_modulo_promotion_ids(kept, fresh))
+}
+
+/// Removes the digits after `.llvm.` in promoted private symbol names.
+///
+/// LLVM numbers promoted symbols from a hash of the module, so two compiles of the same code can
+/// name them differently.
+fn strip_llvm_promotion_ids(bytes: &[u8]) -> Vec<u8> {
+    const MARK: &[u8] = b".llvm.";
+    let mut out = Vec::with_capacity(bytes.len());
+    let mut i = 0;
+    while i < bytes.len() {
+        out.push(bytes[i]);
+        i += 1;
+        if out.ends_with(MARK) {
+            while i < bytes.len() && bytes[i].is_ascii_digit() {
+                i += 1;
+            }
+        }
+    }
+    out
+}
+
+const SHT_SYMTAB: u32 = 2;
+const SHT_STRTAB: u32 = 3;
+const SHT_NOBITS: u32 = 8;
+const ELF_HEADER_LEN: usize = 64;
+const ELF_SECTION_LEN: usize = 64;
+const ELF_SYMBOL_LEN: usize = 24;
+
+struct ElfSection {
+    name: u32,
+    ty: u32,
+    flags: u64,
+    addr: u64,
+    offset: usize,
+    size: usize,
+    link: u32,
+    info: u32,
+    align: u64,
+    entsize: u64,
+}
+
+struct Elf<'a> {
+    data: &'a [u8],
+    sections: Vec<ElfSection>,
+    shstrndx: usize,
+}
+
+fn le_u16(data: &[u8], at: usize) -> Option<u16> {
+    Some(u16::from_le_bytes(data.get(at..at + 2)?.try_into().ok()?))
+}
+
+fn le_u32(data: &[u8], at: usize) -> Option<u32> {
+    Some(u32::from_le_bytes(data.get(at..at + 4)?.try_into().ok()?))
+}
+
+fn le_u64(data: &[u8], at: usize) -> Option<u64> {
+    Some(u64::from_le_bytes(data.get(at..at + 8)?.try_into().ok()?))
+}
+
+impl<'a> Elf<'a> {
+    /// Parses a little-endian ELF64 relocatable object, or returns `None` for anything else.
+    fn parse(data: &'a [u8]) -> Option<Self> {
+        if data.get(..4)? != b"\x7fELF" || data[4] != 2 || data[5] != 1 {
+            return None;
+        }
+        let shoff = usize::try_from(le_u64(data, 0x28)?).ok()?;
+        let shentsize = usize::from(le_u16(data, 0x3a)?);
+        let shnum = usize::from(le_u16(data, 0x3c)?);
+        let shstrndx = usize::from(le_u16(data, 0x3e)?);
+        if shentsize != ELF_SECTION_LEN || shnum == 0 || shstrndx >= shnum {
+            return None;
+        }
+        let mut sections = Vec::with_capacity(shnum);
+        for i in 0..shnum {
+            let at = shoff.checked_add(i.checked_mul(ELF_SECTION_LEN)?)?;
+            sections.push(ElfSection {
+                name: le_u32(data, at)?,
+                ty: le_u32(data, at + 4)?,
+                flags: le_u64(data, at + 8)?,
+                addr: le_u64(data, at + 16)?,
+                offset: usize::try_from(le_u64(data, at + 24)?).ok()?,
+                size: usize::try_from(le_u64(data, at + 32)?).ok()?,
+                link: le_u32(data, at + 40)?,
+                info: le_u32(data, at + 44)?,
+                align: le_u64(data, at + 48)?,
+                entsize: le_u64(data, at + 56)?,
+            });
+        }
+        Some(Self { data, sections, shstrndx })
+    }
+
+    fn contents(&self, section: &ElfSection) -> Option<&'a [u8]> {
+        if section.ty == SHT_NOBITS {
+            return Some(&[]);
+        }
+        self.data.get(section.offset..section.offset.checked_add(section.size)?)
+    }
+
+    /// The NUL-terminated string at `offset` in the string table section `table`.
+    fn string(&self, table: usize, offset: u32) -> Option<&'a [u8]> {
+        let strings = self.contents(self.sections.get(table)?)?;
+        let tail = strings.get(usize::try_from(offset).ok()?..)?;
+        Some(&tail[..tail.iter().position(|b| *b == 0)?])
+    }
+}
+
+/// Whether two ELF objects are the same apart from the numbers in promoted symbol names.
+///
+/// Sections must agree in order, type, flags and contents. Symbol and section names are compared
+/// with those numbers removed, because the numbers change the string table layout and with it every
+/// stored name offset. Anything that is not an ELF64 object compares as different.
+fn elf_equal_modulo_promotion_ids(kept: &[u8], fresh: &[u8]) -> bool {
+    let (Some(kept), Some(fresh)) = (Elf::parse(kept), Elf::parse(fresh)) else { return false };
+    if kept.sections.len() != fresh.sections.len() || kept.shstrndx != fresh.shstrndx {
+        return false;
+    }
+    // The file header must match except for the section header table offset.
+    let header_equal = |a: &[u8], b: &[u8]| {
+        let (Some(a), Some(b)) = (a.get(..ELF_HEADER_LEN), b.get(..ELF_HEADER_LEN)) else {
+            return false;
+        };
+        a[..0x28] == b[..0x28] && a[0x30..] == b[0x30..]
+    };
+    if !header_equal(kept.data, fresh.data) {
+        return false;
+    }
+    for (a, b) in kept.sections.iter().zip(&fresh.sections) {
+        let same_name = match (
+            kept.string(kept.shstrndx, a.name),
+            fresh.string(fresh.shstrndx, b.name),
+        ) {
+            (Some(x), Some(y)) => strip_llvm_promotion_ids(x) == strip_llvm_promotion_ids(y),
+            _ => false,
+        };
+        if !same_name
+            || (a.ty, a.flags, a.addr, a.link, a.info, a.align, a.entsize)
+                != (b.ty, b.flags, b.addr, b.link, b.info, b.align, b.entsize)
+        {
+            return false;
+        }
+        let equal = match a.ty {
+            SHT_STRTAB => true,
+            SHT_SYMTAB => symbols_equal(&kept, a, &fresh, b),
+            _ => matches!((kept.contents(a), fresh.contents(b)), (Some(x), Some(y)) if x == y)
+                && a.size == b.size,
+        };
+        if !equal {
+            return false;
+        }
+    }
+    true
+}
+
+fn symbols_equal(kept: &Elf<'_>, a: &ElfSection, fresh: &Elf<'_>, b: &ElfSection) -> bool {
+    let (Some(x), Some(y)) = (kept.contents(a), fresh.contents(b)) else { return false };
+    if x.len() != y.len() || x.len() % ELF_SYMBOL_LEN != 0 {
+        return false;
+    }
+    let table = |elf: &Elf<'_>, section: &ElfSection| usize::try_from(section.link).ok().filter(|t| *t < elf.sections.len());
+    let (Some(ta), Some(tb)) = (table(kept, a), table(fresh, b)) else { return false };
+    x.chunks(ELF_SYMBOL_LEN).zip(y.chunks(ELF_SYMBOL_LEN)).all(|(sa, sb)| {
+        let names = match (
+            le_u32(sa, 0).and_then(|n| kept.string(ta, n)),
+            le_u32(sb, 0).and_then(|n| fresh.string(tb, n)),
+        ) {
+            (Some(na), Some(nb)) => strip_llvm_promotion_ids(na) == strip_llvm_promotion_ids(nb),
+            _ => false,
+        };
+        names && sa[4..] == sb[4..]
+    })
+}
+
+/// Removes every `.xxxxxxx` (seven base-36 characters) that precedes `.rcgu.o` in `bytes`.
+fn strip_invocation_suffixes(bytes: &[u8]) -> Vec<u8> {
+    const TAIL: &[u8] = b".rcgu.o";
+    let mut out = Vec::with_capacity(bytes.len());
+    let mut i = 0;
+    while i < bytes.len() {
+        let suffix_at = i;
+        let is_suffix = bytes[i] == b'.'
+            && bytes.len() >= i + 8 + TAIL.len()
+            && bytes[i + 1..i + 8].iter().all(|b| b.is_ascii_digit() || b.is_ascii_lowercase())
+            && bytes[i + 8..].starts_with(TAIL);
+        if is_suffix {
+            i += 8;
+        } else {
+            out.push(bytes[suffix_at]);
+            i += 1;
+        }
+    }
+    out
+}
+
+/// Drops the per-invocation suffix that incremental compilation adds to object names.
+///
+/// It is exactly seven base-36 characters before `.rcgu.o`, so two compiles of the same code
+/// never agree on it.
+fn normalize_member_name(name: &str) -> String {
+    let Some(stem) = name.strip_suffix(".rcgu.o") else { return name.to_string() };
+    match stem.rsplit_once('.') {
+        Some((head, suffix))
+            if suffix.len() == 7
+                && suffix.bytes().all(|b| b.is_ascii_digit() || b.is_ascii_lowercase()) =>
+        {
+            format!("{head}.rcgu.o")
+        }
+        _ => name.to_string(),
+    }
+}
+
+fn trim_trailing(bytes: &[u8], pad: u8) -> &[u8] {
+    let end = bytes.iter().rposition(|b| *b != pad).map_or(0, |i| i + 1);
+    &bytes[..end]
+}
+
+fn parse_decimal(bytes: &[u8]) -> Option<usize> {
+    let digits = trim_trailing(bytes, b' ');
+    if digits.is_empty() || !digits.iter().all(u8::is_ascii_digit) {
+        return None;
+    }
+    std::str::from_utf8(digits).ok()?.parse().ok()
+}
