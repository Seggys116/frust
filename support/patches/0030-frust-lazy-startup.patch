+fn lazy_curl_link_args() {
+    use std::env;
+    if env::var("CARGO_CFG_TARGET_OS").as_deref() == Ok("linux")
+        && env::var_os("CARGO_FEATURE_HTTP_TRANSPORT_CURL").is_some()
