diff --git a/src/bin/cargo/lazy_curl.rs b/src/bin/cargo/lazy_curl.rs
new file mode 100644
index 0000000..b05739e
--- /dev/null
+++ b/src/bin/cargo/lazy_curl.rs
@@ -0,0 +1,61 @@
+//! Defers libcurl's global initialization until a handle is created.
+//!
+//! The `curl` crate calls `curl_global_init` from a constructor that runs before `main`. That
+//! initializes OpenSSL, which loads its error strings and builds its name tables. Most Cargo
+//! commands never open a network connection, so this was paid on every start. The linker wraps
+//! `curl_global_init` (see `build.rs`), so the constructor only records the requested flags. The
+//! first call that creates a libcurl handle runs the real initialization exactly once, from a
+//! `Once`, which keeps it thread safe.
+
+use std::ffi::{c_int, c_long, c_void};
+use std::sync::Once;
+use std::sync::atomic::{AtomicI64, Ordering};
+
+/// `CURL_GLOBAL_ALL`, which is what the `curl` crate asks for.
+const CURL_GLOBAL_ALL: c_long = 3;
+
+unsafe extern "C" {
+    fn __real_curl_global_init(flags: c_long) -> c_int;
+    fn __real_curl_easy_init() -> *mut c_void;
+    fn __real_curl_multi_init() -> *mut c_void;
+    fn __real_curl_share_init() -> *mut c_void;
+}
+
+static FLAGS: AtomicI64 = AtomicI64::new(CURL_GLOBAL_ALL as i64);
+static INIT: Once = Once::new();
+
+fn ensure_initialized() {
+    INIT.call_once(|| {
+        let flags = FLAGS.load(Ordering::SeqCst) as c_long;
+        // SAFETY: this is libcurl's own initializer, called once before any handle exists.
+        let code = unsafe { __real_curl_global_init(flags) };
+        assert_eq!(code, 0, "libcurl global initialization failed");
+    });
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn __wrap_curl_global_init(flags: c_long) -> c_int {
+    FLAGS.store(flags as i64, Ordering::SeqCst);
+    0
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn __wrap_curl_easy_init() -> *mut c_void {
+    ensure_initialized();
+    // SAFETY: forwards to libcurl after initialization.
+    unsafe { __real_curl_easy_init() }
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn __wrap_curl_multi_init() -> *mut c_void {
+    ensure_initialized();
+    // SAFETY: forwards to libcurl after initialization.
+    unsafe { __real_curl_multi_init() }
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn __wrap_curl_share_init() -> *mut c_void {
+    ensure_initialized();
+    // SAFETY: forwards to libcurl after initialization.
+    unsafe { __real_curl_share_init() }
+}
