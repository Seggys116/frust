+/// The builtin command that `argv` selects, when it can be found without a full parse.
+///
+/// Only global options with known shapes may precede the command. Help, version and list
+/// requests, option values this scan does not know and anything else unusual return `None`, and
+/// the caller builds every command as before.
+fn selected_builtin(argv: &[OsString]) -> Option<Command> {
+    let mut rest = argv.iter().skip(1);
+    while let Some(arg) = rest.next() {
+        let arg = arg.to_str()?;
+        match arg {
+            "--" => return None,
+            "--color" | "--config" | "-Z" | "-C" => {
+                rest.next()?;
+            }
+            "-v" | "-vv" | "-vvv" | "-q" | "--verbose" | "--quiet" | "--locked" | "--offline"
+            | "--frozen" => {}
+            _ if arg.starts_with("--color=") || arg.starts_with("--config=") => {}
+            _ if arg.starts_with("-Z") && arg.len() > 2 => {}
+            _ if arg.starts_with('-') => return None,
+            name => return commands::builtin_named(name),
+        }
+    }
+    None
+}
