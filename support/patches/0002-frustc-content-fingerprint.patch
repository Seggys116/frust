+
+fn frustc_checksum(rustc_cwd: &Path, file: &Path) -> Option<(u64, Checksum)> {
+    let abs = if file.is_absolute() {
+        file.to_path_buf()
+    } else {
+        rustc_cwd.join(file)
+    };
+    let meta = std::fs::metadata(&abs).ok()?;
+    let handle = File::open(&abs).ok()?;
+    let checksum = Checksum::compute(ChecksumAlgo::Blake3, handle).ok()?;
+    Some((meta.len(), checksum))
+}
