+/// The job count when neither `-j` nor `build.jobs` is set: one per logical
+/// CPU, lowered when the memory available to this process holds fewer jobs
+/// (see [`memory_jobs`]). An external jobserver already bounds concurrency,
+/// so it keeps the CPU count.
+fn implicit_jobs(gctx: &GlobalContext, cpus: u32) -> CargoResult<u32> {
+    if gctx.jobserver_from_env().is_some() {
+        return Ok(cpus);
+    }
+    let Some(available) = memory_jobs::available_memory() else {
+        return Ok(cpus);
+    };
+    let jobs = memory_jobs::limited_jobs(cpus, available);
+    if jobs < cpus {
+        gctx.shell().verbose(|shell| {
+            shell.note(format!(
+                "using {jobs} parallel jobs instead of {cpus} because about {} MiB of memory is available; \
+                 pass `-j` or set `build.jobs` to choose a count",
+                available >> 20
+            ))
+        })?;
+    }
+    Ok(jobs)
+}
+
+/// Resolves the job count from an explicit request. An explicit request,
+/// including a negative count relative to the CPUs and `default`, is never
+/// changed by memory; only an absent request calls `implicit`.
+fn resolve_jobs(
+    requested: Option<JobsConfig>,
+    cpus: impl Fn() -> CargoResult<u32>,
+    implicit: impl FnOnce(u32) -> CargoResult<u32>,
+) -> CargoResult<u32> {
+    match requested {
+        None => implicit(cpus()?),
+        Some(JobsConfig::Integer(j)) => match j {
+            0 => anyhow::bail!("jobs may not be 0"),
+            j if j < 0 => Ok((cpus()? as i32 + j).max(1) as u32),
+            j => Ok(j as u32),
+        },
+        Some(JobsConfig::String(j)) => match j.as_str() {
+            "default" => cpus(),
+            _ => {
+                anyhow::bail!(format!(
+                    "could not parse `{j}`. Number of parallel jobs should be `default` or a number."
+                ))
+            }
+        },
+    }
+}
