+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn cpus(count: u32) -> impl Fn() -> CargoResult<u32> {
+        move || Ok(count)
+    }
+
+    fn no_implicit(_: u32) -> CargoResult<u32> {
+        panic!("an explicit job request must not use the implicit default")
+    }
+
+    fn resolve(requested: Option<JobsConfig>, count: u32) -> CargoResult<u32> {
+        resolve_jobs(requested, cpus(count), no_implicit)
+    }
+
+    #[test]
+    fn explicit_counts_are_used_as_given() {
+        assert_eq!(resolve(Some(JobsConfig::Integer(3)), 16).unwrap(), 3);
+        assert_eq!(resolve(Some(JobsConfig::Integer(64)), 4).unwrap(), 64);
+    }
+
+    #[test]
+    fn negative_counts_are_relative_to_the_cpus() {
+        assert_eq!(resolve(Some(JobsConfig::Integer(-3)), 8).unwrap(), 5);
+        assert_eq!(resolve(Some(JobsConfig::Integer(-20)), 8).unwrap(), 1);
+    }
+
+    #[test]
+    fn default_is_the_cpu_count() {
+        let requested = Some(JobsConfig::String("default".to_string()));
+        assert_eq!(resolve(requested, 12).unwrap(), 12);
+    }
+
+    #[test]
+    fn invalid_requests_are_rejected() {
+        assert!(resolve(Some(JobsConfig::Integer(0)), 8).is_err());
+        assert!(resolve(Some(JobsConfig::String("many".to_string())), 8).is_err());
+    }
+
+    #[test]
+    fn an_absent_request_uses_the_implicit_default() {
+        let jobs = resolve_jobs(None, cpus(16), |cpus| Ok(cpus / 4)).unwrap();
+        assert_eq!(jobs, 4);
+    }
+
+    #[test]
+    fn explicit_requests_do_not_query_the_cpus_when_not_needed() {
+        let jobs = resolve_jobs(
+            Some(JobsConfig::Integer(2)),
+            || panic!("positive counts do not need the CPU count"),
+            no_implicit,
+        );
+        assert_eq!(jobs.unwrap(), 2);
+    }
