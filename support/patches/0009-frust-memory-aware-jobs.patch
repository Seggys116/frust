+//! Memory-aware default for the number of parallel jobs.
+//!
+//! Cargo defaults to one job per logical CPU. When the memory that is
+//! actually available cannot hold that many compiler processes, the default
+//! is lowered so the build finishes instead of being killed or swapping.
+
+/// Memory budgeted for one parallel job, in bytes.
+///
+/// The largest single-process peak resident set recorded for a release build
+/// in `qualification/BASELINES.md` is 537024 kB (about 524 MiB). One GiB is
+/// roughly twice that. The measurements cover four crates, so the figure is
+/// a floor taken from that evidence, not a bound for every crate.
+const BYTES_PER_JOB: u64 = 1 << 30;
+
+/// The job count to use by default: `cpus`, unless `available_bytes` holds
+/// fewer than `cpus` jobs of [`BYTES_PER_JOB`], and never less than one.
+pub fn limited_jobs(cpus: u32, available_bytes: u64) -> u32 {
+    let by_memory = (available_bytes / BYTES_PER_JOB).max(1);
+    u32::try_from(by_memory).map_or(cpus, |jobs| jobs.min(cpus))
+}
+
+/// Bytes of memory a new build can use, or `None` when it cannot be
+/// determined. Only Linux reports a figure.
+pub fn available_memory() -> Option<u64> {
+    #[cfg(target_os = "linux")]
+    {
+        linux::available_memory()
+    }
+    #[cfg(not(target_os = "linux"))]
+    {
+        None
+    }
+}
+
+#[cfg(target_os = "linux")]
+mod linux {
+    use std::fs;
+    use std::path::Path;
+
+    const CGROUP_ROOT: &str = "/sys/fs/cgroup";
+
+    /// The smaller of the host's `MemAvailable` and the headroom left by
+    /// the cgroup v2 limits that apply to this process.
+    pub fn available_memory() -> Option<u64> {
+        let host = fs::read_to_string("/proc/meminfo")
+            .ok()
+            .and_then(|meminfo| mem_available(&meminfo));
+        let cgroup = fs::read_to_string("/proc/self/cgroup")
+            .ok()
+            .and_then(|own| cgroup_headroom(Path::new(CGROUP_ROOT), cgroup_path(&own)?));
+        match (host, cgroup) {
+            (Some(host), Some(cgroup)) => Some(host.min(cgroup)),
+            (host, cgroup) => host.or(cgroup),
+        }
+    }
+
+    /// `MemAvailable` from `/proc/meminfo`, in bytes.
+    fn mem_available(meminfo: &str) -> Option<u64> {
+        let line = meminfo
+            .lines()
+            .find_map(|line| line.strip_prefix("MemAvailable:"))?;
+        let kib: u64 = line.trim().strip_suffix("kB")?.trim().parse().ok()?;
+        kib.checked_mul(1024)
+    }
+
+    /// The cgroup v2 path from `/proc/self/cgroup`. A v1 hierarchy has no
+    /// `0::` line and yields `None`.
+    fn cgroup_path(proc_cgroup: &str) -> Option<&str> {
+        proc_cgroup
+            .lines()
+            .find_map(|line| line.strip_prefix("0::"))
+    }
+
+    /// The smallest headroom among `cgroup` and its ancestors below `root`
+    /// that set a memory limit.
+    fn cgroup_headroom(root: &Path, cgroup: &str) -> Option<u64> {
+        let mut dir = root.join(cgroup.trim_start_matches('/'));
+        let mut smallest: Option<u64> = None;
+        loop {
+            if let Some(room) = level_headroom(&dir) {
+                smallest = Some(smallest.map_or(room, |current| current.min(room)));
+            }
+            if dir == root || !dir.pop() {
+                return smallest;
+            }
+        }
+    }
+
+    /// Headroom under one cgroup's `memory.max` or `memory.high`, whichever
+    /// is lower, or `None` when it sets neither.
+    fn level_headroom(dir: &Path) -> Option<u64> {
+        let read = |name: &str| fs::read_to_string(dir.join(name)).ok();
+        let max = read("memory.max").and_then(|text| parse_limit(&text));
+        let high = read("memory.high").and_then(|text| parse_limit(&text));
+        let limit = match (max, high) {
+            (Some(max), Some(high)) => max.min(high),
+            (max, high) => max.or(high)?,
+        };
+        let current: u64 = read("memory.current")?.trim().parse().ok()?;
+        let reclaimable = read("memory.stat")
+            .and_then(|stat| stat_value(&stat, "inactive_file"))
+            .unwrap_or(0);
+        Some(headroom(limit, current, reclaimable))
+    }
+
+    /// Bytes left under `limit`. Inactive file cache is reclaimable and is
+    /// not counted as use, as in the container working-set convention.
+    fn headroom(limit: u64, current: u64, reclaimable: u64) -> u64 {
+        limit.saturating_sub(current.saturating_sub(reclaimable))
+    }
+
+    /// A numeric cgroup limit; `max` means no limit.
+    fn parse_limit(text: &str) -> Option<u64> {
+        match text.trim() {
+            "max" => None,
+            number => number.parse().ok(),
+        }
+    }
+
+    /// The value of `key` in a `memory.stat` style `key value` listing.
+    fn stat_value(stat: &str, key: &str) -> Option<u64> {
+        stat.lines().find_map(|line| {
+            let (name, value) = line.split_once(' ')?;
+            if name != key {
+                return None;
+            }
+            value.trim().parse().ok()
+        })
+    }
+
+    #[cfg(test)]
+    mod tests {
+        use super::*;
+
+        const GIB: u64 = 1 << 30;
+
+        fn write_level(dir: &Path, files: &[(&str, &str)]) {
+            fs::create_dir_all(dir).unwrap();
+            for (name, text) in files {
+                fs::write(dir.join(name), text).unwrap();
+            }
+        }
+
+        #[test]
+        fn meminfo_available_is_converted_to_bytes() {
+            let meminfo = "MemTotal:       65536000 kB\nMemFree:         1000 kB\nMemAvailable:   16384000 kB\nBuffers: 1 kB\n";
+            assert_eq!(mem_available(meminfo), Some(16_384_000 * 1024));
+        }
+
+        #[test]
+        fn meminfo_without_available_or_with_garbage_is_none() {
+            assert_eq!(mem_available("MemTotal: 1 kB\nMemFree: 1 kB\n"), None);
+            assert_eq!(mem_available("MemAvailable: lots kB\n"), None);
+            assert_eq!(mem_available("MemAvailable: 12\n"), None);
+            assert_eq!(mem_available(""), None);
+        }
+
+        #[test]
+        fn cgroup_path_reads_the_unified_hierarchy_only() {
+            assert_eq!(
+                cgroup_path("0::/user.slice/a.scope\n"),
+                Some("/user.slice/a.scope")
+            );
+            assert_eq!(cgroup_path("0::/\n"), Some("/"));
+            assert_eq!(cgroup_path("12:memory:/legacy\n11:cpu:/legacy\n"), None);
+            assert_eq!(
+                cgroup_path("12:memory:/legacy\n0::/unified\n"),
+                Some("/unified")
+            );
+        }
+
+        #[test]
+        fn limits_parse_numbers_and_treat_max_as_unset() {
+            assert_eq!(parse_limit("max\n"), None);
+            assert_eq!(parse_limit("4294967296\n"), Some(4 * GIB));
+            assert_eq!(parse_limit("garbage"), None);
+        }
+
+        #[test]
+        fn stat_value_finds_the_named_key() {
+            let stat = "anon 100\nfile 900\ninactive_file 700\nactive_file 200\n";
+            assert_eq!(stat_value(stat, "inactive_file"), Some(700));
+            assert_eq!(stat_value(stat, "file"), Some(900));
+            assert_eq!(stat_value(stat, "slab"), None);
+        }
+
+        #[test]
+        fn headroom_excludes_reclaimable_cache_and_never_underflows() {
+            assert_eq!(headroom(4 * GIB, GIB, 0), 3 * GIB);
+            assert_eq!(headroom(4 * GIB, 4 * GIB, 3 * GIB), 3 * GIB);
+            assert_eq!(headroom(GIB, 2 * GIB, 0), 0);
+            assert_eq!(headroom(GIB, GIB, 2 * GIB), GIB);
+        }
+
+        #[test]
+        fn nearest_limited_ancestor_wins() {
+            let root = tempfile::tempdir().unwrap();
+            let parent = root.path().join("a");
+            let child = parent.join("b");
+            write_level(
+                &parent,
+                &[
+                    ("memory.max", "2147483648\n"),
+                    ("memory.current", "1073741824\n"),
+                    ("memory.stat", "inactive_file 0\n"),
+                ],
+            );
+            write_level(
+                &child,
+                &[
+                    ("memory.max", "8589934592\n"),
+                    ("memory.current", "0\n"),
+                    ("memory.stat", "inactive_file 0\n"),
+                ],
+            );
+            // The child alone has 8 GiB, but its parent leaves only 1 GiB.
+            assert_eq!(cgroup_headroom(root.path(), "/a/b"), Some(GIB));
+        }
+
+        #[test]
+        fn unlimited_levels_and_the_root_contribute_nothing() {
+            let root = tempfile::tempdir().unwrap();
+            let leaf = root.path().join("a");
+            write_level(
+                &leaf,
+                &[
+                    ("memory.max", "max\n"),
+                    ("memory.high", "max\n"),
+                    ("memory.current", "123\n"),
+                ],
+            );
+            assert_eq!(cgroup_headroom(root.path(), "/a"), None);
+            assert_eq!(cgroup_headroom(root.path(), "/"), None);
+            assert_eq!(cgroup_headroom(root.path(), "/missing/dir"), None);
+        }
+
+        #[test]
+        fn memory_high_applies_when_lower_than_memory_max() {
+            let root = tempfile::tempdir().unwrap();
+            let leaf = root.path().join("a");
+            write_level(
+                &leaf,
+                &[
+                    ("memory.max", "8589934592\n"),
+                    ("memory.high", "3221225472\n"),
+                    ("memory.current", "1073741824\n"),
+                ],
+            );
+            assert_eq!(cgroup_headroom(root.path(), "/a"), Some(2 * GIB));
+        }
+
+        #[test]
+        fn a_limit_without_a_readable_current_value_is_ignored() {
+            let root = tempfile::tempdir().unwrap();
+            let leaf = root.path().join("a");
+            write_level(&leaf, &[("memory.max", "1073741824\n")]);
+            assert_eq!(cgroup_headroom(root.path(), "/a"), None);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const GIB: u64 = 1 << 30;
+
+    #[test]
+    fn plentiful_memory_keeps_the_cpu_default() {
+        assert_eq!(limited_jobs(16, 64 * GIB), 16);
+        assert_eq!(limited_jobs(16, 16 * GIB), 16);
+        assert_eq!(limited_jobs(1, 512 * GIB), 1);
+        assert_eq!(limited_jobs(16, u64::MAX), 16);
+    }
+
+    #[test]
+    fn tight_memory_lowers_jobs_to_whole_budgets() {
+        assert_eq!(limited_jobs(16, 4 * GIB), 4);
+        assert_eq!(limited_jobs(16, 4 * GIB + GIB - 1), 4);
+        assert_eq!(limited_jobs(16, 15 * GIB), 15);
+        assert_eq!(limited_jobs(64, 8 * GIB), 8);
+    }
+
+    #[test]
+    fn jobs_never_drop_below_one() {
+        assert_eq!(limited_jobs(16, 0), 1);
+        assert_eq!(limited_jobs(16, GIB - 1), 1);
+        assert_eq!(limited_jobs(1, 0), 1);
+    }
+
+    #[test]
+    fn the_limit_never_exceeds_the_cpu_count() {
+        for cpus in [1, 2, 7, 16, 255] {
+            for gib in [0, 1, 3, 16, 1024] {
+                assert!(limited_jobs(cpus, gib * GIB) <= cpus);
+                assert!(limited_jobs(cpus, gib * GIB) >= 1);
+            }
+        }
+    }
+}
