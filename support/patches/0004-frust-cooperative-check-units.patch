diff --git a/src/compiler/fingerprint/join.rs b/src/compiler/fingerprint/join.rs
new file mode 100644
index 0000000..43fb09c
--- /dev/null
+++ b/src/compiler/fingerprint/join.rs
@@ -0,0 +1,211 @@
+//! Re-reads a unit's on-disk record after another Cargo process may have built it.
+//!
+//! A [`JoinProbe`] answers the question [`prepare_target`] answered at plan
+//! time, but from the filesystem as it is now and from a job thread. It accepts
+//! a unit only when the record would also be fresh for a new invocation.
+//!
+//! [`prepare_target`]: super::prepare_target
+
+use std::ffi::{OsStr, OsString};
+use std::path::PathBuf;
+#[cfg(unix)]
+use std::os::unix::fs::MetadataExt;
+use std::sync::Arc;
+
+use cargo_util::paths;
+use filetime::FileTime;
+
+use super::BuildRunner;
+use super::Fingerprint;
+use super::LocalFingerprint;
+use super::Unit;
+use super::find_stale_file;
+use super::parse_dep_info;
+use crate::CARGO_ENV;
+use crate::context::FingerprintMethod;
+use crate::util;
+use crate::util::data_structures::HashMap;
+use crate::util::errors::CargoResult;
+use crate::workspace::manifest::ManifestMetadata;
+
+/// Everything needed to re-check one unit, owned so a job thread can hold it.
+pub(crate) struct JoinProbe {
+    fingerprint: Arc<Fingerprint>,
+    hash_path: PathBuf,
+    pkg_root: PathBuf,
+    metadata: ManifestMetadata,
+    build_root: PathBuf,
+    cargo_exe: PathBuf,
+    env_config: Arc<HashMap<String, OsString>>,
+    env: HashMap<String, String>,
+}
+
+impl JoinProbe {
+    /// Captures the planned fingerprint of `unit` after [`prepare_target`] ran.
+    ///
+    /// Returns `None` when the unit has no dep-info record to re-check, so the
+    /// caller keeps the normal build path.
+    ///
+    /// [`prepare_target`]: super::prepare_target
+    pub(crate) fn new(
+        build_runner: &BuildRunner<'_, '_>,
+        unit: &Unit,
+    ) -> CargoResult<Option<JoinProbe>> {
+        let Some(fingerprint) = build_runner.fingerprints.get(unit).cloned() else {
+            return Ok(None);
+        };
+        let rechecked = {
+            let local = fingerprint.local.lock().unwrap();
+            !local.is_empty()
+                && local
+                    .iter()
+                    .all(|l| matches!(l, LocalFingerprint::CheckDepInfo { .. }))
+        };
+        if !rechecked || fingerprint.outputs.is_empty() {
+            return Ok(None);
+        }
+        let gctx = build_runner.bcx.gctx;
+        Ok(Some(JoinProbe {
+            fingerprint,
+            hash_path: build_runner.files().fingerprint_file_path(unit, ""),
+            pkg_root: unit.pkg.root().to_path_buf(),
+            metadata: unit.pkg.manifest().metadata().clone(),
+            build_root: super::build_root(build_runner),
+            cargo_exe: gctx.cargo_exe()?.to_path_buf(),
+            env_config: Arc::clone(gctx.env_config()?),
+            env: gctx
+                .env()
+                .map(|(k, v)| (k.to_owned(), v.to_owned()))
+                .collect(),
+        }))
+    }
+
+    /// Whether the record on disk is complete and fresh right now.
+    ///
+    /// Any error or doubt reports `false`, which makes the caller build.
+    pub(crate) fn is_current(&self) -> bool {
+        self.check().unwrap_or(false)
+    }
+
+    fn check(&self) -> CargoResult<bool> {
+        let fingerprint = &*self.fingerprint;
+
+        // The hash file is emptied before a rebuild and written after the
+        // outputs, so a match means a producer finished this exact identity.
+        let Ok(recorded) = paths::read(&self.hash_path) else {
+            return Ok(false);
+        };
+        if recorded != util::to_hex(fingerprint.hash_u64()) {
+            return Ok(false);
+        }
+
+        let mut own_mtime: Option<FileTime> = None;
+        for output in &fingerprint.outputs {
+            let Ok(mtime) = paths::mtime(output) else {
+                return Ok(false);
+            };
+            own_mtime = own_mtime.max(Some(mtime));
+        }
+        let Some(own_mtime) = own_mtime else {
+            return Ok(false);
+        };
+
+        // Read dependency outputs again: a dependency another process rebuilt
+        // after this unit was planned must not predate this unit's outputs.
+        for dep in &fingerprint.deps {
+            let mut dep_mtime: Option<FileTime> = None;
+            for output in &dep.fingerprint.outputs {
+                if dep.only_requires_rmeta && output.extension() != Some(OsStr::new("rmeta")) {
+                    continue;
+                }
+                let Ok(mtime) = paths::mtime(output) else {
+                    return Ok(false);
+                };
+                dep_mtime = dep_mtime.max(Some(mtime));
+            }
+            match dep_mtime {
+                Some(dep_mtime) if dep_mtime > own_mtime => return Ok(false),
+                Some(_) => {}
+                None if dep.only_requires_rmeta => return Ok(false),
+                None => {}
+            }
+        }
+
+        // Fresh caches: the planning pass may have cached older mtimes.
+        let mut mtime_cache = HashMap::default();
+        let mut checksum_cache = HashMap::default();
+        for local in fingerprint.local.lock().unwrap().iter() {
+            let LocalFingerprint::CheckDepInfo {
+                dep_info,
+                fingerprint: method,
+            } = local
+            else {
+                return Ok(false);
+            };
+            let dep_info = self.build_root.join(dep_info);
+            let Some(info) = parse_dep_info(&self.pkg_root, &self.build_root, &dep_info)? else {
+                return Ok(false);
+            };
+            #[cfg(unix)]
+            {
+                // Cargo stamps translated dep-info with the compiler invocation time.
+                // ctime also changes when a save restores the previous mtime.
+                let invocation = paths::mtime(&dep_info)?;
+                for input in info.files.keys() {
+                    let is_new = |meta: std::fs::Metadata| {
+                        FileTime::from_unix_time(meta.ctime(), meta.ctime_nsec() as u32) >= invocation
+                    };
+                    let link = std::fs::symlink_metadata(input)?;
+                    let symlink = link.is_symlink();
+                    if is_new(link) || (symlink && is_new(std::fs::metadata(input)?)) {
+                        return Ok(false);
+                    }
+                }
+            }
+            if info
+                .env
+                .iter()
+                .any(|(key, previous)| self.env_changed(key, previous))
+            {
+                return Ok(false);
+            }
+            let stale = match method {
+                FingerprintMethod::Content => find_stale_file(
+                    &mut mtime_cache,
+                    &mut checksum_cache,
+                    &dep_info,
+                    info.files.iter().map(|(file, checksum)| (file, *checksum)),
+                    *method,
+                ),
+                FingerprintMethod::Mtime => find_stale_file(
+                    &mut mtime_cache,
+                    &mut checksum_cache,
+                    &dep_info,
+                    info.files.into_keys().map(|path| (path, None)),
+                    *method,
+                ),
+            };
+            if stale.is_some() {
+                return Ok(false);
+            }
+        }
+        Ok(true)
+    }
+
+    /// Mirrors the environment check of `LocalFingerprint::find_stale_item`.
+    fn env_changed(&self, key: &str, previous: &Option<String>) -> bool {
+        if let Some(value) = self.metadata.env_var(key) {
+            if Some(value.as_ref()) == previous.as_deref() {
+                return false;
+            }
+        }
+        let current = if key == CARGO_ENV {
+            self.cargo_exe.to_str()
+        } else if let Some(value) = self.env_config.get(key) {
+            value.to_str()
+        } else {
+            self.env.get(key).map(String::as_str)
+        };
+        current != previous.as_deref()
+    }
+}
