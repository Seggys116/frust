--- /dev/null
+++ b/src/compiler/unit_join.rs
@@ -0,0 +1,77 @@
+//! Opt-in joining of equivalent units between Cargo processes sharing a build directory.
+//!
+//! An eligible `cargo check` defers contended units and replays the producer's
+//! outputs when its completed fingerprint is fresh for this invocation.
+//!
+//! Checks with build scripts use the normal path.
+
+use super::build_context::BuildContext;
+use super::locking::{LockKey, LockManager};
+use super::{CompileMode, UserIntent};
+use crate::compiler::fingerprint::JoinProbe;
+use crate::util::errors::CargoResult;
+
+/// A cooperative check must release its reader locks before making progress.
+#[derive(Debug, thiserror::Error)]
+#[error("cooperative check stalled while retaining unit locks")]
+pub(crate) struct RetrySerial;
+
+/// Whether this process may join units built by another Cargo process.
+pub(super) fn supports(bcx: &BuildContext<'_, '_>) -> bool {
+    let gctx = bcx.gctx;
+    let enabled = match gctx.get_env("FRUST_UNIT_JOIN").as_deref() {
+        Ok("off") => false,
+        _ => match gctx.get_env("FRUST_EXPERIMENTAL_UNIT_JOIN").as_deref() {
+            Ok("0") => false,
+            Ok("1") => cfg!(unix),
+            _ => cfg!(all(target_os = "linux", target_arch = "x86_64", target_env = "gnu"))
+                && gctx.get_env("FRUST_INVOCATION").ok() == Some("fcargo"),
+        },
+    };
+    enabled
+        && !bcx.ws.build_dir().as_path_unlocked().ancestors()
+            .any(crate::util::flock::is_on_nfs_mount)
+        && matches!(bcx.build_config.intent, UserIntent::Check { .. })
+        && !bcx.build_config.timing_report
+        && !bcx.build_config.keep_going
+        && !bcx.build_config.force_rebuild
+        && !bcx.gctx.cli_unstable().fine_grain_locking
+        && bcx.gctx.cli_unstable().build_dir_new_layout
+        && bcx.gctx.jobserver_from_env().is_none()
+        && bcx.unit_graph.keys().all(|unit| {
+            matches!(unit.mode, CompileMode::Check { .. }) && !unit.artifact.is_true()
+        })
+}
+
+pub(super) enum Readiness {
+    Waiting,
+    Reuse,
+    Build,
+}
+
+pub(super) struct UnitJoin {
+    pub lock: LockKey,
+    pub probe: JoinProbe,
+}
+
+impl UnitJoin {
+    /// Checks a ready unit with nonblocking locks, before it consumes a job slot.
+    pub fn readiness(&self, locks: &LockManager) -> CargoResult<Readiness> {
+        if !locks.try_lock_shared(&self.lock)? {
+            return Ok(Readiness::Waiting);
+        }
+        if self.probe.is_current() {
+            return Ok(Readiness::Reuse);
+        }
+        locks.unlock(&self.lock)?;
+        if !locks.try_lock_exclusive(&self.lock)? {
+            return Ok(Readiness::Waiting);
+        }
+        if self.probe.is_current() {
+            locks.downgrade_to_shared(&self.lock)?;
+            Ok(Readiness::Reuse)
+        } else {
+            Ok(Readiness::Build)
+        }
+    }
+}
