+/// A host library or proc macro that a check builds in full, such as a proc macro and the
+/// libraries it links.
+///
+/// Cargo promotes a build's binaries, dylibs, requested roots and build-script programs out
+/// of the unit directory and exports them on request. Only an rlib or proc-macro unit that
+/// is not a root keeps all of its outputs in the managed unit directory, which the unit lock
+/// covers. Build-script programs, their run units and standard-library units never qualify, so
+/// a graph that holds one uses the normal path.
+fn is_unit_local_host_build(bcx: &BuildContext<'_, '_>, unit: &Unit) -> bool {
+    unit.mode == CompileMode::Build
+        && unit.kind.is_host()
+        && !unit.is_std
+        && !bcx.roots.contains(unit)
+        && match unit.target.kind() {
+            TargetKind::Lib(types) => types
+                .iter()
+                .all(|ty| matches!(ty, CrateType::Lib | CrateType::Rlib | CrateType::ProcMacro)),
+            _ => false,
+        }
+}
