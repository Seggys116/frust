+#[cfg(target_os = "macos")]
+fn supports_mount(path: &std::path::Path) -> bool {
+    use std::ffi::CString;
+    use std::mem::MaybeUninit;
+    use std::os::unix::ffi::OsStrExt;
+
+    // A new build directory may not exist. Query the nearest existing ancestor's mount.
+    for path in path.ancestors() {
+        let Ok(path) = CString::new(path.as_os_str().as_bytes()) else { return false };
+        let mut stat = MaybeUninit::<libc::statfs>::uninit();
+        // SAFETY: statfs initializes the structure on success, and path is NUL terminated.
+        if unsafe { libc::statfs(path.as_ptr(), stat.as_mut_ptr()) } == 0 {
+            // SAFETY: statfs returned success.
+            let stat = unsafe { stat.assume_init() };
+            return stat.f_flags & libc::MNT_LOCAL as u32 != 0;
+        }
+        if std::io::Error::last_os_error().kind() != std::io::ErrorKind::NotFound {
+            return false;
+        }
+    }
+    false
+}
