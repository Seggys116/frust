+//! Shared content-addressed store of finished rustc outputs for registry and git units.
+//!
+//! `UnitCache::lookup` runs inside Cargo's `rustc()` work closure right before rustc would be
+//! spawned and `UnitCache::store` runs after a clean compile. Any doubt is a miss, and a miss
+//! compiles exactly as Cargo does without the cache.
+
+// The cache is configured by process environment, as the other fRust modules do.
+#![allow(clippy::disallowed_methods)]
+
+use std::collections::BTreeMap;
+use std::ffi::{OsStr, OsString};
+use std::fs::{self, File, OpenOptions, TryLockError};
+use std::io::{self, Read, Write};
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, LazyLock, Mutex, OnceLock};
+use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
+
+use cargo_util::ProcessBuilder;
+use filetime::FileTime;
+use portable_atomic::AtomicU64;
+use serde::{Deserialize, Serialize};
+
+use crate::compiler::build_runner::OutputFile;
+use crate::compiler::{
+    BuildContext, BuildRunner, CompileKind, CompileMode, CrateType, FileFlavor, Unit,
+};
+use crate::frust_paths::{self, CacheOpen, HostOs};
+use crate::util::data_structures::{HashMap, HashSet};
+use crate::util::flock;
+use crate::workspace::{SourceKind, TargetKind};
+
+// Build script run cache. A child module so it shares this module's private store primitives.
+#[path = "frust_script_cache.rs"]
+pub(crate) mod script_cache;
+
+const SCHEMA: &str = "frust-unit-cache-v1";
+const MANIFEST_SCHEMA: u32 = 1;
+const MANIFEST: &str = "entry.json";
+const OUT_TOKEN: &str = "@FRUST_OUT@";
+const BUILD_TOKEN: &str = "@FRUST_BUILD@";
+const DEFAULT_BUDGET: u64 = 8 << 30;
+const EVICT_TO_PERCENT: u128 = 80;
+const GARBAGE_AGE: Duration = Duration::from_secs(60 * 60);
+const COUNTER_MAX_AGE: Duration = Duration::from_secs(24 * 60 * 60);
+const COPY_BUF: usize = 256 * 1024;
+/// Streaming buffer for hashing and copying files in one pass.
+const HASH_BUF: usize = 1024 * 1024;
+
+/// Set by Cargo or build scripts but never part of what rustc output depends on.
+const ENV_EXCLUDED: &[&str] =
+    &["CARGO", "CARGO_MAKEFLAGS", "MAKEFLAGS", "LD_LIBRARY_PATH", "CARGO_TARGET_TMPDIR"];
+/// Inherited variables that rustc or the code it compiles can observe.
+const ENV_INHERITED: &[&str] = &[
+    "RUSTC_BOOTSTRAP",
+    "RUSTC_LOG",
+    "RUSTFLAGS",
+    "CARGO_ENCODED_RUSTFLAGS",
+    "SOURCE_DATE_EPOCH",
+    "TMPDIR",
+];
+
+static NEXT_TEMP: AtomicU64 = AtomicU64::new(0);
+static SHARED: OnceLock<Option<Arc<Store>>> = OnceLock::new();
+static TOOLCHAINS: LazyLock<Mutex<HashMap<String, String>>> = LazyLock::new(Default::default);
+static FILE_HASHES: LazyLock<Mutex<HashMap<PathBuf, (u64, SystemTime, [u8; 32])>>> =
+    LazyLock::new(Default::default);
+/// Set once when `FRUST_UNIT_CACHE_DEBUG=1` opens the store; gates every statistics update.
+static STATS_ON: AtomicBool = AtomicBool::new(false);
+static STATS: LazyLock<Stats> = LazyLock::new(Stats::default);
+
+/// Per-process wall time (ns) and byte totals, reported under `FRUST_UNIT_CACHE_DEBUG=1`.
+/// `key` includes `extern` and `native` hashing, which are also reported on their own.
+#[derive(Default)]
+struct Stats {
+    key_ns: AtomicU64,
+    extern_ns: AtomicU64,
+    native_ns: AtomicU64,
+    store_hash_ns: AtomicU64,
+    store_write_ns: AtomicU64,
+    store_manifest_ns: AtomicU64,
+    miss_ns: AtomicU64,
+    restore_ns: AtomicU64,
+    hashed_bytes: AtomicU64,
+    written_bytes: AtomicU64,
+}
+
+impl Stats {
+    fn line(&self) -> String {
+        let ms = |counter: &AtomicU64| counter.load(Ordering::Relaxed) / 1_000_000;
+        let mib = |counter: &AtomicU64| counter.load(Ordering::Relaxed) as f64 / (1024.0 * 1024.0);
+        format!(
+            "stats key={} extern_hash={} store_hash={} store_write={} restore={} hashed={:.1} \
+             written={:.1} native_hash={} store_manifest={} miss={}",
+            ms(&self.key_ns),
+            ms(&self.extern_ns),
+            ms(&self.store_hash_ns),
+            ms(&self.store_write_ns),
+            ms(&self.restore_ns),
+            mib(&self.hashed_bytes),
+            mib(&self.written_bytes),
+            ms(&self.native_ns),
+            ms(&self.store_manifest_ns),
+            ms(&self.miss_ns),
+        )
+    }
+}
+
+/// A start time, only when statistics are on, so the disabled path costs one relaxed load.
+fn stat_start() -> Option<Instant> {
+    STATS_ON.load(Ordering::Relaxed).then(Instant::now)
+}
+
+fn stat_add(counter: &AtomicU64, started: Option<Instant>) {
+    if let Some(started) = started {
+        counter.fetch_add(started.elapsed().as_nanos() as u64, Ordering::Relaxed);
+    }
+}
+
+fn stat_bytes(counter: &AtomicU64, bytes: u64) {
+    if STATS_ON.load(Ordering::Relaxed) {
+        counter.fetch_add(bytes, Ordering::Relaxed);
+    }
+}
+
+#[derive(Serialize, Deserialize, Clone, Debug, PartialEq)]
+struct Blob {
+    name: String,
+    size: u64,
+    blake3: String,
+}
+
+#[derive(Serialize, Deserialize, Clone, Debug, PartialEq)]
+struct EnvDep {
+    name: String,
+    value: Option<String>,
+}
+
+#[derive(Serialize, Deserialize, Clone, Debug, PartialEq)]
+struct FileDep {
+    path: String,
+    blake3: String,
+}
+
+#[derive(Serialize, Deserialize, Clone, Debug, PartialEq)]
+struct Entry {
+    schema: u32,
+    /// Entries written before build script entries existed carry no kind and are unit entries.
+    #[serde(default = "unit_kind")]
+    kind: String,
+    key: String,
+    toolchain_id: String,
+    outputs: Vec<Blob>,
+    dep_info: Blob,
+    /// Cargo's message-cache lines (only `unused_extern_names` reports); empty when none.
+    messages: Blob,
+    env_deps: Vec<EnvDep>,
+    file_deps: Vec<FileDep>,
+    bound_dir: Option<String>,
+    created_unix: u64,
+}
+
+/// The only compiler message a unit may print and still be cached.
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+#[allow(dead_code)] // parsed only to validate the line shape
+struct UnusedExterns {
+    #[serde(rename = "$message_type")]
+    message_type: Option<String>,
+    unused_extern_names: Vec<String>,
+    lint_level: Option<String>,
+}
+
+/// Facts learned from the rustc dep-info that a later lookup must re-verify.
+#[derive(Default, Debug)]
+struct Recorded {
+    env_deps: Vec<EnvDep>,
+    file_deps: Vec<FileDep>,
+    bound_dir: Option<String>,
+}
+
+#[derive(Debug)]
+pub(crate) enum Lookup {
+    /// Outputs and dep-info were restored; `rmeta` tells whether an `.rmeta` was among them.
+    /// `messages` are the compiler lines to replay as if rustc had printed them.
+    Hit { rmeta: bool, messages: Vec<String> },
+    /// Run rustc, then hand the pending key to `UnitCache::store` if the build was clean.
+    Miss(Pending),
+    /// Not cacheable for this invocation.
+    Skip,
+}
+
+#[derive(Debug)]
+pub(crate) struct Pending {
+    key: String,
+    /// When the miss was decided; optional outputs older than this were not made by this compile.
+    started: SystemTime,
+}
+
+struct Restored {
+    rmeta: bool,
+    messages: Vec<String>,
+}
+
+enum StoreFail {
+    /// rustc printed something other than an unused-externs report.
+    Noisy,
+    Io(io::Error),
+}
+
+impl From<io::Error> for StoreFail {
+    fn from(err: io::Error) -> StoreFail {
+        StoreFail::Io(err)
+    }
+}
+
+#[derive(Debug)]
+enum Fail {
+    Reason(&'static str),
+    /// The entry is damaged and should be removed.
+    Corrupt(&'static str),
+}
+
+#[derive(Clone, Debug)]
+struct ToolchainInputs {
+    verbose_version: String,
+    sysroot: PathBuf,
+    lib_dirs: Vec<PathBuf>,
+}
+
+pub(crate) struct UnitCache {
+    store: Arc<Store>,
+    crate_name: String,
+    package: String,
+    pkg_root: PathBuf,
+    pkg_root_canonical: Option<PathBuf>,
+    build_dir: PathBuf,
+    build_paths: Vec<PathBuf>,
+    dirs: Vec<Vec<u8>>,
+    out_dir: PathBuf,
+    cwd: PathBuf,
+    /// Files every compile must leave in `out_dir`.
+    outputs: Vec<PathBuf>,
+    /// Files rustc may or may not emit (split debuginfo); restored only if stored.
+    optional_outputs: Vec<PathBuf>,
+    dep_info: PathBuf,
+    /// Cargo's per-unit message cache file, written while rustc output is processed.
+    messages: PathBuf,
+    toolchain: ToolchainInputs,
+}
+
+impl UnitCache {
+    /// Returns `None` when the cache is disabled or the unit is not eligible.
+    pub(crate) fn for_unit(
+        build_runner: &BuildRunner<'_, '_>,
+        unit: &Unit,
+        outputs: &[OutputFile],
+        out_dir: &Path,
+        dep_info: &Path,
+        message_cache: &Path,
+        rustc: &ProcessBuilder,
+    ) -> Option<UnitCache> {
+        let store = shared_store()?;
+        let crate_name = unit.target.crate_name();
+        let skip = |reason: &str| -> Option<UnitCache> {
+            store.log(format_args!("skip {crate_name} {reason}"));
+            None
+        };
+        let bcx = build_runner.bcx;
+        if unit.is_std {
+            return skip("build-std");
+        }
+        if unit.is_local() {
+            return skip("local-package");
+        }
+        if !matches!(unit.mode, CompileMode::Build | CompileMode::Check { test: false }) {
+            return skip("mode");
+        }
+        match unit.target.kind() {
+            TargetKind::Lib(kinds) if eligible_crate_types(kinds) => {}
+            _ => return skip("target-kind"),
+        }
+        if unit.artifact.is_true() {
+            return skip("artifact");
+        }
+        if unit.profile.incremental {
+            return skip("incremental");
+        }
+        let tool = bcx.rustc();
+        if tool.wrapper.is_some() || tool.workspace_wrapper.is_some() || wrapper_env_set() {
+            return skip("wrapper");
+        }
+        let Some((required, optional)) = cacheable_outputs(outputs, out_dir) else {
+            return skip("outputs");
+        };
+        if dep_info.parent() != Some(out_dir) {
+            return skip("outputs");
+        }
+        if out_dir.to_str().is_none() {
+            return skip("out-dir-not-utf8");
+        }
+
+        let build_dir = bcx.ws.build_dir().into_path_unlocked();
+        let mut build_paths = vec![build_dir.clone()];
+        let target_dir = bcx.ws.target_dir().into_path_unlocked();
+        if target_dir != build_dir {
+            build_paths.push(target_dir);
+        }
+        let package = match package_key(unit) {
+            Ok(package) => package,
+            Err(reason) => return skip(reason),
+        };
+        let pkg_root = unit.pkg.root().to_path_buf();
+        Some(UnitCache {
+            store: Arc::clone(&store),
+            crate_name: crate_name.clone(),
+            package,
+            pkg_root_canonical: fs::canonicalize(&pkg_root).ok(),
+            pkg_root,
+            dirs: norm_dirs(&build_paths),
+            build_dir,
+            build_paths,
+            out_dir: out_dir.to_path_buf(),
+            cwd: rustc.get_cwd().unwrap_or_else(|| bcx.gctx.cwd()).to_path_buf(),
+            outputs: required,
+            optional_outputs: optional,
+            dep_info: dep_info.to_path_buf(),
+            messages: message_cache.to_path_buf(),
+            toolchain: toolchain_inputs(bcx, unit.kind),
+        })
+    }
+
+    /// Restores a verified entry in place of running `rustc`, or reports why that was not possible.
+    ///
+    /// Restored files are stamped `stamp`, the unit's own invocation timestamp taken before this
+    /// call. Cargo's stamps come from the kernel's coarse clock, so a fine-grained "now" could be
+    /// newer than a dependent's stamp although the file was written earlier, and Cargo would
+    /// then call the dependent stale forever. Equal mtimes count as fresh in Cargo's checks.
+    pub(crate) fn lookup_at(&self, rustc: &ProcessBuilder, stamp: FileTime) -> Lookup {
+        let timer = stat_start();
+        let key = self.compute_key(rustc);
+        stat_add(&STATS.key_ns, timer);
+        let key = match key {
+            Ok(key) => key,
+            Err(reason) => {
+                self.store.log(format_args!("skip {} {reason}", self.crate_name));
+                self.store.print_stats();
+                return Lookup::Skip;
+            }
+        };
+        let timer = stat_start();
+        match self.try_restore_at(&key, rustc, stamp) {
+            Ok(restored) => {
+                stat_add(&STATS.restore_ns, timer);
+                self.store.log(format_args!("hit {} {}", short(&key), self.crate_name));
+                self.store.print_stats();
+                Lookup::Hit { rmeta: restored.rmeta, messages: restored.messages }
+            }
+            Err(fail) => {
+                stat_add(&STATS.miss_ns, timer);
+                let reason = match fail {
+                    Fail::Reason(reason) => reason,
+                    Fail::Corrupt(reason) => {
+                        self.store.remove_entry(&key);
+                        reason
+                    }
+                };
+                self.store.log(format_args!("miss {} {} {reason}", short(&key), self.crate_name));
+                // rustc would open a leftover split-debuginfo file for write and truncate it.
+                for path in &self.optional_outputs {
+                    let _ = fs::remove_file(path);
+                }
+                Lookup::Miss(Pending { key, started: SystemTime::now() })
+            }
+        }
+    }
+
+    /// Tests that do not care about mtimes restore as of now.
+    #[cfg(test)]
+    fn lookup(&self, rustc: &ProcessBuilder) -> Lookup {
+        self.lookup_at(rustc, FileTime::now())
+    }
+
+    #[cfg(test)]
+    fn try_restore(&self, key: &str, rustc: &ProcessBuilder) -> Result<Restored, Fail> {
+        self.try_restore_at(key, rustc, FileTime::now())
+    }
+
+    /// Best effort: failures are logged at debug level and never fail the build.
+    pub(crate) fn store(&self, pending: &Pending) {
+        match self.try_store(pending) {
+            Ok(()) => {}
+            Err(StoreFail::Noisy) => {
+                self.store.log(format_args!("skip {} diagnostics", self.crate_name));
+            }
+            Err(StoreFail::Io(err)) => {
+                tracing::debug!("fRust unit cache could not store {}: {err}", self.crate_name);
+                self.store.log(format_args!("skip {} store-failed: {err}", self.crate_name));
+            }
+        }
+        self.store.print_stats();
+    }
+
+    /// Reports that a finished compile was not stored because it printed diagnostics.
+    pub(crate) fn note_noisy(&self) {
+        self.store.log(format_args!("skip {} diagnostics", self.crate_name));
+        self.store.print_stats();
+    }
+
+    fn try_store(&self, pending: &Pending) -> Result<(), StoreFail> {
+        let messages = match fs::read(&self.messages) {
+            Ok(bytes) => bytes,
+            Err(err) if err.kind() == io::ErrorKind::NotFound => Vec::new(),
+            Err(err) => return Err(err.into()),
+        };
+        if clean_messages(&messages).is_none() {
+            return Err(StoreFail::Noisy);
+        }
+        let dep_text = fs::read_to_string(&self.dep_info)?;
+        let depinfo = crate::compiler::fingerprint::parse_rustc_dep_info(&self.dep_info)
+            .map_err(|err| io::Error::other(format!("{err:#}")))?;
+        let files: Vec<PathBuf> = depinfo.files.keys().cloned().collect();
+        let recorded = self.record_deps(&files, &depinfo.env).map_err(io::Error::other)?;
+        let mut outputs = Vec::with_capacity(self.outputs.len() + self.optional_outputs.len());
+        for (path, optional) in self
+            .outputs
+            .iter()
+            .map(|path| (path, false))
+            .chain(self.optional_outputs.iter().map(|path| (path, true)))
+        {
+            let name = file_name(path).ok_or_else(|| io::Error::other("output name"))?;
+            match fs::metadata(path) {
+                Ok(meta) if meta.is_file() && optional && !made_since(&meta, pending.started) => {}
+                Ok(meta) if meta.is_file() => outputs.push((name.to_string(), path.clone())),
+                Ok(_) => return Err(io::Error::other("output is not a file").into()),
+                Err(err) if optional && err.kind() == io::ErrorKind::NotFound => {}
+                Err(err) => return Err(err.into()),
+            }
+        }
+        let dep_name = file_name(&self.dep_info).ok_or_else(|| io::Error::other("dep-info name"))?;
+        let normalized = normalize_dep_info(&dep_text, &self.out_dir).map_err(io::Error::other)?;
+        let toolchain = toolchain_id(&self.toolchain);
+        let dep_info = (dep_name.to_string(), normalized.into_bytes());
+        if let Some(bytes) = self.store.write_entry(
+            &pending.key,
+            &toolchain,
+            &outputs,
+            dep_info,
+            messages,
+            recorded,
+        )? {
+            self.store.log(format_args!("store {} {}", short(&pending.key), self.crate_name));
+            self.store.note_stored(bytes);
+        }
+        Ok(())
+    }
+
+    fn compute_key(&self, rustc: &ProcessBuilder) -> Result<String, &'static str> {
+        let args: Vec<&OsStr> = rustc.get_args().map(|arg| arg.as_os_str()).collect();
+        let normalized = normalize_args(&args, &self.dirs, &self.build_paths, &self.cwd)?;
+        let mut hasher = KeyHasher::new();
+        hasher.field("schema", SCHEMA.as_bytes());
+        hasher.field("toolchain", toolchain_id(&self.toolchain).as_bytes());
+        hasher.field("package", self.package.as_bytes());
+        hasher.field("argc", &(normalized.args.len() as u64).to_le_bytes());
+        for arg in &normalized.args {
+            hasher.field("arg", arg);
+        }
+        hasher.field("native-libs", &normalized.native_libs);
+        for (name, value) in self.environment(rustc) {
+            let mut data = name.into_bytes();
+            data.push(0);
+            match value {
+                Some(value) => {
+                    data.push(1);
+                    data.extend(value);
+                }
+                None => data.push(0),
+            }
+            hasher.field("env", &data);
+        }
+        // The compilation directory only reaches the output through debuginfo.
+        hasher.field("debuginfo", &[normalized.debuginfo as u8]);
+        if normalized.debuginfo {
+            hasher.field("cwd", self.cwd.as_os_str().as_encoded_bytes());
+        }
+        Ok(hasher.finish())
+    }
+
+    fn environment(&self, rustc: &ProcessBuilder) -> BTreeMap<String, Option<Vec<u8>>> {
+        let normalize = |value: &OsStr| {
+            replace_dirs(value.as_encoded_bytes(), &self.dirs, BUILD_TOKEN.as_bytes())
+        };
+        let mut env = BTreeMap::new();
+        for (name, value) in rustc.get_envs() {
+            if !env_excluded(name) {
+                env.insert(name.clone(), value.as_deref().map(&normalize));
+            }
+        }
+        for name in ENV_INHERITED {
+            if !env.contains_key(*name) {
+                env.insert(name.to_string(), rustc.get_env(name).map(|value| normalize(&value)));
+            }
+        }
+        env
+    }
+
+    fn try_restore_at(
+        &self,
+        key: &str,
+        rustc: &ProcessBuilder,
+        stamp: FileTime,
+    ) -> Result<Restored, Fail> {
+        let entry_dir = self.store.entry_dir(key);
+        let manifest_path = entry_dir.join(MANIFEST);
+        if !manifest_path.is_file() {
+            return Err(Fail::Reason("no-entry"));
+        }
+        // Held until the end of this function so GC cannot remove the entry mid-restore. A store
+        // that cannot hold a lock file (read-only) has no writers or GC of ours; a racing remover
+        // elsewhere can only make the restore fail, which falls back to compiling.
+        let _lock = match try_lock(&self.store.lock_path(key), LockMode::Shared) {
+            Ok(Some(lock)) => Some(lock),
+            Ok(None) => return Err(Fail::Reason("locked")),
+            Err(_) => None,
+        };
+        let bytes = fs::read(&manifest_path).map_err(|_| Fail::Reason("no-entry"))?;
+        let entry: Entry =
+            serde_json::from_slice(&bytes).map_err(|_| Fail::Corrupt("manifest-unparsable"))?;
+        if entry.schema != MANIFEST_SCHEMA || entry.key != key || !entry_names_valid(&entry) {
+            return Err(Fail::Corrupt("manifest-invalid"));
+        }
+        if let Some(bound) = &entry.bound_dir {
+            if self.build_dir.to_str() != Some(bound.as_str()) {
+                return Err(Fail::Reason("bound-dir"));
+            }
+        }
+        if !verify_env_deps(&entry.env_deps, |name| rustc.get_env(name)) {
+            return Err(Fail::Reason("env-dep"));
+        }
+        if !verify_file_deps(&entry.file_deps) {
+            return Err(Fail::Reason("file-dep"));
+        }
+        let blobs = self.blobs_for_outputs(&entry).ok_or(Fail::Reason("output-set"))?;
+        verify_blobs(&entry_dir, &entry)?;
+        let messages = fs::read(entry_dir.join(&entry.messages.blake3))
+            .ok()
+            .and_then(|bytes| clean_messages(&bytes))
+            .ok_or(Fail::Corrupt("messages-invalid"))?;
+        let rmeta = self.restore(&entry_dir, &entry, &blobs, stamp)?;
+        Ok(Restored { rmeta, messages })
+    }
+
+    /// Pairs each output path with its stored blob. Required outputs must be present, optional
+    /// ones only if stored, and the entry must hold nothing else.
+    fn blobs_for_outputs<'a>(&self, entry: &'a Entry) -> Option<Vec<(&PathBuf, &'a Blob)>> {
+        let find = |path: &PathBuf| {
+            let name = file_name(path)?;
+            entry.outputs.iter().find(|blob| blob.name == name)
+        };
+        let mut matched = Vec::with_capacity(entry.outputs.len());
+        for path in &self.outputs {
+            matched.push((path, find(path)?));
+        }
+        for path in &self.optional_outputs {
+            if let Some(blob) = find(path) {
+                matched.push((path, blob));
+            }
+        }
+        (matched.len() == entry.outputs.len()).then_some(matched)
+    }
+
+    /// All files are staged next to their destinations first so a failure never leaves a
+    /// half-restored set behind.
+    fn restore(
+        &self,
+        entry_dir: &Path,
+        entry: &Entry,
+        blobs: &[(&PathBuf, &Blob)],
+        stamp: FileTime,
+    ) -> Result<bool, Fail> {
+        let mut staged: Vec<(PathBuf, PathBuf)> = Vec::new();
+        if self.stage(entry_dir, entry, blobs, stamp, &mut staged).is_err() {
+            for (temp, _) in &staged {
+                let _ = fs::remove_file(temp);
+            }
+            return Err(Fail::Reason("restore-failed"));
+        }
+        for (index, (temp, dest)) in staged.iter().enumerate() {
+            if fs::rename(temp, dest).is_err() {
+                for (temp, _) in &staged[index..] {
+                    let _ = fs::remove_file(temp);
+                }
+                for (_, dest) in &staged[..index] {
+                    let _ = fs::remove_file(dest);
+                }
+                return Err(Fail::Reason("restore-failed"));
+            }
+        }
+        // Dependents will hash these files as `--extern` inputs; the verified blob hash is
+        // already known for the files as they now stand.
+        for (path, blob) in blobs {
+            remember_written_hash(path, &blob.blake3);
+        }
+        // GC recency lives on the manifest, which is never exposed outside the store.
+        let _ = filetime::set_file_mtime(entry_dir.join(MANIFEST), FileTime::now());
+        Ok(blobs.iter().any(|(path, _)| path.extension() == Some(OsStr::new("rmeta"))))
+    }
+
+    fn stage(
+        &self,
+        entry_dir: &Path,
+        entry: &Entry,
+        blobs: &[(&PathBuf, &Blob)],
+        stamp: FileTime,
+        staged: &mut Vec<(PathBuf, PathBuf)>,
+    ) -> io::Result<()> {
+        fs::create_dir_all(&self.out_dir)?;
+        for (dest, blob) in blobs {
+            let temp = restore_temp(dest);
+            staged.push((temp.clone(), (*dest).clone()));
+            clone_or_copy(&entry_dir.join(&blob.blake3), &temp, &blob.blake3, stamp)?;
+        }
+        let text = fs::read_to_string(entry_dir.join(&entry.dep_info.blake3))?;
+        let out_dir = self.out_dir.to_str().ok_or_else(|| io::Error::other("out dir"))?;
+        let temp = restore_temp(&self.dep_info);
+        staged.push((temp.clone(), self.dep_info.clone()));
+        fs::write(&temp, text.replace(OUT_TOKEN, out_dir))?;
+        filetime::set_file_mtime(&temp, stamp)
+    }
+
+    fn record_deps(
+        &self,
+        files: &[PathBuf],
+        env: &[(String, Option<String>)],
+    ) -> Result<Recorded, &'static str> {
+        let build_texts: Vec<&str> = self.build_paths.iter().filter_map(|p| p.to_str()).collect();
+        let mut recorded = Recorded::default();
+        let mut bound = false;
+        for file in files {
+            let abs = if file.is_absolute() { file.clone() } else { self.cwd.join(file) };
+            if self.in_package(&abs) {
+                continue;
+            }
+            let text = abs.to_str().ok_or("dep-not-utf8")?;
+            let (_, hash) = hash_file(&abs).map_err(|_| "dep-unreadable")?;
+            bound |= self.build_paths.iter().any(|dir| abs.starts_with(dir));
+            recorded.file_deps.push(FileDep { path: text.to_string(), blake3: hex(&hash) });
+        }
+        recorded.file_deps.sort_by(|a, b| a.path.cmp(&b.path));
+        recorded.file_deps.dedup_by(|a, b| a.path == b.path);
+        let mut by_name: BTreeMap<&str, &Option<String>> = BTreeMap::new();
+        for (name, value) in env {
+            by_name.insert(name, value);
+            if let Some(value) = value {
+                bound |= build_texts.iter().any(|dir| value.contains(dir));
+            }
+        }
+        recorded.env_deps = by_name
+            .into_iter()
+            .map(|(name, value)| EnvDep { name: name.to_string(), value: value.clone() })
+            .collect();
+        if bound {
+            recorded.bound_dir = Some(self.build_dir.to_str().ok_or("build-dir-not-utf8")?.to_string());
+        }
+        Ok(recorded)
+    }
+
+    fn in_package(&self, path: &Path) -> bool {
+        path.starts_with(&self.pkg_root)
+            || match (&self.pkg_root_canonical, fs::canonicalize(path)) {
+                (Some(root), Ok(real)) => real.starts_with(root),
+                _ => false,
+            }
+    }
+}
+
+fn eligible_crate_types(kinds: &[CrateType]) -> bool {
+    !kinds.is_empty()
+        && kinds
+            .iter()
+            .all(|kind| matches!(kind, CrateType::Lib | CrateType::Rlib | CrateType::ProcMacro))
+}
+
+/// Package identity for a key: id, full source url (with git precise rev), registry checksum and
+/// the vendored-source checksum content.
+fn package_key(unit: &Unit) -> Result<String, &'static str> {
+    let id = unit.pkg.package_id();
+    let directory = matches!(id.source_id().kind(), SourceKind::Directory);
+    let vendored = vendor_checksums(unit.pkg.root(), directory)?;
+    Ok(format!(
+        "{id}\n{}\n{}\n{vendored}",
+        id.source_id().as_url(),
+        unit.pkg.summary().checksum().unwrap_or("")
+    ))
+}
+
+/// The rustc identity and sysroot library directories whose files make up the toolchain id.
+fn toolchain_inputs(bcx: &BuildContext<'_, '_>, kind: CompileKind) -> ToolchainInputs {
+    let info = bcx.target_data.info(kind);
+    let mut lib_dirs = Vec::new();
+    for dir in [
+        info.sysroot.join("lib"),
+        bcx.target_data.info(CompileKind::Host).sysroot_target_libdir.clone(),
+        info.sysroot_target_libdir.clone(),
+    ] {
+        if !lib_dirs.contains(&dir) {
+            lib_dirs.push(dir);
+        }
+    }
+    ToolchainInputs {
+        verbose_version: bcx.rustc().verbose_version.clone(),
+        sysroot: info.sysroot.clone(),
+        lib_dirs,
+    }
+}
+
+/// Content of `.cargo-checksum.json` for key purposes. Vendored (directory) sources are editable
+/// and may keep a crates.io package id, so their per-file checksums stand in for the content. A
+/// directory source, or any package that carries the file, must have a readable file with a
+/// non-empty `files` map; other sources have none and contribute nothing.
+fn vendor_checksums(pkg_root: &Path, directory_source: bool) -> Result<String, &'static str> {
+    const UNCHECKED: &str = "directory-source-unchecked";
+    let bytes = match fs::read(pkg_root.join(".cargo-checksum.json")) {
+        Ok(bytes) => bytes,
+        Err(err) if err.kind() == io::ErrorKind::NotFound && !directory_source => {
+            return Ok(String::new());
+        }
+        Err(_) => return Err(UNCHECKED),
+    };
+    let value: serde_json::Value = serde_json::from_slice(&bytes).map_err(|_| UNCHECKED)?;
+    let listed = value.get("files").and_then(|files| files.as_object()).is_some_and(|f| !f.is_empty());
+    if !listed {
+        return Err(UNCHECKED);
+    }
+    String::from_utf8(bytes).map_err(|_| UNCHECKED)
+}
+
+/// Splits a unit's outputs into `(required, optional)` files inside `out_dir`.
+///
+/// Only the `path` of each output is cached: uplift hardlinks and export copies are made by
+/// Cargo's `link_targets` after the work, and sbom or unremap files are written by Cargo before
+/// rustc would run. Debug-info companions (`.dwp`, `.dSYM`) are listed whether or not rustc
+/// emits them, so they are optional. Anything else (auxiliary or doc files) is not cacheable.
+fn cacheable_outputs(
+    outputs: &[OutputFile],
+    out_dir: &Path,
+) -> Option<(Vec<PathBuf>, Vec<PathBuf>)> {
+    let (mut required, mut optional) = (Vec::new(), Vec::new());
+    for output in outputs {
+        let target = match output.flavor {
+            FileFlavor::Normal | FileFlavor::Linkable | FileFlavor::Rmeta => &mut required,
+            FileFlavor::DebugInfo => &mut optional,
+            FileFlavor::Sbom | FileFlavor::Unremap => continue,
+            FileFlavor::Auxiliary | FileFlavor::DocParts => return None,
+        };
+        if output.path.parent() != Some(out_dir) || file_name(&output.path).is_none() {
+            return None;
+        }
+        target.push(output.path.clone());
+    }
+    (!required.is_empty()).then_some((required, optional))
+}
+
+/// Accepts the message cache only if every line is an unused-externs report; any diagnostic,
+/// future-incompat report or stray output makes the compile not cacheable.
+fn clean_messages(bytes: &[u8]) -> Option<Vec<String>> {
+    std::str::from_utf8(bytes)
+        .ok()?
+        .lines()
+        .map(|line| {
+            let parsed = serde_json::from_str::<UnusedExterns>(line).ok()?;
+            let kind_ok = parsed.message_type.as_deref().is_none_or(|kind| kind == "unused_extern");
+            kind_ok.then(|| line.to_string())
+        })
+        .collect()
+}
+
+fn entry_blobs(entry: &Entry) -> impl Iterator<Item = &Blob> {
+    entry.outputs.iter().chain([&entry.dep_info, &entry.messages])
+}
+
+/// Whether a file was written at or after `started`, allowing for coarse filesystem timestamps.
+fn made_since(meta: &fs::Metadata, started: SystemTime) -> bool {
+    const SLACK: Duration = Duration::from_secs(2);
+    meta.modified().is_ok_and(|mtime| mtime >= started - SLACK)
+}
+
+fn wrapper_env_set() -> bool {
+    ["RUSTC_WRAPPER", "RUSTC_WORKSPACE_WRAPPER"]
+        .iter()
+        .any(|name| std::env::var_os(name).is_some_and(|value| !value.is_empty()))
+}
+
+fn file_name(path: &Path) -> Option<&str> {
+    path.file_name().and_then(OsStr::to_str)
+}
+
+fn short(key: &str) -> &str {
+    &key[..16.min(key.len())]
+}
+
+fn env_excluded(name: &str) -> bool {
+    ENV_EXCLUDED.contains(&name) || name.starts_with("DYLD_")
+}
+
+fn verify_env_deps(deps: &[EnvDep], current: impl Fn(&str) -> Option<OsString>) -> bool {
+    deps.iter().all(|dep| match (&dep.value, current(&dep.name)) {
+        (None, None) => true,
+        (Some(want), Some(have)) => have.to_str() == Some(want.as_str()),
+        _ => false,
+    })
+}
+
+fn verify_file_deps(deps: &[FileDep]) -> bool {
+    deps.iter().all(|dep| {
+        hash_file(Path::new(&dep.path)).is_ok_and(|(_, hash)| hex(&hash) == dep.blake3)
+    })
+}
+
+fn verify_blobs(entry_dir: &Path, entry: &Entry) -> Result<(), Fail> {
+    verify_blob_list(entry_dir, entry_blobs(entry))
+}
+
+/// Every blob must exist with the recorded size and BLAKE3; identical content is checked once.
+fn verify_blob_list<'a>(
+    entry_dir: &Path,
+    blobs: impl Iterator<Item = &'a Blob>,
+) -> Result<(), Fail> {
+    let mut verified = HashSet::default();
+    for blob in blobs {
+        if !verified.insert(blob.blake3.as_str()) {
+            continue;
+        }
+        let path = entry_dir.join(&blob.blake3);
+        let meta = fs::metadata(&path).map_err(|_| Fail::Corrupt("blob-missing"))?;
+        if meta.len() != blob.size {
+            return Err(Fail::Corrupt("blob-size"));
+        }
+        let (_, hash) = hash_file(&path).map_err(|_| Fail::Corrupt("blob-unreadable"))?;
+        if hex(&hash) != blob.blake3 {
+            return Err(Fail::Corrupt("blob-hash"));
+        }
+    }
+    Ok(())
+}
+
+/// Manifest names become path components, so a damaged manifest must not smuggle separators.
+fn entry_names_valid(entry: &Entry) -> bool {
+    let blob_ok = |blob: &Blob| {
+        is_hex64(&blob.blake3)
+            && !blob.name.is_empty()
+            && blob.name != "."
+            && blob.name != ".."
+            && !blob.name.contains(['/', '\\', '\0'])
+    };
+    is_hex64(&entry.key) && entry_blobs(entry).all(blob_ok)
+}
+
+fn is_hex64(text: &str) -> bool {
+    text.len() == 64 && text.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
+
+struct KeyHasher(blake3::Hasher);
+
+impl KeyHasher {
+    fn new() -> KeyHasher {
+        KeyHasher::with_schema(SCHEMA)
+    }
+
+    /// Domain-separated by `schema` so different entry kinds can never share a key.
+    fn with_schema(schema: &str) -> KeyHasher {
+        KeyHasher(blake3::Hasher::new_derive_key(schema))
+    }
+
+    /// Length-prefixed so adjacent fields cannot run together.
+    fn field(&mut self, tag: &str, data: &[u8]) {
+        self.0.update(&(tag.len() as u64).to_le_bytes());
+        self.0.update(tag.as_bytes());
+        self.0.update(&(data.len() as u64).to_le_bytes());
+        self.0.update(data);
+    }
+
+    fn finish(self) -> String {
+        self.0.finalize().to_hex().to_string()
+    }
+}
+
+struct Normalized {
+    args: Vec<Vec<u8>>,
+    /// Content digest of native inputs that can end up inside the output: static archives in
+    /// `-L native=` directories and files named by `-C link-arg`.
+    native_libs: Vec<u8>,
+    debuginfo: bool,
+    split_unpacked: bool,
+}
+
+/// Replaces build-directory paths and extern file paths by values that do not depend on where
+/// the target directory lives. Relative paths in arguments resolve against `cwd`.
+fn normalize_args(
+    args: &[&OsStr],
+    dirs: &[Vec<u8>],
+    build_paths: &[PathBuf],
+    cwd: &Path,
+) -> Result<Normalized, &'static str> {
+    let mut out = Normalized {
+        args: Vec::new(),
+        native_libs: Vec::new(),
+        debuginfo: false,
+        split_unpacked: false,
+    };
+    let static_link = links_static(args);
+    let plain = |bytes: &[u8]| replace_dirs(bytes, dirs, BUILD_TOKEN.as_bytes());
+    let mut index = 0;
+    while index < args.len() {
+        let bytes = args[index].as_encoded_bytes();
+        index += 1;
+        let value = args.get(index).copied();
+        match bytes {
+            b"--out-dir" => {
+                out.args.push(bytes.to_vec());
+                if value.is_some() {
+                    out.args.push(OUT_TOKEN.as_bytes().to_vec());
+                    index += 1;
+                }
+            }
+            b"--extern" => {
+                out.args.push(bytes.to_vec());
+                if let Some(value) = value {
+                    out.args.push(extern_arg(value)?);
+                    index += 1;
+                }
+            }
+            b"-L" => {
+                out.args.push(bytes.to_vec());
+                if let Some(value) = value {
+                    let search = SearchPaths { dirs, build_paths, cwd, hash_all: static_link };
+                    out.args.push(search_path_arg(value, &search, &mut out.native_libs)?);
+                    index += 1;
+                }
+            }
+            b"-C" => {
+                out.args.push(bytes.to_vec());
+                if let Some(value) = value {
+                    scan_codegen_flag(value.as_encoded_bytes(), cwd, &mut out)?;
+                    out.args.push(plain(value.as_encoded_bytes()));
+                    index += 1;
+                }
+            }
+            b"-g" => {
+                out.debuginfo = true;
+                out.args.push(bytes.to_vec());
+            }
+            // Terminal width and message rendering never change the artifacts.
+            _ if bytes.starts_with(b"--diagnostic-width=") || bytes.starts_with(b"--json=") => {}
+            _ if bytes.starts_with(b"--out-dir=") => {
+                out.args.push([b"--out-dir=".as_slice(), OUT_TOKEN.as_bytes()].concat());
+            }
+            _ if bytes.starts_with(b"-C") => {
+                scan_codegen_flag(&bytes[2..], cwd, &mut out)?;
+                out.args.push(plain(bytes));
+            }
+            _ => out.args.push(plain(bytes)),
+        }
+    }
+    // Unpacked split debuginfo writes `.dwo` files that the store does not keep.
+    if out.debuginfo && out.split_unpacked {
+        return Err("split-debuginfo-unpacked");
+    }
+    Ok(out)
+}
+
+/// Whether any `-l` asks for a static library, which rustc may bundle into the output.
+fn links_static(args: &[&OsStr]) -> bool {
+    let mut index = 0;
+    while index < args.len() {
+        let bytes = args[index].as_encoded_bytes();
+        index += 1;
+        let spec = if bytes == b"-l" {
+            index += 1;
+            args.get(index - 1).map(|arg| arg.as_encoded_bytes())
+        } else {
+            bytes.strip_prefix(b"-l")
+        };
+        if spec.is_some_and(|spec| spec.starts_with(b"static=") || spec.starts_with(b"static:")) {
+            return true;
+        }
+    }
+    false
+}
+
+fn scan_codegen_flag(flag: &[u8], cwd: &Path, out: &mut Normalized) -> Result<(), &'static str> {
+    if flag.starts_with(b"incremental") {
+        return Err("incremental");
+    }
+    // The last setting of each flag wins, matching rustc.
+    if let Some(level) = flag.strip_prefix(b"debuginfo=") {
+        out.debuginfo = level != b"0" && level != b"none";
+    }
+    if let Some(mode) = flag.strip_prefix(b"split-debuginfo=") {
+        out.split_unpacked = mode == b"unpacked";
+    }
+    if let Some(value) = flag.strip_prefix(b"link-arg=") {
+        link_arg_digest(value, cwd, &mut out.native_libs)?;
+    }
+    Ok(())
+}
+
+/// A `link-arg` that names an existing file (an object or archive) hands its content to the
+/// linker, so the content is a key input.
+fn link_arg_digest(value: &[u8], cwd: &Path, native_libs: &mut Vec<u8>) -> Result<(), &'static str> {
+    let Ok(text) = std::str::from_utf8(value) else {
+        return Ok(());
+    };
+    let path = cwd.join(text);
+    if !path.is_file() {
+        return Ok(());
+    }
+    let hash = cached_hash(&path).map_err(|_| "link-arg-unreadable")?;
+    native_libs.extend(format!("link-arg\0{text}\0{}\n", hex(&hash)).into_bytes());
+    Ok(())
+}
+
+fn extern_arg(value: &OsStr) -> Result<Vec<u8>, &'static str> {
+    let text = value.to_str().ok_or("extern-not-utf8")?;
+    let Some((head, path)) = text.split_once('=') else {
+        return Ok(text.as_bytes().to_vec());
+    };
+    let timer = stat_start();
+    let hash = cached_hash(Path::new(path));
+    stat_add(&STATS.extern_ns, timer);
+    let hash = hash.map_err(|_| "extern-unreadable")?;
+    Ok(format!("{head}={}", hex(&hash)).into_bytes())
+}
+
+struct SearchPaths<'a> {
+    dirs: &'a [Vec<u8>],
+    build_paths: &'a [PathBuf],
+    cwd: &'a Path,
+    /// Some `-l static` is present: archives in every native directory may be bundled.
+    hash_all: bool,
+}
+
+fn search_path_arg(
+    value: &OsStr,
+    search: &SearchPaths<'_>,
+    native_libs: &mut Vec<u8>,
+) -> Result<Vec<u8>, &'static str> {
+    let text = value.to_str().ok_or("search-path-not-utf8")?;
+    let (kind, path) = match text.split_once('=') {
+        Some((kind, path))
+            if matches!(kind, "dependency" | "crate" | "native" | "framework" | "all") =>
+        {
+            (kind, path)
+        }
+        _ => ("all", text),
+    };
+    // `-l static` bundles the archive into the rlib. Build script archives are always inputs;
+    // with a static link in the command line every native directory is.
+    let full = search.cwd.join(path);
+    if matches!(kind, "native" | "all")
+        && (search.hash_all || search.build_paths.iter().any(|dir| full.starts_with(dir)))
+    {
+        native_libs.extend(native_lib_digest(&full)?);
+    }
+    Ok(replace_dirs(text.as_bytes(), search.dirs, BUILD_TOKEN.as_bytes()))
+}
+
+fn native_lib_digest(dir: &Path) -> Result<Vec<u8>, &'static str> {
+    let timer = stat_start();
+    let digest = native_lib_rows(dir);
+    stat_add(&STATS.native_ns, timer);
+    digest
+}
+
+/// Archives are hashed through the per-process memo, so each is read once per run however many
+/// units list its directory.
+fn native_lib_rows(dir: &Path) -> Result<Vec<u8>, &'static str> {
+    let Ok(read) = fs::read_dir(dir) else {
+        return Ok(Vec::new());
+    };
+    let mut rows = Vec::new();
+    for item in read.flatten() {
+        let name = item.file_name();
+        let Some(name) = name.to_str() else { continue };
+        if !(name.ends_with(".a") || name.ends_with(".lib")) {
+            continue;
+        }
+        let hash = cached_hash(&item.path()).map_err(|_| "native-lib-unreadable")?;
+        rows.push(format!("{name}\0{}\n", hex(&hash)));
+    }
+    rows.sort();
+    Ok(rows.concat().into_bytes())
+}
+
+/// Directory prefixes sorted longest first so the most specific one wins.
+fn norm_dirs(paths: &[PathBuf]) -> Vec<Vec<u8>> {
+    let mut dirs: Vec<Vec<u8>> = paths
+        .iter()
+        .map(|path| {
+            let mut bytes = path.as_os_str().as_encoded_bytes();
+            while bytes.len() > 1 && bytes.ends_with(b"/") {
+                bytes = &bytes[..bytes.len() - 1];
+            }
+            bytes.to_vec()
+        })
+        .filter(|bytes| bytes.len() > 1)
+        .collect();
+    dirs.sort_by(|a, b| b.len().cmp(&a.len()).then_with(|| a.cmp(b)));
+    dirs.dedup();
+    dirs
+}
+
+fn is_name_byte(byte: u8) -> bool {
+    byte.is_ascii_alphanumeric() || matches!(byte, b'_' | b'-' | b'.')
+}
+
+/// Replaces whole-path occurrences of any directory in `dirs`; a longer path that merely shares
+/// the prefix text (`/tmp/t` inside `/tmp/t2`) is left alone.
+fn replace_dirs(input: &[u8], dirs: &[Vec<u8>], token: &[u8]) -> Vec<u8> {
+    let mut out = Vec::with_capacity(input.len());
+    let mut index = 0;
+    'scan: while index < input.len() {
+        let starts_name = index == 0 || !is_name_byte(input[index - 1]);
+        if starts_name {
+            for dir in dirs {
+                let end = index + dir.len();
+                if input[index..].starts_with(dir) && (end == input.len() || !is_name_byte(input[end])) {
+                    out.extend_from_slice(token);
+                    index = end;
+                    continue 'scan;
+                }
+            }
+        }
+        out.push(input[index]);
+        index += 1;
+    }
+    out
+}
+
+fn normalize_dep_info(text: &str, out_dir: &Path) -> Result<String, &'static str> {
+    let out_dir = out_dir.to_str().ok_or("out-dir-not-utf8")?;
+    let bytes = replace_dirs(text.as_bytes(), &[out_dir.as_bytes().to_vec()], OUT_TOKEN.as_bytes());
+    String::from_utf8(bytes).map_err(|_| "dep-info-not-utf8")
+}
+
+fn toolchain_id(inputs: &ToolchainInputs) -> String {
+    let memo_key = format!(
+        "{}\0{}\0{:?}",
+        inputs.verbose_version,
+        inputs.sysroot.display(),
+        inputs.lib_dirs
+    );
+    if let Some(id) = TOOLCHAINS.lock().unwrap().get(&memo_key) {
+        return id.clone();
+    }
+    let id = compute_toolchain_id(inputs);
+    TOOLCHAINS.lock().unwrap().insert(memo_key, id.clone());
+    id
+}
+
+fn compute_toolchain_id(inputs: &ToolchainInputs) -> String {
+    let mut hasher = KeyHasher::new();
+    hasher.field("rustc-vV", inputs.verbose_version.as_bytes());
+    hasher.field("sysroot", inputs.sysroot.as_os_str().as_encoded_bytes());
+    for dir in &inputs.lib_dirs {
+        hasher.field("lib-dir", dir.as_os_str().as_encoded_bytes());
+        hasher.field("lib-listing", &dir_listing(dir));
+    }
+    if let Ok(extra) = fs::read(inputs.sysroot.join("frust-toolchain-id")) {
+        hasher.field("frust-toolchain-id", &extra);
+    }
+    hasher.finish()
+}
+
+/// Sorted `(name, size, mtime_ns)` rows for the regular files directly inside `dir`.
+fn dir_listing(dir: &Path) -> Vec<u8> {
+    let mut rows = Vec::new();
+    if let Ok(read) = fs::read_dir(dir) {
+        for item in read.flatten() {
+            let Ok(meta) = fs::metadata(item.path()) else { continue };
+            if !meta.is_file() {
+                continue;
+            }
+            let nanos = meta
+                .modified()
+                .ok()
+                .and_then(|time| time.duration_since(UNIX_EPOCH).ok())
+                .map_or(0, |elapsed| elapsed.as_nanos());
+            rows.push(format!("{}\0{}\0{nanos}\n", item.file_name().to_string_lossy(), meta.len()));
+        }
+    }
+    rows.sort();
+    rows.concat().into_bytes()
+}
+
+fn hash_file(path: &Path) -> io::Result<(u64, [u8; 32])> {
+    let mut file = File::open(path)?;
+    let len = file.metadata().map_or(0, |meta| meta.len());
+    let (size, hash) = stream_blake3(&mut file, len, None)?;
+    stat_bytes(&STATS.hashed_bytes, size);
+    Ok((size, hash))
+}
+
+/// Hash of an input that is reused by many units in one run, keyed by path, size and mtime.
+fn cached_hash(path: &Path) -> io::Result<[u8; 32]> {
+    let meta = fs::metadata(path)?;
+    let (len, mtime) = (meta.len(), meta.modified()?);
+    if let Some(&(cached_len, cached_mtime, hash)) = FILE_HASHES.lock().unwrap().get(path) {
+        if cached_len == len && cached_mtime == mtime {
+            return Ok(hash);
+        }
+    }
+    let (_, hash) = hash_file(path)?;
+    remember_hash(path, len, mtime, hash);
+    Ok(hash)
+}
+
+/// Records a content hash that is already known, so `cached_hash` never reads the file.
+fn remember_hash(path: &Path, len: u64, mtime: SystemTime, hash: [u8; 32]) {
+    FILE_HASHES.lock().unwrap().insert(path.to_path_buf(), (len, mtime, hash));
+}
+
+/// Records the verified hash of a file just written to `path`, keyed by its actual size and mtime.
+fn remember_written_hash(path: &Path, hash_hex: &str) {
+    let Ok(hash) = blake3::Hash::from_hex(hash_hex) else { return };
+    let Ok(meta) = fs::metadata(path) else { return };
+    if let Ok(mtime) = meta.modified() {
+        remember_hash(path, meta.len(), mtime, *hash.as_bytes());
+    }
+}
+
+fn hex(hash: &[u8; 32]) -> String {
+    blake3::Hash::from_bytes(*hash).to_hex().to_string()
+}
+
+fn temp_name(prefix: &str) -> String {
+    format!("{prefix}{}-{}", std::process::id(), NEXT_TEMP.fetch_add(1, Ordering::Relaxed))
+}
+
+fn restore_temp(dest: &Path) -> PathBuf {
+    let name = dest.file_name().map(|n| n.to_string_lossy().into_owned()).unwrap_or_default();
+    dest.with_file_name(format!(".frust-restore-{}-{name}", temp_name("")))
+}
+
+#[cfg(unix)]
+fn make_writable(path: &Path) -> io::Result<()> {
+    use std::os::unix::fs::PermissionsExt;
+    fs::set_permissions(path, fs::Permissions::from_mode(0o644))
+}
+
+#[cfg(not(unix))]
+fn make_writable(path: &Path) -> io::Result<()> {
+    let mut perms = fs::metadata(path)?.permissions();
+    perms.set_readonly(false);
+    fs::set_permissions(path, perms)
+}
+
+/// Reflink, else copy; never a hard link. The result is a private, writable file stamped
+/// `stamp`: a shared inode would keep the blob's old mtime (stale-looking to Cargo's dependency
+/// checks) and Cargo's mtime shifts would write through to the shared blob.
+///
+/// A blob can share its inode with the target file it was stored from, so the copy fallback
+/// hashes while it copies and fails if the content is no longer `expected` (BLAKE3 hex).
+fn clone_or_copy(src: &Path, dst: &Path, expected: &str, stamp: FileTime) -> io::Result<()> {
+    if reflink(src, dst).is_err() {
+        let _ = fs::remove_file(dst);
+        copy_verified(src, dst, expected)?;
+    }
+    make_writable(dst)?;
+    filetime::set_file_mtime(dst, stamp)
+}
+
+fn copy_verified(src: &Path, dst: &Path, expected: &str) -> io::Result<()> {
+    let mut input = File::open(src)?;
+    let len = input.metadata()?.len();
+    let mut output = OpenOptions::new().write(true).create_new(true).open(dst)?;
+    let (size, hash) = stream_blake3(&mut input, len, Some(&mut output))?;
+    drop(output);
+    stat_bytes(&STATS.written_bytes, size);
+    if hex(&hash) != expected {
+        let _ = fs::remove_file(dst);
+        return Err(io::Error::other("blob changed while restoring"));
+    }
+    Ok(())
+}
+
+#[cfg(all(
+    target_os = "linux",
+    any(
+        target_arch = "x86_64",
+        target_arch = "aarch64",
+        target_arch = "riscv64",
+        target_arch = "x86",
+        target_arch = "arm"
+    )
+))]
+fn reflink(src: &Path, dst: &Path) -> io::Result<()> {
+    use std::os::fd::AsRawFd;
+    const FICLONE: libc::c_ulong = 0x4004_9409;
+    let input = File::open(src)?;
+    let output = OpenOptions::new().write(true).create_new(true).open(dst)?;
+    // SAFETY: both descriptors stay open for the duration of the call.
+    let rc = unsafe { libc::ioctl(output.as_raw_fd(), FICLONE as _, input.as_raw_fd()) };
+    if rc == 0 {
+        return Ok(());
+    }
+    let err = io::Error::last_os_error();
+    drop(output);
+    let _ = fs::remove_file(dst);
+    Err(err)
+}
+
+#[cfg(target_os = "macos")]
+fn reflink(src: &Path, dst: &Path) -> io::Result<()> {
+    use std::ffi::CString;
+    use std::os::unix::ffi::OsStrExt;
+    unsafe extern "C" {
+        fn clonefile(src: *const libc::c_char, dst: *const libc::c_char, flags: u32) -> libc::c_int;
+    }
+    let to_c = |path: &Path| {
+        CString::new(path.as_os_str().as_bytes()).map_err(|_| io::Error::other("nul in path"))
+    };
+    let (src, dst) = (to_c(src)?, to_c(dst)?);
+    // SAFETY: both pointers are valid NUL-terminated strings for the duration of the call.
+    if unsafe { clonefile(src.as_ptr(), dst.as_ptr(), 0) } == 0 {
+        Ok(())
+    } else {
+        Err(io::Error::last_os_error())
+    }
+}
+
+#[cfg(not(any(
+    all(
+        target_os = "linux",
+        any(
+            target_arch = "x86_64",
+            target_arch = "aarch64",
+            target_arch = "riscv64",
+            target_arch = "x86",
+            target_arch = "arm"
+        )
+    ),
+    target_os = "macos"
+)))]
+fn reflink(_src: &Path, _dst: &Path) -> io::Result<()> {
+    Err(io::ErrorKind::Unsupported.into())
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum LockMode {
+    Shared,
+    Exclusive,
+}
+
+/// `Ok(None)` means another process holds a conflicting lock; callers never wait.
+fn try_lock(path: &Path, mode: LockMode) -> io::Result<Option<File>> {
+    // GC may unlink the lock file between open and lock, so confirm we locked the live inode.
+    for _ in 0..4 {
+        let file = match OpenOptions::new().read(true).write(true).create(true).truncate(false).open(path)
+        {
+            Ok(file) => file,
+            // A read-only store can still serve shared locks on existing lock files.
+            Err(_) if mode == LockMode::Shared => File::open(path)?,
+            Err(err) => return Err(err),
+        };
+        let locked = match mode {
+            LockMode::Shared => flock::try_lock_shared(&file),
+            LockMode::Exclusive => flock::try_lock_exclusive(&file),
+        };
+        match locked {
+            Ok(()) => {}
+            Err(TryLockError::WouldBlock) => return Ok(None),
+            Err(TryLockError::Error(err)) => return Err(err),
+        }
+        if still_linked(&file, path) {
+            return Ok(Some(file));
+        }
+    }
+    Ok(None)
+}
+
+#[cfg(unix)]
+fn still_linked(file: &File, path: &Path) -> bool {
+    use std::os::unix::fs::MetadataExt;
+    match (file.metadata(), fs::metadata(path)) {
+        (Ok(open), Ok(linked)) => open.dev() == linked.dev() && open.ino() == linked.ino(),
+        _ => false,
+    }
+}
+
+#[cfg(not(unix))]
+fn still_linked(_file: &File, _path: &Path) -> bool {
+    true
+}
+
+fn now_unix() -> u64 {
+    SystemTime::now().duration_since(UNIX_EPOCH).map_or(0, |elapsed| elapsed.as_secs())
+}
+
+/// Zero when the time cannot be read, so unreadable files are never treated as old garbage.
+fn age(path: &Path) -> Duration {
+    fs::metadata(path)
+        .and_then(|meta| meta.modified())
+        .ok()
+        .and_then(|time| SystemTime::now().duration_since(time).ok())
+        .unwrap_or_default()
+}
+
+fn invoked_as_fcargo() -> bool {
+    if std::env::var("FRUST_INVOCATION").ok().as_deref() == Some("fcargo") {
+        return true;
+    }
+    std::env::args()
+        .next()
+        .is_some_and(|argv0| Path::new(&argv0).file_name().and_then(OsStr::to_str) == Some("fcargo"))
+}
+
+fn enabled_by_env() -> bool {
+    if !cfg!(any(target_os = "linux", target_os = "macos")) {
+        return false;
+    }
+    match std::env::var("FRUST_UNIT_CACHE") {
+        Ok(value) if value == "0" || value.eq_ignore_ascii_case("off") => false,
+        Ok(value) if value == "1" || value.eq_ignore_ascii_case("on") => true,
+        _ => invoked_as_fcargo(),
+    }
+}
+
+fn shared_store() -> Option<Arc<Store>> {
+    SHARED.get_or_init(open_from_env).clone()
+}
+
+fn open_from_env() -> Option<Arc<Store>> {
+    if !enabled_by_env() {
+        return None;
+    }
+    let home = std::env::var_os("HOME").map(PathBuf::from).filter(|path| path.is_absolute())?;
+    let os = if cfg!(target_os = "macos") { HostOs::Macos } else { HostOs::Linux };
+    let roots = frust_paths::load_roots_from_host(
+        os,
+        &home,
+        std::env::var("XDG_CONFIG_HOME").ok().as_deref(),
+        std::env::var("XDG_CACHE_HOME").ok().as_deref(),
+    )
+    .ok()?;
+    if frust_paths::open_artifact_cache(&roots.artifacts_dir) != CacheOpen::Ready {
+        return None;
+    }
+    let budget = std::env::var("FRUST_UNIT_CACHE_MAX_BYTES")
+        .ok()
+        .and_then(|value| value.trim().parse::<u64>().ok())
+        .filter(|bytes| *bytes > 0)
+        .unwrap_or(DEFAULT_BUDGET);
+    let debug = std::env::var("FRUST_UNIT_CACHE_DEBUG").is_ok_and(|value| value == "1");
+    STATS_ON.store(debug, Ordering::Relaxed);
+    Some(Arc::new(Store::new(roots.artifacts_dir.join("units").join("v1"), budget, debug)))
+}
+
+/// The on-disk layout: `<root>/<key[0..2]>/<key>/` entries and `<key>.lock` beside them.
+struct Store {
+    root: PathBuf,
+    budget: u64,
+    debug: bool,
+    gc_ran: AtomicBool,
+}
+
+#[derive(Default, Debug)]
+#[allow(dead_code)] // inspected by tests
+struct GcReport {
+    evicted: Vec<String>,
+    garbage: usize,
+    total_before: u64,
+    total_after: u64,
+}
+
+struct Scanned {
+    key: String,
+    size: u64,
+    last_used: SystemTime,
+}
+
+enum Scan {
+    Live(Scanned),
+    Removed,
+    Skipped,
+}
+
+impl Store {
+    fn new(root: PathBuf, budget: u64, debug: bool) -> Store {
+        Store { root, budget, debug, gc_ran: AtomicBool::new(false) }
+    }
+
+    #[allow(clippy::print_stderr)]
+    fn log(&self, line: std::fmt::Arguments<'_>) {
+        if self.debug {
+            eprintln!("frust-unit-cache: {line}");
+        }
+    }
+
+    fn shard(&self, key: &str) -> PathBuf {
+        self.root.join(&key[..2])
+    }
+
+    fn entry_dir(&self, key: &str) -> PathBuf {
+        self.shard(key).join(key)
+    }
+
+    fn lock_path(&self, key: &str) -> PathBuf {
+        self.shard(key).join(format!("{key}.lock"))
+    }
+
+    /// Returns the recorded size, or `None` when the entry already exists or another process is
+    /// writing it.
+    fn write_entry(
+        &self,
+        key: &str,
+        toolchain_id: &str,
+        outputs: &[(String, PathBuf)],
+        dep_info: (String, Vec<u8>),
+        messages: Vec<u8>,
+        recorded: Recorded,
+    ) -> io::Result<Option<u64>> {
+        self.commit_entry(key, |entry_dir| {
+            self.fill_entry(entry_dir, key, toolchain_id, outputs, dep_info, messages, recorded)
+        })
+    }
+
+    /// Runs `fill` on a fresh entry directory under the per-key exclusive lock. `fill` writes the
+    /// blobs, commits `entry.json` last and returns the recorded size. Returns `None` when the
+    /// entry already exists or another process is writing it.
+    fn commit_entry(
+        &self,
+        key: &str,
+        fill: impl FnOnce(&Path) -> io::Result<u64>,
+    ) -> io::Result<Option<u64>> {
+        let entry_dir = self.entry_dir(key);
+        if entry_dir.join(MANIFEST).exists() {
+            return Ok(None);
+        }
+        fs::create_dir_all(self.shard(key))?;
+        let Some(_lock) = try_lock(&self.lock_path(key), LockMode::Exclusive)? else {
+            return Ok(None);
+        };
+        if entry_dir.join(MANIFEST).exists() {
+            return Ok(None);
+        }
+        // Holding the lock means no live writer owns a manifest-less directory.
+        if entry_dir.exists() {
+            fs::remove_dir_all(&entry_dir)?;
+        }
+        fs::create_dir(&entry_dir)?;
+        match fill(&entry_dir) {
+            Ok(size) => Ok(Some(size)),
+            Err(err) => {
+                let _ = fs::remove_dir_all(&entry_dir);
+                Err(err)
+            }
+        }
+    }
+
+    fn fill_entry(
+        &self,
+        entry_dir: &Path,
+        key: &str,
+        toolchain_id: &str,
+        outputs: &[(String, PathBuf)],
+        dep_info: (String, Vec<u8>),
+        messages: Vec<u8>,
+        recorded: Recorded,
+    ) -> io::Result<u64> {
+        let mut blobs = Vec::with_capacity(outputs.len());
+        for (name, path) in outputs {
+            blobs.push(put_output_blob(entry_dir, name, path)?);
+        }
+        let manifest_timer = stat_start();
+        let dep_blob = put_blob(entry_dir, &dep_info.0, dep_info.1.as_slice())?;
+        let messages_blob = put_blob(entry_dir, "messages", messages.as_slice())?;
+        let entry = Entry {
+            schema: MANIFEST_SCHEMA,
+            kind: unit_kind(),
+            key: key.to_string(),
+            toolchain_id: toolchain_id.to_string(),
+            outputs: blobs,
+            dep_info: dep_blob,
+            messages: messages_blob,
+            env_deps: recorded.env_deps,
+            file_deps: recorded.file_deps,
+            bound_dir: recorded.bound_dir,
+            created_unix: now_unix(),
+        };
+        let json = serde_json::to_vec(&entry).map_err(io::Error::other)?;
+        // The manifest is committed last so readers never see an entry without its blobs.
+        let temp = entry_dir.join(temp_name("tmp-"));
+        fs::write(&temp, &json)?;
+        fs::rename(&temp, entry_dir.join(MANIFEST))?;
+        stat_bytes(&STATS.written_bytes, json.len() as u64);
+        stat_add(&STATS.store_manifest_ns, manifest_timer);
+        Ok(entry_size(&entry))
+    }
+
+    fn print_stats(&self) {
+        if self.debug {
+            self.log(format_args!("{}", STATS.line()));
+        }
+    }
+
+    /// Takes the exclusive lock without waiting; locked entries are left alone.
+    fn remove_entry(&self, key: &str) -> bool {
+        let lock_path = self.lock_path(key);
+        let Ok(Some(_guard)) = try_lock(&lock_path, LockMode::Exclusive) else {
+            return false;
+        };
+        let dir = self.entry_dir(key);
+        if fs::remove_dir_all(&dir).is_err() && dir.exists() {
+            return false;
+        }
+        let _ = fs::remove_file(&lock_path);
+        true
+    }
+
+    fn counter_path(&self) -> PathBuf {
+        self.root.join(".size")
+    }
+
+    fn read_counter(&self) -> Option<(u64, Duration)> {
+        let path = self.counter_path();
+        let total = fs::read_to_string(&path).ok()?.trim().parse::<u64>().ok()?;
+        Some((total, age(&path)))
+    }
+
+    fn write_counter(&self, total: u64) {
+        let temp = self.root.join(temp_name(".size-"));
+        if fs::write(&temp, total.to_string()).is_err() || fs::rename(&temp, self.counter_path()).is_err() {
+            let _ = fs::remove_file(&temp);
+        }
+    }
+
+    /// Keeps a best-effort size counter and runs at most one full scan per process, only when
+    /// the counter is missing, stale or over budget.
+    fn note_stored(&self, bytes: u64) {
+        let counter = self.read_counter();
+        let total = counter.map(|(total, _)| total.saturating_add(bytes));
+        let needs_scan = match counter {
+            None => true,
+            Some((total, counter_age)) => {
+                total.saturating_add(bytes) > self.budget || counter_age > COUNTER_MAX_AGE
+            }
+        };
+        if needs_scan && !self.gc_ran.swap(true, Ordering::SeqCst) {
+            self.gc();
+        } else if let Some(total) = total {
+            self.write_counter(total);
+        }
+    }
+
+    /// Removes interrupted-writer garbage, then evicts least recently used entries down to 80% of
+    /// the budget when the total is over it.
+    fn gc(&self) -> GcReport {
+        let mut report = GcReport::default();
+        let mut entries = self.scan(&mut report);
+        let mut total: u64 = entries.iter().map(|entry| entry.size).sum();
+        report.total_before = total;
+        if total > self.budget {
+            let target = (self.budget as u128 * EVICT_TO_PERCENT / 100) as u64;
+            entries.sort_by_key(|entry| entry.last_used);
+            for entry in &entries {
+                if total <= target {
+                    break;
+                }
+                if self.remove_entry(&entry.key) {
+                    total = total.saturating_sub(entry.size);
+                    report.evicted.push(entry.key.clone());
+                }
+            }
+        }
+        report.total_after = total;
+        self.write_counter(total);
+        report
+    }
+
+    fn scan(&self, report: &mut GcReport) -> Vec<Scanned> {
+        let mut found = Vec::new();
+        let Ok(shards) = fs::read_dir(&self.root) else {
+            return found;
+        };
+        for shard in shards.flatten() {
+            let shard_path = shard.path();
+            let Ok(items) = fs::read_dir(&shard_path) else { continue };
+            for item in items.flatten() {
+                let path = item.path();
+                let Some(name) = item.file_name().to_str().map(str::to_owned) else { continue };
+                if let Some(key) = name.strip_suffix(".lock") {
+                    let orphan = !shard_path.join(key).exists() && age(&path) > GARBAGE_AGE;
+                    if orphan {
+                        if let Ok(Some(_guard)) = try_lock(&path, LockMode::Exclusive) {
+                            let _ = fs::remove_file(&path);
+                            report.garbage += 1;
+                        }
+                    }
+                } else if path.is_dir() {
+                    match self.scan_entry(&name, &path) {
+                        Scan::Live(entry) => found.push(entry),
+                        Scan::Removed => report.garbage += 1,
+                        Scan::Skipped => {}
+                    }
+                }
+            }
+        }
+        found
+    }
+
+    fn scan_entry(&self, key: &str, dir: &Path) -> Scan {
+        if !is_hex64(key) {
+            return Scan::Skipped;
+        }
+        let removed = |store: &Store| if store.remove_entry(key) { Scan::Removed } else { Scan::Skipped };
+        let Ok(bytes) = fs::read(dir.join(MANIFEST)) else {
+            // No manifest: a writer is in flight or died; only old ones are garbage.
+            return if age(dir) > GARBAGE_AGE { removed(self) } else { Scan::Skipped };
+        };
+        let manifest = match parse_manifest(&bytes) {
+            ManifestParse::Known(manifest) => manifest,
+            // A kind from a newer build: leave it alone and uncounted.
+            ManifestParse::UnknownKind => return Scan::Skipped,
+            ManifestParse::Invalid => return removed(self),
+        };
+        if !manifest.names_valid() {
+            return removed(self);
+        }
+        if let Ok(items) = fs::read_dir(dir) {
+            for item in items.flatten() {
+                let stale = item.file_name().to_string_lossy().starts_with("tmp-") && age(&item.path()) > GARBAGE_AGE;
+                if stale {
+                    let _ = fs::remove_file(item.path());
+                }
+            }
+        }
+        // Hits touch the manifest, so its mtime is the recency stamp.
+        let last_used = fs::metadata(dir.join(MANIFEST))
+            .and_then(|meta| meta.modified())
+            .unwrap_or(UNIX_EPOCH);
+        if manifest.blobs().iter().any(|blob| fs::metadata(dir.join(&blob.blake3)).is_err()) {
+            return removed(self);
+        }
+        Scan::Live(Scanned { key: key.to_string(), size: manifest.size(), last_used })
+    }
+}
+
+fn unit_kind() -> String {
+    "unit".to_string()
+}
+
+/// The two entry shapes sharing the store, told apart by the `kind` field.
+enum Manifest {
+    Unit(Entry),
+    Script(script_cache::ScriptEntry),
+}
+
+enum ManifestParse {
+    Known(Manifest),
+    /// Valid JSON with a `kind` this build does not know.
+    UnknownKind,
+    Invalid,
+}
+
+fn parse_manifest(bytes: &[u8]) -> ManifestParse {
+    #[derive(Deserialize)]
+    struct Probe {
+        kind: Option<String>,
+    }
+    let Ok(probe) = serde_json::from_slice::<Probe>(bytes) else {
+        return ManifestParse::Invalid;
+    };
+    match probe.kind.as_deref() {
+        None | Some("unit") => match serde_json::from_slice::<Entry>(bytes) {
+            Ok(entry) => ManifestParse::Known(Manifest::Unit(entry)),
+            Err(_) => ManifestParse::Invalid,
+        },
+        Some(script_cache::KIND) => match serde_json::from_slice::<script_cache::ScriptEntry>(bytes) {
+            Ok(entry) => ManifestParse::Known(Manifest::Script(entry)),
+            Err(_) => ManifestParse::Invalid,
+        },
+        Some(_) => ManifestParse::UnknownKind,
+    }
+}
+
+impl Manifest {
+    fn names_valid(&self) -> bool {
+        match self {
+            Manifest::Unit(entry) => entry_names_valid(entry),
+            Manifest::Script(entry) => entry.names_valid(),
+        }
+    }
+
+    fn blobs(&self) -> Vec<Blob> {
+        match self {
+            Manifest::Unit(entry) => entry_blobs(entry).cloned().collect(),
+            Manifest::Script(entry) => entry.blobs(),
+        }
+    }
+
+    fn size(&self) -> u64 {
+        match self {
+            Manifest::Unit(entry) => entry_size(entry),
+            Manifest::Script(entry) => entry.size(),
+        }
+    }
+}
+
+/// Sum of distinct blob sizes: identical content is stored once.
+fn entry_size(entry: &Entry) -> u64 {
+    let mut seen = HashSet::default();
+    entry_blobs(entry)
+        .filter(|blob| seen.insert(blob.blake3.as_str()))
+        .map(|blob| blob.size)
+        .sum()
+}
+
+/// Copies `input` into a temporary file while hashing it, then publishes it under its hash.
+fn put_blob(entry_dir: &Path, name: &str, mut input: impl Read) -> io::Result<Blob> {
+    let temp = entry_dir.join(temp_name("tmp-"));
+    let mut output = OpenOptions::new().write(true).create_new(true).open(&temp)?;
+    let (size, hash) = stream_blake3(&mut input, COPY_BUF as u64, Some(&mut output))?;
+    drop(output);
+    stat_bytes(&STATS.hashed_bytes, size);
+    stat_bytes(&STATS.written_bytes, size);
+    let digest = hex(&hash);
+    publish_private_blob(&temp, &entry_dir.join(&digest))?;
+    Ok(Blob { name: name.to_string(), size, blake3: digest })
+}
+
+/// Renames a store-private temporary file to its blob name and makes it read-only, or drops it
+/// when the same content is already there.
+fn publish_private_blob(temp: &Path, dest: &Path) -> io::Result<()> {
+    if dest.exists() {
+        return fs::remove_file(temp);
+    }
+    let mut perms = fs::metadata(temp)?.permissions();
+    perms.set_readonly(true);
+    fs::set_permissions(temp, perms)?;
+    fs::rename(temp, dest)
+}
+
+/// How an output file entered the store.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+enum BlobSource {
+    /// A hard link to the freshly built output: no data copied, shared inode.
+    Link,
+    /// A reflink clone: own inode, shared extents.
+    Clone,
+    /// A streamed copy that was hashed in the same pass.
+    Copy,
+}
+
+/// Publishes a freshly built output as a blob named by its BLAKE3, reading it exactly once.
+///
+/// A hard link (or else a reflink) makes the blob without moving data, and the single pass then
+/// only hashes. When neither is possible the one pass hashes and copies together. A linked blob
+/// shares the output's inode and is deliberately left writable: rustc and Cargo replace outputs
+/// by rename or remove-and-write, which leaves the blob alone, and an in-place change would be
+/// caught by the BLAKE3 check every restore performs.
+fn put_output_blob(entry_dir: &Path, name: &str, src: &Path) -> io::Result<Blob> {
+    let mut input = File::open(src)?;
+    let before = input.metadata()?;
+    if !before.is_file() {
+        return Err(io::Error::other("output is not a file"));
+    }
+    let temp = entry_dir.join(temp_name("tmp-"));
+    let write_timer = stat_start();
+    let source = if fs::hard_link(src, &temp).is_ok() {
+        BlobSource::Link
+    } else if reflink(src, &temp).is_ok() {
+        BlobSource::Clone
+    } else {
+        BlobSource::Copy
+    };
+    let (size, hash) = if source == BlobSource::Copy {
+        let mut output = OpenOptions::new().write(true).create_new(true).open(&temp)?;
+        let result = stream_blake3(&mut input, before.len(), Some(&mut output))?;
+        stat_add(&STATS.store_write_ns, write_timer);
+        stat_bytes(&STATS.written_bytes, result.0);
+        result
+    } else {
+        stat_add(&STATS.store_write_ns, write_timer);
+        let hash_timer = stat_start();
+        let result = stream_blake3(&mut input, before.len(), None)?;
+        stat_add(&STATS.store_hash_ns, hash_timer);
+        result
+    };
+    stat_bytes(&STATS.hashed_bytes, size);
+    // Dependents hash this file as an `--extern` input; the hash just computed answers that.
+    if let Ok(after) = input.metadata() {
+        let unchanged = after.len() == size && after.modified().ok() == before.modified().ok();
+        if let (true, Ok(mtime)) = (unchanged, after.modified()) {
+            remember_hash(src, size, mtime, hash);
+        }
+    }
+    let digest = hex(&hash);
+    let dest = entry_dir.join(&digest);
+    if source == BlobSource::Link {
+        if dest.exists() {
+            fs::remove_file(&temp)?;
+        } else {
+            fs::rename(&temp, &dest)?;
+        }
+    } else {
+        publish_private_blob(&temp, &dest)?;
+    }
+    Ok(Blob { name: name.to_string(), size, blake3: digest })
+}
+
+/// Streams `input` once through BLAKE3, writing every chunk to `copy` in the same pass when
+/// given. The buffer is sized to the expected length, up to `HASH_BUF`.
+fn stream_blake3(
+    input: &mut impl Read,
+    len_hint: u64,
+    mut copy: Option<&mut File>,
+) -> io::Result<(u64, [u8; 32])> {
+    let mut hasher = blake3::Hasher::new();
+    let mut buf = vec![0u8; usize::try_from(len_hint).unwrap_or(HASH_BUF).clamp(4096, HASH_BUF)];
+    let mut size = 0u64;
+    loop {
+        let read = match input.read(&mut buf) {
+            Ok(0) => break,
+            Ok(read) => read,
+            Err(err) if err.kind() == io::ErrorKind::Interrupted => continue,
+            Err(err) => return Err(err),
+        };
+        hasher.update(&buf[..read]);
+        if let Some(output) = copy.as_mut() {
+            output.write_all(&buf[..read])?;
+        }
+        size += read as u64;
+    }
+    Ok((size, *hasher.finalize().as_bytes()))
+}
