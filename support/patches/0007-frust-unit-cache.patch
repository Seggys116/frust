+    #[test]
+    fn key_follows_tool_identity() {
+        let (tmp, store) = fixture();
+        let cache = script_cache(tmp.path(), "a", &store);
+        let bin = program(tmp.path(), "script v1");
+        let absent = key_of(&cache, &command(&cache, &bin));
+
+        let cc = tmp.path().join("bin").join("cc");
+        fs::write(&cc, "compiler one").unwrap();
+        let present = key_of(&cache, &command(&cache, &bin));
+        assert_ne!(absent, present, "an installed tool differs from an absent one");
+        fs::write(&cc, "compiler two, different").unwrap();
+        assert_ne!(present, key_of(&cache, &command(&cache, &bin)));
+
+        // A tool named by CC or a target-specific variable is resolved too.
+        let custom = tmp.path().join("bin").join("my-cc");
+        fs::write(&custom, "custom one").unwrap();
+        let mut cmd = command(&cache, &bin);
+        cmd.env("CC_x86_64_unknown_linux_gnu", format!("{} -O2", custom.display()));
+        let named = key_of(&cache, &cmd);
+        assert_ne!(named, key_of(&cache, &command(&cache, &bin)));
+        fs::write(&custom, "custom two, longer").unwrap();
+        assert_ne!(named, key_of(&cache, &cmd));
+
+        let mut relative = command(&cache, &bin);
+        relative.env("CXX", "my-cxx --flag");
+        let before = key_of(&cache, &relative);
+        fs::write(tmp.path().join("bin").join("my-cxx"), "cxx").unwrap();
+        assert_ne!(before, key_of(&cache, &relative), "resolved against the child's PATH");
+    }
