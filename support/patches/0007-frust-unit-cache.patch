+        let cache = unit_cache(tmp.path(), "a", &store);
+        let cmd = command(&cache);
+        populate(&cache, &cmd, &[], &[]);
+        let expected = *blake3::hash(b"rlib-bytes").as_bytes();
+        overwrite_keeping_size_and_mtime(&cache.outputs[0]);
+        assert_eq!(cached_hash(&cache.outputs[0]).unwrap(), expected, "answered without reading");
+        // The key of a dependent therefore needs no hashing of the stored output.
+        let value = OsString::from(format!("dep={}", cache.outputs[0].display()));
+        assert_eq!(extern_arg(&value).unwrap(), format!("dep={}", hex(&expected)).into_bytes());
+    }
+
+    #[test]
+    fn restored_outputs_prime_the_extern_hash_memo() {
+        let (tmp, store) = fixture();
+        let cache = unit_cache(tmp.path(), "a", &store);
+        let cmd = command(&cache);
+        populate(&cache, &cmd, &[], &[]);
+        remove_outputs(&cache);
+        assert!(is_hit(&cache.lookup(&cmd)));
+        let expected = *blake3::hash(b"rlib-bytes").as_bytes();
+        overwrite_keeping_size_and_mtime(&cache.outputs[0]);
+        assert_eq!(cached_hash(&cache.outputs[0]).unwrap(), expected, "answered without reading");
+        // A real change is still noticed: the memo is keyed by size and mtime.
+        fs::write(&cache.outputs[0], b"a different length entirely").unwrap();
+        assert_eq!(cached_hash(&cache.outputs[0]).unwrap(), *blake3::hash(b"a different length entirely").as_bytes());
+    }
+
+    #[test]
+    fn restored_outputs_carry_the_supplied_stamp_not_the_current_time() {
+        let (tmp, store) = fixture();
+        let cache = unit_cache(tmp.path(), "a", &store);
+        let cmd = command(&cache);
+        populate(&cache, &cmd, &[], &[]);
+        remove_outputs(&cache);
+        // The invocation timestamp of a unit is earlier than the moment its restore runs.
+        let stamp = FileTime::from_unix_time(now_unix() as i64 - 3600, 0);
+        assert!(is_hit(&cache.lookup_at(&cmd, stamp)));
+        for path in cache.outputs.iter().chain([&cache.dep_info]) {
+            let mtime = FileTime::from_last_modification_time(&fs::metadata(path).unwrap());
+            assert_eq!(mtime, stamp, "{}", path.display());
+        }
+        // Dependents hash the restored files from the memo, keyed by the stamped mtime.
+        let expected = *blake3::hash(b"rlib-bytes").as_bytes();
+        overwrite_keeping_size_and_mtime(&cache.outputs[0]);
+        assert_eq!(cached_hash(&cache.outputs[0]).unwrap(), expected);
+    }
+
+    #[test]
+    fn restored_outputs_are_never_newer_than_a_later_stamp() {
+        let (tmp, store) = fixture();
+        let cache = unit_cache(tmp.path(), "a", &store);
+        let cmd = command(&cache);
+        populate(&cache, &cmd, &[], &[]);
+        // Cargo's stamps lag the fine clock by up to a few milliseconds; a dependent stamped
+        // after this unit's stamp must never see an older unit's output as newer than itself.
+        remove_outputs(&cache);
+        let unit_stamp = FileTime::from_unix_time(now_unix() as i64 - 5, 0);
+        let dependent_stamp = FileTime::from_unix_time(now_unix() as i64 - 5, 0);
+        assert!(is_hit(&cache.lookup_at(&cmd, unit_stamp)));
+        let mtime = FileTime::from_last_modification_time(&fs::metadata(&cache.outputs[0]).unwrap());
+        assert!(mtime <= dependent_stamp, "equal counts as fresh in Cargo's checks");
+    }
+
+    #[test]
+    fn statistics_line_reports_every_counter() {
+        let stats = Stats::default();
+        let set = |counter: &AtomicU64, value: u64| counter.store(value, Ordering::Relaxed);
+        set(&stats.key_ns, 12_000_000);
+        set(&stats.extern_ns, 3_000_000);
+        set(&stats.store_hash_ns, 4_000_000);
+        set(&stats.store_write_ns, 5_000_000);
+        set(&stats.restore_ns, 6_000_000);
+        set(&stats.hashed_bytes, 3 << 20);
+        set(&stats.written_bytes, 1 << 20);
+        set(&stats.native_ns, 7_000_000);
+        set(&stats.store_manifest_ns, 8_000_000);
+        set(&stats.miss_ns, 9_999_999);
+        assert_eq!(
+            stats.line(),
+            "stats key=12 extern_hash=3 store_hash=4 store_write=5 restore=6 hashed=3.0 written=1.0 \
+             native_hash=7 store_manifest=8 miss=9"
+        );
+        // Statistics are off unless the store opened with debugging on, and then cost nothing.
+        assert!(stat_start().is_none());
+    }
+}
