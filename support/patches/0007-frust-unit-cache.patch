+    fn assert_tree_stamped(path: &Path, stamp: FileTime) {
+        let meta = fs::symlink_metadata(path).unwrap();
+        assert_eq!(FileTime::from_last_modification_time(&meta), stamp, "{}", path.display());
+        if meta.is_dir() {
+            for item in fs::read_dir(path).unwrap().flatten() {
+                assert_tree_stamped(&item.path(), stamp);
+            }
+        }
+    }
+
+    #[test]
+    fn restored_tree_carries_the_supplied_stamp_not_the_current_time() {
+        let (tmp, store) = fixture();
+        let cache = script_cache(tmp.path(), "a", &store);
+        let bin = program(tmp.path(), "script v1");
+        let cmd = command(&cache, &bin);
+        run_and_store(&cache, &cmd);
+        clear_dir(&cache.out_dir).unwrap();
+        // The script's invocation timestamp is earlier than the moment its restore runs.
+        let stamp = FileTime::from_unix_time(now_unix() as i64 - 3600, 0);
+        assert!(is_hit(&cache.lookup_at(&cmd, stamp)));
+        assert_tree_stamped(&cache.out_dir, stamp);
+        // Files, a nested empty directory and both symlinks were all covered by the walk.
+        assert!(cache.out_dir.join("empty").is_dir());
+        assert!(fs::symlink_metadata(cache.out_dir.join("sub").join("link")).unwrap().file_type().is_symlink());
+    }
+
+    #[test]
+    fn make_flags_lose_only_parallelism() {
+        assert_eq!(strip_make_flags("-j8 --jobserver-auth=3,4 -k"), "-k");
+        assert_eq!(strip_make_flags("w --jobserver-fds=3,4 -j -- A=1"), "w -- A=1");
+        assert_eq!(strip_make_flags("-j 4 -s"), "-s");
+        assert_eq!(strip_make_flags("--jobs=3 -i"), "-i");
+        assert_eq!(strip_make_flags("--jobs 6 --jobserver-style=pipe --sync-x"), "");
+        assert_eq!(strip_make_flags(" -jx -k"), "-jx -k", "only numeric job counts are job flags");
+        assert_eq!(strip_make_flags(""), "");
+    }
+
+    #[test]
+    fn key_keeps_make_flags_except_job_counts() {
+        let (tmp, store) = fixture();
+        let cache = script_cache(tmp.path(), "a", &store);
+        let bin = program(tmp.path(), "script v1");
+        let with = |makeflags: &str, mflags: &str| {
+            let mut cmd = command(&cache, &bin);
+            cmd.env("MAKEFLAGS", makeflags).env("MFLAGS", mflags);
+            key_of(&cache, &cmd)
+        };
+        let none = with("", "");
+        assert_eq!(none, with(" -j8 --jobserver-auth=3,4", "-j8"), "job parts do not matter");
+        assert_eq!(with("-j2 -k", ""), with("-j16 --jobserver-fds=7,8 -k", ""));
+        assert_ne!(none, with("-k", ""), "other make flags reach the inner make");
+        assert_ne!(with("-k", ""), with("-s", ""));
+        assert_ne!(none, with("", "-i"));
+        let mut cmd = command(&cache, &bin);
+        cmd.env("MAKEFLAGS", "").env("MFLAGS", "").env("CARGO_MAKEFLAGS", "-j9 --jobserver-auth=1,2");
+        assert_eq!(none, key_of(&cache, &cmd));
+    }
+
+    #[test]
+    fn key_covers_upstream_script_output() {
+        let (tmp, store) = fixture();
+        let mut cache = script_cache(tmp.path(), "a", &store);
+        let upstream = tmp.path().join("upstream-output");
+        cache.dep_outputs = vec![upstream.clone()];
+        let bin = program(tmp.path(), "script v1");
+        let cmd = command(&cache, &bin);
+        let missing = key_of(&cache, &cmd);
+        fs::write(&upstream, "cargo:probe=1\n").unwrap();
+        let first = key_of(&cache, &cmd);
+        assert_ne!(missing, first);
+        assert_eq!(first, key_of(&cache, &cmd));
+        fs::write(&upstream, "cargo:probe=2\n").unwrap();
+        assert_ne!(first, key_of(&cache, &cmd));
+        cache.dep_outputs.clear();
+        assert_ne!(first, key_of(&cache, &cmd), "the dependency set is part of the key");
+    }
+}
