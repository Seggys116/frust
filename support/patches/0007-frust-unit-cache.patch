+    /// A script run of package `heavy` inside `<tmp>/<project>/target`, in the per-unit layout
+    /// `debug/build/heavy/<unit-hash>/out`; the package source and the script binary are shared
+    /// between projects.
+    fn script_cache(tmp: &Path, project: &str, store: &Arc<Store>) -> ScriptCache {
+        let build = tmp.join(project).join("target");
+        let out = build
+            .join("debug")
+            .join("build")
+            .join("heavy")
+            .join("abc0123456789def")
+            .join("out");
+        fs::create_dir_all(&out).unwrap();
+        let pkg_root = tmp.join("registry").join("heavy-1.0.0");
+        fs::create_dir_all(&pkg_root).unwrap();
+        fs::create_dir_all(tmp.join("bin")).unwrap();
+        ScriptCache {
+            store: Arc::clone(store),
+            crate_name: "heavy".to_string(),
+            package: "heavy 1.0.0\nregistry\nchecksum".to_string(),
+            pkg_root_canonical: fs::canonicalize(&pkg_root).ok(),
+            pkg_root,
+            build_dir: build,
+            out_dir: out,
+            toolchain: ToolchainInputs {
+                verbose_version: "rustc 1.0.0 (test)".to_string(),
+                sysroot: tmp.join("sysroot"),
+                lib_dirs: Vec::new(),
+            },
+            min_ms: 0,
+            max_tree_bytes: MAX_TREE_BYTES,
+            dep_outputs: Vec::new(),
+        }
+    }
+
+    fn program(tmp: &Path, body: &str) -> PathBuf {
+        let path = tmp.join("registry").join("build-script-main");
+        fs::create_dir_all(path.parent().unwrap()).unwrap();
+        fs::write(&path, body).unwrap();
+        path
+    }
+
+    fn command(cache: &ScriptCache, program: &Path) -> ProcessBuilder {
+        let mut cmd = ProcessBuilder::new(program);
+        cmd.cwd(&cache.pkg_root);
+        cmd.env("OUT_DIR", &cache.out_dir);
+        // An explicit PATH keeps tool resolution independent of the machine.
+        cmd.env("PATH", cache.pkg_root.parent().unwrap().parent().unwrap().join("bin"));
+        cmd.env("TARGET", "x86_64-unknown-linux-gnu");
+        cmd
+    }
+
+    fn miss(cache: &ScriptCache, cmd: &ProcessBuilder) -> ScriptPending {
+        let ScriptLookup::Miss(pending) = cache.lookup(cmd) else { panic!("expected a miss") };
+        pending
+    }
+
+    fn is_hit(lookup: &ScriptLookup) -> bool {
+        matches!(lookup, ScriptLookup::Hit { .. })
+    }
+
+    fn key_of(cache: &ScriptCache, cmd: &ProcessBuilder) -> String {
+        cache.compute_key(cmd).unwrap()
+    }
+
+    /// Fills OUT_DIR like a script with nested directories, an executable, an empty directory
+    /// and relative symlinks would.
+    fn write_tree(out: &Path) {
+        fs::write(out.join("gen.rs"), "pub const X: u32 = 1;").unwrap();
+        fs::create_dir_all(out.join("sub").join("deeper")).unwrap();
+        fs::write(out.join("sub").join("data.txt"), "data").unwrap();
+        fs::create_dir(out.join("empty")).unwrap();
+        let tool = out.join("sub").join("tool.sh");
+        fs::write(&tool, "#!/bin/sh\n").unwrap();
+        fs::set_permissions(&tool, fs::Permissions::from_mode(0o755)).unwrap();
+        symlink("data.txt", out.join("sub").join("link")).unwrap();
+        symlink("../gen.rs", out.join("sub").join("up")).unwrap();
+    }
+
+    fn run_and_store(cache: &ScriptCache, cmd: &ProcessBuilder) -> String {
+        let pending = miss(cache, cmd);
+        write_tree(&cache.out_dir);
+        cache.store(&pending, OUT, ERR);
+        pending.key
+    }
+
+    fn read_entry(store: &Store, key: &str) -> ScriptEntry {
+        serde_json::from_slice(&fs::read(store.entry_dir(key).join(MANIFEST)).unwrap()).unwrap()
+    }
+
+    fn skip_reason(result: Result<Option<u64>, ScriptSkip>) -> Option<&'static str> {
+        match result {
+            Err(ScriptSkip::Reason(reason)) => Some(reason),
+            _ => None,
+        }
+    }
