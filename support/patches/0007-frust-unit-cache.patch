index 0000000..ce74fea
--- /dev/null
+++ b/src/frust_script_cache.rs
@@ -0,0 +1,2052 @@
+//! Build script run cache, the second kind of entry in the unit cache store.
+//!
+//! A successful, slow, warning-free run of a registry or git build script is stored as its
+//! `stdout`, `stderr` and the whole OUT_DIR tree. A later run with an identical key (program,
+//! arguments, complete environment, tool identity) restores the tree and returns the stored
+//! output instead of spawning the script. Entries are bound to the build directory path because
+//! OUT_DIR and its parent are part of the environment and are not normalized.
+
+use super::*;
+use std::time::Instant;
+
+pub(super) const KIND: &str = "build-script";
+const SCRIPT_SCHEMA: &str = "frust-build-script-v1";
+const DEFAULT_MIN_MS: u64 = 3000;
+const MAX_TREE_BYTES: u64 = 2 << 30;
+/// Recorded for a `rerun-if-changed` path that did not exist when the script ran.
+const ABSENT: &str = "absent";
+
+/// Variables that differ between invocations without changing what a script does.
+const ENV_DENY: &[&str] = &[
+    "_",
+    "SHLVL",
+    "OLDPWD",
+    "PWD",
+    "CARGO_MAKEFLAGS",
+    "COLUMNS",
+    "LINES",
+    "LS_COLORS",
+];
+const TOOLS: &[&str] = &[
+    "cc",
+    "gcc",
+    "c++",
+    "g++",
+    "clang",
+    "clang++",
+    "ar",
+    "ranlib",
+    "ld",
+    "lld",
+    "ld.lld",
+    "make",
+    "gmake",
+    "cmake",
+    "ninja",
+    "perl",
+    "python3",
+    "pkg-config",
+    "sh",
+    "as",
+    "nasm",
+    "yasm",
+];
+/// Variables naming a tool as their first word (CFLAGS-style variables are covered by the
+/// environment itself and need no resolution).
+const TOOL_VARS: &[&str] = &[
+    "CC",
+    "CXX",
+    "AR",
+    "LD",
+    "CMAKE",
+    "MAKE",
+    "RANLIB",
+    "TARGET_CC",
+    "TARGET_CXX",
+    "TARGET_AR",
+    "TARGET_RANLIB",
+    "HOST_CC",
+    "HOST_CXX",
+    "HOST_AR",
+];
+/// Per-target tool variables, spelled with the triple in underscore and hyphenated form.
+const TARGET_TOOL_VARS: &[&str] = &["CC", "CXX", "AR", "RANLIB"];
+/// cc-rs style target-prefixed tools looked up on PATH.
+const TARGET_TOOL_SUFFIXES: &[&str] = &["gcc", "g++", "ar", "ranlib"];
+const MACOS_DIRS: &[&str] = &["/Library/Developer/CommandLineTools", "/opt/homebrew/include", "/opt/homebrew/lib"];
+/// Files Cargo writes in a script's run directory itself.
+const RUN_DIR_FILES: &[&str] = &["out", "output", "stderr", "root-output", "invoked.timestamp"];
+/// Entries Cargo creates in the profile directory.
+const PROFILE_DIR_ENTRIES: &[&str] = &[
+    "build",
+    "deps",
+    ".fingerprint",
+    "examples",
+    "incremental",
+    ".cargo-lock",
+    "CACHEDIR.TAG",
+    ".rustc_info.json",
+];
+/// Directives Cargo reports to the user; a run that printed any is never cached.
+const NOISY_PREFIXES: &[&str] = &["cargo:warning=", "cargo::warning=", "cargo::error="];
+
+#[derive(Serialize, Deserialize, Clone, Debug, PartialEq)]
+struct TreeNode {
+    /// Path relative to OUT_DIR.
+    path: String,
+    /// `file`, `dir` or `symlink`.
+    kind: String,
+    mode: u32,
+    size: u64,
+    blake3: Option<String>,
+    target: Option<String>,
+}
+
+#[derive(Serialize, Deserialize, Clone, Debug, PartialEq)]
+pub(super) struct ScriptEntry {
+    schema: u32,
+    kind: String,
+    key: String,
+    toolchain_id: String,
+    stdout: Blob,
+    stderr: Blob,
+    files: Vec<TreeNode>,
+    file_deps: Vec<FileDep>,
+    bound_dir: Option<String>,
+    created_unix: u64,
+}
+
+impl ScriptEntry {
+    /// Paths and hashes become file names inside the store and OUT_DIR, so a damaged manifest
+    /// must not smuggle separators, parent references or escaping symlinks.
+    pub(super) fn names_valid(&self) -> bool {
+        is_hex64(&self.key)
+            && is_hex64(&self.stdout.blake3)
+            && is_hex64(&self.stderr.blake3)
+            && self.files.iter().all(node_valid)
+            && tree_is_well_formed(&self.files)
+    }
+
+    /// Every distinct stored content: the two streams and each file.
+    pub(super) fn blobs(&self) -> Vec<Blob> {
+        let files = self.files.iter().filter_map(|node| {
+            let blake3 = node.blake3.clone()?;
+            Some(Blob { name: "file".to_string(), size: node.size, blake3 })
+        });
+        [self.stdout.clone(), self.stderr.clone()].into_iter().chain(files).collect()
+    }
+
+    pub(super) fn size(&self) -> u64 {
+        let mut seen = HashSet::default();
+        self.blobs().into_iter().filter(|blob| seen.insert(blob.blake3.clone())).map(|b| b.size).sum()
+    }
+}
+
+fn node_valid(node: &TreeNode) -> bool {
+    if !path_safe(&node.path) {
+        return false;
+    }
+    match node.kind.as_str() {
+        "dir" => node.blake3.is_none() && node.target.is_none(),
+        "file" => node.blake3.as_deref().is_some_and(is_hex64) && node.target.is_none(),
+        "symlink" => {
+            node.blake3.is_none()
+                && node.target.as_deref().is_some_and(|target| symlink_target_safe(&node.path, target))
+        }
+        _ => false,
+    }
+}
+
+/// Every node's parent must be OUT_DIR or a `dir` node listed earlier, and paths are unique. A
+/// symlink can therefore never be an ancestor of another node, so restoring in order cannot be
+/// steered through a link to somewhere else.
+fn tree_is_well_formed(nodes: &[TreeNode]) -> bool {
+    let mut seen: HashSet<&str> = HashSet::default();
+    let mut dirs: HashSet<&str> = HashSet::default();
+    for node in nodes {
+        let parent = Path::new(&node.path).parent().and_then(Path::to_str).unwrap_or("");
+        if !parent.is_empty() && !dirs.contains(parent) {
+            return false;
+        }
+        if !seen.insert(node.path.as_str()) {
+            return false;
+        }
+        if node.kind == "dir" {
+            dirs.insert(node.path.as_str());
+        }
+    }
+    true
+}
+
+/// A non-empty relative path made of plain components only.
+fn path_safe(path: &str) -> bool {
+    !path.is_empty()
+        && !path.contains('\0')
+        && Path::new(path).components().all(|part| matches!(part, std::path::Component::Normal(_)))
+}
+
+/// A relative symlink target that stays inside OUT_DIR when resolved from the link's directory.
+fn symlink_target_safe(link: &str, target: &str) -> bool {
+    use std::path::Component;
+    if target.is_empty() || target.contains('\0') {
+        return false;
+    }
+    let mut depth = Path::new(link).components().count().saturating_sub(1);
+    for part in Path::new(target).components() {
+        match part {
+            Component::Normal(_) => depth += 1,
+            Component::CurDir => {}
+            Component::ParentDir if depth > 0 => depth -= 1,
+            _ => return false,
+        }
+    }
+    true
+}
+
+enum ScriptSkip {
+    Reason(&'static str),
+    Io(io::Error),
+}
+
+impl From<io::Error> for ScriptSkip {
+    fn from(err: io::Error) -> ScriptSkip {
+        ScriptSkip::Io(err)
+    }
+}
+
+pub(crate) struct ScriptCache {
+    store: Arc<Store>,
+    crate_name: String,
+    package: String,
+    pkg_root: PathBuf,
+    pkg_root_canonical: Option<PathBuf>,
+    build_dir: PathBuf,
+    out_dir: PathBuf,
+    toolchain: ToolchainInputs,
+    /// Runs shorter than this are cheaper to repeat than to store.
+    min_ms: u64,
+    max_tree_bytes: u64,
+    /// `output` files of the build script runs this one depends on, in dependency order. Their
+    /// content reaches this script through `DEP_*` variables and so belongs in the key.
+    dep_outputs: Vec<PathBuf>,
+}
+
+/// Names, sizes and mtimes of directory entries, keyed by path.
+type Snapshot = BTreeMap<PathBuf, (u64, u128)>;
+
+#[derive(Debug)]
+pub(crate) enum ScriptLookup {
+    /// OUT_DIR was restored; these are the bytes the process would have returned.
+    Hit { stdout: Vec<u8>, stderr: Vec<u8> },
+    /// Run the script, then hand the pending key to `ScriptCache::store` if it succeeded.
+    Miss(ScriptPending),
+    Skip,
+}
+
+#[derive(Debug)]
+pub(crate) struct ScriptPending {
+    key: String,
+    /// Taken when the miss was decided, right before the script is spawned.
+    started: Instant,
+    /// A run that started from leftovers may depend on them, so only clean starts are stored.
+    out_dir_was_empty: bool,
+    /// What lived next to OUT_DIR before the run; `None` when the directory layout is not the
+    /// one the snapshot understands.
+    outside: Option<Snapshot>,
+}
+
+impl ScriptCache {
+    /// Returns `None` when the cache is disabled or the unit is not a cacheable build script run.
+    pub(crate) fn for_unit(
+        build_runner: &BuildRunner<'_, '_>,
+        unit: &Unit,
+        out_dir: &Path,
+        dep_outputs: Vec<PathBuf>,
+    ) -> Option<ScriptCache> {
+        if !unit.mode.is_run_custom_build() {
+            return None;
+        }
+        let store = shared_store()?;
+        let crate_name = unit.pkg.name().to_string();
+        let skip = |reason: &str| -> Option<ScriptCache> {
+            store.log(format_args!("script-skip {crate_name} {reason}"));
+            None
+        };
+        if unit.is_std {
+            return skip("build-std");
+        }
+        if unit.is_local() {
+            return skip("local-package");
+        }
+        if out_dir.to_str().is_none() {
+            return skip("out-dir-not-utf8");
+        }
+        let package = match package_key(unit) {
+            Ok(package) => package,
+            Err(reason) => return skip(reason),
+        };
+        let bcx = build_runner.bcx;
+        let pkg_root = unit.pkg.root().to_path_buf();
+        let min_ms = std::env::var("FRUST_UNIT_CACHE_SCRIPT_MIN_MS")
+            .ok()
+            .and_then(|value| value.trim().parse::<u64>().ok())
+            .unwrap_or(DEFAULT_MIN_MS);
+        Some(ScriptCache {
+            store: Arc::clone(&store),
+            crate_name: crate_name.clone(),
+            package,
+            pkg_root_canonical: fs::canonicalize(&pkg_root).ok(),
+            pkg_root,
+            build_dir: bcx.ws.build_dir().into_path_unlocked(),
+            out_dir: out_dir.to_path_buf(),
+            toolchain: toolchain_inputs(bcx, unit.kind),
+            min_ms,
+            max_tree_bytes: MAX_TREE_BYTES,
+            dep_outputs,
+        })
+    }
+
+    /// Restores a verified entry in place of running the script, or reports why not.
+    ///
+    /// Restored files and directories are stamped `stamp`, the script's own invocation timestamp
+    /// taken before this call, never the fine-grained current time: Cargo's stamps come from the
+    /// kernel's coarse clock, and an OUT_DIR file newer than a dependent's stamp would make the
+    /// dependent stale on every later build. Equal mtimes count as fresh in Cargo's checks.
+    pub(crate) fn lookup_at(&self, cmd: &ProcessBuilder, stamp: FileTime) -> ScriptLookup {
+        let key = match self.compute_key(cmd) {
+            Ok(key) => key,
+            Err(reason) => {
+                self.note_skip(reason);
+                return ScriptLookup::Skip;
+            }
+        };
+        match self.try_restore_at(&key, stamp) {
+            Ok((stdout, stderr)) => {
+                self.store.log(format_args!("script-hit {} {}", short(&key), self.crate_name));
+                ScriptLookup::Hit { stdout, stderr }
+            }
+            Err(fail) => {
+                let reason = match fail {
+                    Fail::Reason(reason) => reason,
+                    Fail::Corrupt(reason) => {
+                        self.store.remove_entry(&key);
+                        reason
+                    }
+                };
+                self.store
+                    .log(format_args!("script-miss {} {} {reason}", short(&key), self.crate_name));
+                ScriptLookup::Miss(ScriptPending {
+                    key,
+                    started: Instant::now(),
+                    out_dir_was_empty: dir_is_empty(&self.out_dir),
+                    outside: snapshot_outside(&self.out_dir),
+                })
+            }
+        }
+    }
+
+    /// Tests that do not care about mtimes restore as of now.
+    #[cfg(test)]
+    fn lookup(&self, cmd: &ProcessBuilder) -> ScriptLookup {
+        self.lookup_at(cmd, FileTime::now())
+    }
+
+    #[cfg(test)]
+    fn try_restore(&self, key: &str) -> Result<(Vec<u8>, Vec<u8>), Fail> {
+        self.try_restore_at(key, FileTime::now())
+    }
+
+    pub(crate) fn note_skip(&self, reason: &str) {
+        self.store.log(format_args!("script-skip {} {reason}", self.crate_name));
+    }
+
+    /// Best effort: failures are logged and never fail the build.
+    pub(crate) fn store(&self, pending: &ScriptPending, stdout: &[u8], stderr: &[u8]) {
+        match self.try_store(pending, stdout, stderr) {
+            Ok(Some(bytes)) => {
+                self.store.log(format_args!("script-store {} {}", short(&pending.key), self.crate_name));
+                self.store.note_stored(bytes);
+            }
+            Ok(None) => {}
+            Err(ScriptSkip::Reason(reason)) => self.note_skip(reason),
+            Err(ScriptSkip::Io(err)) => {
+                tracing::debug!("fRust script cache could not store {}: {err}", self.crate_name);
+                self.note_skip(&format!("store-failed: {err}"));
+            }
+        }
+    }
+
+    fn try_store(
+        &self,
+        pending: &ScriptPending,
+        stdout: &[u8],
+        stderr: &[u8],
+    ) -> Result<Option<u64>, ScriptSkip> {
+        if pending.started.elapsed().as_millis() < u128::from(self.min_ms) {
+            return Err(ScriptSkip::Reason("too-fast"));
+        }
+        if !pending.out_dir_was_empty {
+            return Err(ScriptSkip::Reason("out-dir-not-empty"));
+        }
+        if stdout_is_noisy(stdout) {
+            return Err(ScriptSkip::Reason("warnings"));
+        }
+        // Whatever a script writes outside OUT_DIR would be lost on a hit.
+        let unchanged = pending
+            .outside
+            .as_ref()
+            .is_some_and(|before| snapshot_outside(&self.out_dir).as_ref() == Some(before));
+        if !unchanged {
+            if let (Some(before), Some(after)) = (&pending.outside, snapshot_outside(&self.out_dir)) {
+                let moved = before.keys().chain(after.keys()).find(|path| before.get(*path) != after.get(*path));
+                self.store.log(format_args!(
+                    "script-note {} changed outside OUT_DIR: {}",
+                    self.crate_name,
+                    moved.map(|path| path.display().to_string()).unwrap_or_default()
+                ));
+            }
+            return Err(ScriptSkip::Reason("writes-outside-out-dir"));
+        }
+        let tree = capture_tree(&self.out_dir, self.max_tree_bytes)?;
+        let file_deps = self.rerun_deps(stdout)?;
+        let toolchain = toolchain_id(&self.toolchain);
+        let bound_dir = self.build_dir.to_str().map(str::to_string);
+        let size = self.store.commit_entry(&pending.key, |entry_dir| {
+            let stdout = put_blob(entry_dir, "stdout", stdout)?;
+            let stderr = put_blob(entry_dir, "stderr", stderr)?;
+            let mut files = Vec::with_capacity(tree.len());
+            for node in &tree {
+                files.push(node.record(entry_dir)?);
+            }
+            let entry = ScriptEntry {
+                schema: MANIFEST_SCHEMA,
+                kind: KIND.to_string(),
+                key: pending.key.clone(),
+                toolchain_id: toolchain,
+                stdout,
+                stderr,
+                files,
+                file_deps,
+                bound_dir,
+                created_unix: now_unix(),
+            };
+            let json = serde_json::to_vec(&entry).map_err(io::Error::other)?;
+            // Committed last so readers never see an entry without its blobs.
+            let temp = entry_dir.join(temp_name("tmp-"));
+            fs::write(&temp, &json)?;
+            fs::rename(&temp, entry_dir.join(MANIFEST))?;
+            Ok(entry.size())
+        })?;
+        Ok(size)
+    }
+
+    /// Files outside the package and OUT_DIR named by `rerun-if-changed` keep the entry honest:
+    /// their content is re-verified at every hit.
+    fn rerun_deps(&self, stdout: &[u8]) -> Result<Vec<FileDep>, ScriptSkip> {
+        let mut deps = Vec::new();
+        for path in rerun_paths(stdout) {
+            let abs = self.pkg_root.join(&path);
+            if self.in_package(&abs) || abs.starts_with(&self.out_dir) {
+                continue;
+            }
+            let text = abs.to_str().ok_or(ScriptSkip::Reason("dep-not-utf8"))?.to_string();
+            match fs::metadata(&abs) {
+                Ok(meta) if meta.is_file() => {
+                    let (_, hash) = hash_file(&abs)?;
+                    deps.push(FileDep { path: text, blake3: hex(&hash) });
+                }
+                Ok(_) => return Err(ScriptSkip::Reason("rerun-dir")),
+                Err(err) if err.kind() == io::ErrorKind::NotFound => {
+                    deps.push(FileDep { path: text, blake3: ABSENT.to_string() });
+                }
+                Err(err) => return Err(err.into()),
+            }
+        }
+        deps.sort_by(|a, b| a.path.cmp(&b.path));
+        deps.dedup_by(|a, b| a.path == b.path);
+        Ok(deps)
+    }
+
+    fn in_package(&self, path: &Path) -> bool {
+        path.starts_with(&self.pkg_root)
+            || match (&self.pkg_root_canonical, fs::canonicalize(path)) {
+                (Some(root), Ok(real)) => real.starts_with(root),
+                _ => false,
+            }
+    }
+
+    fn compute_key(&self, cmd: &ProcessBuilder) -> Result<String, &'static str> {
+        let program = cached_hash(Path::new(cmd.get_program())).map_err(|_| "program-unreadable")?;
+        let cwd = cmd
+            .get_cwd()
+            .map(Path::to_path_buf)
+            .or_else(|| std::env::current_dir().ok())
+            .unwrap_or_default();
+        let mut hasher = KeyHasher::with_schema(SCRIPT_SCHEMA);
+        hasher.field("schema", SCRIPT_SCHEMA.as_bytes());
+        hasher.field("toolchain", toolchain_id(&self.toolchain).as_bytes());
+        hasher.field("package", self.package.as_bytes());
+        hasher.field("program", &program);
+        let args: Vec<&OsString> = cmd.get_args().collect();
+        hasher.field("argc", &(args.len() as u64).to_le_bytes());
+        for arg in args {
+            hasher.field("arg", arg.as_encoded_bytes());
+        }
+        hasher.field("cwd", cwd.as_os_str().as_encoded_bytes());
+        for (name, value) in child_env(cmd) {
+            let mut data = name;
+            data.push(0);
+            data.extend(value);
+            hasher.field("env", &data);
+        }
+        hasher.field("tools", &tool_identity(cmd, &cwd));
+        hasher.field("system-dirs", &system_dirs_identity(cmd));
+        // Upstream script results arrive as DEP_* values; their full output is a key input.
+        for path in &self.dep_outputs {
+            let digest = match hash_file(path) {
+                Ok((_, hash)) => hex(&hash),
+                Err(_) => ABSENT.to_string(),
+            };
+            hasher.field("dep-output", digest.as_bytes());
+        }
+        Ok(hasher.finish())
+    }
+
+    /// Whether a library search path or link argument from the stored output points at a file
+    /// or directory inside the build directory (outside OUT_DIR) that is no longer there.
+    fn outputs_gone(&self, stdout: &[u8]) -> bool {
+        link_paths(stdout).iter().any(|text| {
+            let path = Path::new(text);
+            path.starts_with(&self.build_dir) && !path.starts_with(&self.out_dir) && !path.exists()
+        })
+    }
+
+    fn try_restore_at(&self, key: &str, stamp: FileTime) -> Result<(Vec<u8>, Vec<u8>), Fail> {
+        let entry_dir = self.store.entry_dir(key);
+        let manifest_path = entry_dir.join(MANIFEST);
+        if !manifest_path.is_file() {
+            return Err(Fail::Reason("no-entry"));
+        }
+        // Same locking rule as unit entries: a store that cannot hold a lock file is read-only.
+        let _lock = match try_lock(&self.store.lock_path(key), LockMode::Shared) {
+            Ok(Some(lock)) => Some(lock),
+            Ok(None) => return Err(Fail::Reason("locked")),
+            Err(_) => None,
+        };
+        let bytes = fs::read(&manifest_path).map_err(|_| Fail::Reason("no-entry"))?;
+        let entry: ScriptEntry =
+            serde_json::from_slice(&bytes).map_err(|_| Fail::Corrupt("manifest-unparsable"))?;
+        if entry.schema != MANIFEST_SCHEMA
+            || entry.kind != KIND
+            || entry.key != key
+            || !entry.names_valid()
+        {
+            return Err(Fail::Corrupt("manifest-invalid"));
+        }
+        if let Some(bound) = &entry.bound_dir {
+            if self.build_dir.to_str() != Some(bound.as_str()) {
+                return Err(Fail::Reason("bound-dir"));
+            }
+        }
+        if !verify_rerun_deps(&entry.file_deps) {
+            return Err(Fail::Reason("file-dep"));
+        }
+        verify_blob_list(&entry_dir, entry.blobs().iter())?;
+        let read = |blob: &Blob| fs::read(entry_dir.join(&blob.blake3));
+        let (stdout, stderr) = match (read(&entry.stdout), read(&entry.stderr)) {
+            (Ok(stdout), Ok(stderr)) => (stdout, stderr),
+            _ => return Err(Fail::Corrupt("blob-unreadable")),
+        };
+        if self.outputs_gone(&stdout) {
+            return Err(Fail::Reason("stale-outputs"));
+        }
+        if restore_tree(&entry_dir, &entry.files, &self.out_dir, stamp).is_err() {
+            let _ = clear_dir(&self.out_dir);
+            return Err(Fail::Reason("restore-failed"));
+        }
+        // Recency stamp; blobs are never touched.
+        let _ = filetime::set_file_mtime(manifest_path, FileTime::now());
+        Ok((stdout, stderr))
+    }
+}
+
+/// Whether `stdout` carries a directive Cargo would show the user.
+fn stdout_is_noisy(stdout: &[u8]) -> bool {
+    String::from_utf8_lossy(stdout)
+        .lines()
+        .map(str::trim)
+        .any(|line| NOISY_PREFIXES.iter().any(|prefix| line.starts_with(prefix)))
+}
+
+/// Paths named by `cargo:rerun-if-changed=` / `cargo::rerun-if-changed=` lines.
+fn rerun_paths(stdout: &[u8]) -> Vec<String> {
+    String::from_utf8_lossy(stdout)
+        .lines()
+        .filter_map(|line| {
+            let line = line.trim();
+            let rest = line.strip_prefix("cargo::").or_else(|| line.strip_prefix("cargo:"))?;
+            rest.strip_prefix("rerun-if-changed=").map(str::to_string)
+        })
+        .collect()
+}
+
+/// Absolute path candidates from `rustc-link-search` and `rustc-link-arg*` directives, found by
+/// splitting each value at `,` and `=` (`native=/p`, `-Wl,-rpath,/p`, `-L/p`).
+fn link_paths(stdout: &[u8]) -> Vec<String> {
+    let mut paths = Vec::new();
+    for line in String::from_utf8_lossy(stdout).lines() {
+        let line = line.trim();
+        let Some(rest) = line.strip_prefix("cargo::").or_else(|| line.strip_prefix("cargo:")) else {
+            continue;
+        };
+        let Some((directive, value)) = rest.split_once('=') else { continue };
+        if directive != "rustc-link-search" && !directive.starts_with("rustc-link-arg") {
+            continue;
+        }
+        for piece in value.split([',', '=']) {
+            let piece = piece.strip_prefix("-L").unwrap_or(piece);
+            if Path::new(piece).is_absolute() {
+                paths.push(piece.to_string());
+            }
+        }
+    }
+    paths
+}
+
+fn verify_rerun_deps(deps: &[FileDep]) -> bool {
+    deps.iter().all(|dep| {
+        let path = Path::new(&dep.path);
+        if dep.blake3 == ABSENT {
+            return !path.exists();
+        }
+        hash_file(path).is_ok_and(|(_, hash)| hex(&hash) == dep.blake3)
+    })
+}
+
+/// The environment the script will see: the process environment overlaid with what Cargo set
+/// (an explicit removal wins), minus the variables that never matter.
+fn child_env(cmd: &ProcessBuilder) -> BTreeMap<Vec<u8>, Vec<u8>> {
+    let mut env: BTreeMap<Vec<u8>, Vec<u8>> = std::env::vars_os()
+        .map(|(name, value)| (name.as_encoded_bytes().to_vec(), value.as_encoded_bytes().to_vec()))
+        .collect();
+    for (name, value) in cmd.get_envs() {
+        match value {
+            Some(value) => env.insert(name.as_bytes().to_vec(), value.as_encoded_bytes().to_vec()),
+            None => env.remove(name.as_bytes()),
+        };
+    }
+    // make reads these in the script's children, so only the job-count parts are dropped.
+    for name in [&b"MAKEFLAGS"[..], &b"MFLAGS"[..]] {
+        let stripped = env.get(name).map(|value| strip_make_flags(&String::from_utf8_lossy(value)));
+        match stripped {
+            Some(flags) if flags.is_empty() => {
+                env.remove(name);
+            }
+            Some(flags) => {
+                env.insert(name.to_vec(), flags.into_bytes());
+            }
+            None => {}
+        }
+    }
+    env.retain(|name, _| !env_denied(name));
+    env
+}
+
+/// Removes the tokens that carry parallelism (`-j`, `--jobs`, jobserver descriptors) and keeps
+/// every other flag, such as `-i`, `-k` and `-s`.
+fn strip_make_flags(value: &str) -> String {
+    let numeric = |word: &str| !word.is_empty() && word.bytes().all(|byte| byte.is_ascii_digit());
+    let mut kept = Vec::new();
+    let mut words = value.split_whitespace().peekable();
+    while let Some(word) = words.next() {
+        if word == "-j" || word == "--jobs" {
+            // A separate job count belongs to the flag.
+            if words.peek().is_some_and(|next| numeric(next)) {
+                words.next();
+            }
+            continue;
+        }
+        let jobs = word.strip_prefix("-j").is_some_and(numeric)
+            || ["--jobs=", "--jobserver-auth=", "--jobserver-fds=", "--jobserver-style=", "--sync-"]
+                .iter()
+                .any(|prefix| word.starts_with(prefix));
+        if !jobs {
+            kept.push(word);
+        }
+    }
+    kept.join(" ")
+}
+
+/// The cache's own controls say nothing about what a script does.
+fn env_denied(name: &[u8]) -> bool {
+    ENV_DENY.iter().any(|denied| denied.as_bytes() == name) || name.starts_with(b"FRUST_UNIT_CACHE")
+}
+
+/// Canonical path, size and mtime of every compiler, build tool and shell a script may run,
+/// resolved on the child's PATH; absent tools are recorded as absent.
+fn tool_identity(cmd: &ProcessBuilder, cwd: &Path) -> Vec<u8> {
+    let path_var = cmd.get_env("PATH").unwrap_or_default();
+    let dirs: Vec<PathBuf> = std::env::split_paths(&path_var).collect();
+    let mut rows = Vec::new();
+    for name in TOOLS {
+        rows.push(format!("tool {name} {}\n", resolve_tool(name, &dirs, cwd)));
+    }
+    let target = cmd.get_env("TARGET").and_then(|target| target.into_string().ok());
+    for var in tool_env_names(target.as_deref()) {
+        let value = cmd.get_env(&var).and_then(|value| value.into_string().ok());
+        if let Some(tool) = value.as_deref().and_then(|value| value.split_whitespace().next()) {
+            rows.push(format!("var {var} {tool} {}\n", resolve_tool(tool, &dirs, cwd)));
+        }
+    }
+    // Cross builds find compilers by their triple prefix on PATH.
+    for name in target.iter().flat_map(|target| target_tool_names(target)) {
+        rows.push(format!("crosstool {name} {}\n", resolve_tool(&name, &dirs, cwd)));
+    }
+    rows.concat().into_bytes()
+}
+
+/// Variables whose first word names a tool: the plain ones and the per-target ones, with the
+/// triple spelled with underscores and with hyphens.
+fn tool_env_names(target: Option<&str>) -> Vec<String> {
+    let mut names: Vec<String> = TOOL_VARS.iter().map(|var| var.to_string()).collect();
+    if let Some(target) = target {
+        for form in [target.replace('-', "_"), target.to_string()] {
+            for var in TARGET_TOOL_VARS {
+                let name = format!("{var}_{form}");
+                if !names.contains(&name) {
+                    names.push(name);
+                }
+            }
+        }
+    }
+    names
+}
+
+/// Target-prefixed tool names on PATH: the full triple and, for `arch-vendor-os-env` triples,
+/// the vendorless form distributions use (`aarch64-unknown-linux-gnu` and `aarch64-linux-gnu`).
+fn target_tool_names(target: &str) -> Vec<String> {
+    let parts: Vec<&str> = target.split('-').collect();
+    let mut prefixes = vec![target.to_string()];
+    if parts.len() == 4 {
+        prefixes.push(format!("{}-{}-{}", parts[0], parts[2], parts[3]));
+    }
+    prefixes
+        .iter()
+        .flat_map(|prefix| TARGET_TOOL_SUFFIXES.iter().map(move |suffix| format!("{prefix}-{suffix}")))
+        .collect()
+}
+
+fn resolve_tool(tool: &str, dirs: &[PathBuf], cwd: &Path) -> String {
+    let found = if tool.contains('/') {
+        Some(cwd.join(tool)).filter(|path| path.is_file())
+    } else {
+        dirs.iter().map(|dir| dir.join(tool)).find(|path| path.is_file())
+    };
+    found.and_then(|path| file_identity(&path)).unwrap_or_else(|| ABSENT.to_string())
+}
+
+fn file_identity(path: &Path) -> Option<String> {
+    let canonical = fs::canonicalize(path).ok()?;
+    let meta = fs::metadata(&canonical).ok()?;
+    Some(format!("{}\0{}\0{}", canonical.display(), meta.len(), mtime_ns(&meta)))
+}
+
+fn mtime_ns(meta: &fs::Metadata) -> u128 {
+    meta.modified()
+        .ok()
+        .and_then(|time| time.duration_since(UNIX_EPOCH).ok())
+        .map_or(0, |elapsed| elapsed.as_nanos())
+}
+
+/// The system header and library directories to watch for the given host.
+fn system_dirs(macos: bool, arch: &str) -> Vec<PathBuf> {
+    let mut dirs: Vec<String> = ["/usr/include", "/usr/lib", "/usr/local/include", "/usr/local/lib"]
+        .iter()
+        .map(|dir| dir.to_string())
+        .collect();
+    if macos {
+        dirs.extend(MACOS_DIRS.iter().map(|dir| dir.to_string()));
+    } else {
+        dirs.push(format!("/usr/lib/{}", multiarch_dir(arch)));
+    }
+    dirs.into_iter().map(PathBuf::from).collect()
+}
+
+/// Debian-style multiarch directory name for a Rust `ARCH` constant.
+fn multiarch_dir(arch: &str) -> String {
+    match arch {
+        "x86" => "i386-linux-gnu".to_string(),
+        "arm" => "arm-linux-gnueabihf".to_string(),
+        "powerpc64" => "powerpc64le-linux-gnu".to_string(),
+        other => format!("{other}-linux-gnu"),
+    }
+}
+
+/// Directory mtimes that move when system headers or libraries are installed or removed.
+fn system_dirs_identity(cmd: &ProcessBuilder) -> Vec<u8> {
+    let macos = cfg!(target_os = "macos");
+    let mut dirs = system_dirs(macos, std::env::consts::ARCH);
+    if macos {
+        dirs.extend(cmd.get_env("SDKROOT").map(PathBuf::from));
+    }
+    let rows: Vec<String> = dirs
+        .iter()
+        .map(|dir| match fs::metadata(dir) {
+            Ok(meta) => format!("{}\0{}\n", dir.display(), mtime_ns(&meta)),
+            Err(_) => format!("{}\0{ABSENT}\n", dir.display()),
+        })
+        .collect();
+    rows.concat().into_bytes()
+}
+
+fn dir_is_empty(dir: &Path) -> bool {
+    fs::read_dir(dir).is_ok_and(|mut items| items.next().is_none())
+}
+
+/// One captured OUT_DIR entry, still pointing at the live file.
+struct Captured {
+    rel: String,
+    kind: &'static str,
+    mode: u32,
+    size: u64,
+    abs: PathBuf,
+    target: Option<String>,
+}
+
+impl Captured {
+    /// Copies file content into the entry as a blob and returns the manifest node.
+    fn record(&self, entry_dir: &Path) -> io::Result<TreeNode> {
+        let (size, blake3) = if self.kind == "file" {
+            let blob = put_blob(entry_dir, &self.rel, File::open(&self.abs)?)?;
+            (blob.size, Some(blob.blake3))
+        } else {
+            (0, None)
+        };
+        Ok(TreeNode {
+            path: self.rel.clone(),
+            kind: self.kind.to_string(),
+            mode: self.mode,
+            size,
+            blake3,
+            target: self.target.clone(),
+        })
+    }
+}
+
+/// Lists OUT_DIR, refusing anything that could not be restored faithfully: absolute or escaping
+/// symlinks, special files, non-UTF-8 names and trees larger than `max_bytes`.
+fn capture_tree(root: &Path, max_bytes: u64) -> Result<Vec<Captured>, ScriptSkip> {
+    let mut nodes = Vec::new();
+    let mut total = 0u64;
+    walk(root, root, max_bytes, &mut total, &mut nodes)?;
+    // Parents sort before their children, which restore relies on.
+    nodes.sort_by(|a, b| a.rel.cmp(&b.rel));
+    Ok(nodes)
+}
+
+fn walk(
+    root: &Path,
+    dir: &Path,
+    max_bytes: u64,
+    total: &mut u64,
+    nodes: &mut Vec<Captured>,
+) -> Result<(), ScriptSkip> {
+    for item in fs::read_dir(dir)? {
+        let path = item?.path();
+        let rel = path
+            .strip_prefix(root)
+            .ok()
+            .and_then(Path::to_str)
+            .ok_or(ScriptSkip::Reason("out-dir-not-utf8"))?
+            .to_string();
+        let meta = fs::symlink_metadata(&path)?;
+        let file_type = meta.file_type();
+        let mut node = Captured {
+            rel,
+            kind: "dir",
+            mode: file_mode(&meta),
+            size: 0,
+            abs: path.clone(),
+            target: None,
+        };
+        if file_type.is_dir() {
+            nodes.push(node);
+            walk(root, &path, max_bytes, total, nodes)?;
+        } else if file_type.is_file() {
+            *total = total.saturating_add(meta.len());
+            if *total > max_bytes {
+                return Err(ScriptSkip::Reason("out-dir-too-large"));
+            }
+            node.kind = "file";
+            node.size = meta.len();
+            nodes.push(node);
+        } else if file_type.is_symlink() {
+            let target = fs::read_link(&path)?;
+            if target.is_absolute() {
+                return Err(ScriptSkip::Reason("absolute-symlink"));
+            }
+            let target = target.to_str().ok_or(ScriptSkip::Reason("out-dir-not-utf8"))?.to_string();
+            if !symlink_target_safe(&node.rel, &target) {
+                return Err(ScriptSkip::Reason("symlink-escapes"));
+            }
+            node.kind = "symlink";
+            node.target = Some(target);
+            nodes.push(node);
+        } else {
+            return Err(ScriptSkip::Reason("special-file"));
+        }
+    }
+    Ok(())
+}
+
+/// Replaces OUT_DIR's contents with the stored tree: files by reflink or copy. Every file,
+/// symlink and directory, OUT_DIR included, ends up with mtime `stamp`.
+fn restore_tree(
+    entry_dir: &Path,
+    nodes: &[TreeNode],
+    out_dir: &Path,
+    stamp: FileTime,
+) -> io::Result<()> {
+    fs::create_dir_all(out_dir)?;
+    clear_dir(out_dir)?;
+    for node in nodes {
+        ensure_real_parents(out_dir, &node.path)?;
+        let dest = out_dir.join(&node.path);
+        match (node.kind.as_str(), &node.blake3, &node.target) {
+            ("dir", _, _) => fs::create_dir(&dest)?,
+            ("file", Some(hash), _) => {
+                clone_or_copy(&entry_dir.join(hash), &dest, hash, stamp)?;
+                apply_mode(&dest, node.mode)?;
+            }
+            ("symlink", _, Some(target)) => {
+                make_symlink(target, &dest)?;
+                filetime::set_symlink_file_times(&dest, stamp, stamp)?;
+            }
+            _ => return Err(io::Error::other("malformed tree node")),
+        }
+    }
+    // Creating entries moved the directories' mtimes; set them last, children before parents.
+    for node in nodes.iter().rev().filter(|node| node.kind == "dir") {
+        filetime::set_file_mtime(out_dir.join(&node.path), stamp)?;
+    }
+    filetime::set_file_mtime(out_dir, stamp)
+}
+
+/// Refuses to create a node below anything that is not a real directory on disk, so a symlink
+/// restored earlier can never redirect later writes out of OUT_DIR.
+fn ensure_real_parents(out_dir: &Path, rel: &str) -> io::Result<()> {
+    let mut current = out_dir.to_path_buf();
+    if let Some(parent) = Path::new(rel).parent() {
+        for part in parent.components() {
+            current.push(part);
+            if !fs::symlink_metadata(&current)?.file_type().is_dir() {
+                return Err(io::Error::other("restore path crosses a non-directory"));
+            }
+        }
+    }
+    Ok(())
+}
+
+/// Which directory next to OUT_DIR a snapshot entry came from, to tell Cargo's own files apart.
+#[derive(Clone, Copy)]
+enum Watch {
+    Profile,
+    /// Flat layout: `build/<package>-<hash>/` directories live directly in `build/`.
+    Build,
+    /// Per-unit layout: `build/<package>/<hash>/`; `build/` holds one directory per package.
+    BuildPerUnit,
+    /// Per-unit layout: the script's package directory, shared by that package's units.
+    Package,
+    Run,
+    Deps,
+}
+
+/// Entries of the profile directory, `build/`, the script's own run directory, `deps/` and, in
+/// the per-unit layout, the package directory (all non-recursive), minus what Cargo itself
+/// creates there. A script that writes anything else outside OUT_DIR produces a difference
+/// between two snapshots. `None` when OUT_DIR sits in neither
+/// `<profile>/build/<package>-<hash>/out` nor `<profile>/build/<package>/<hash>/out`.
+fn snapshot_outside(out_dir: &Path) -> Option<Snapshot> {
+    let run_dir = out_dir.parent()?;
+    // A bare 16-hex run directory name is the unit hash of the per-unit layout.
+    let per_unit = run_dir.file_name()?.to_str().is_some_and(is_hex16);
+    let (package_dir, build) = if per_unit {
+        let package = run_dir.parent()?;
+        (Some(package), package.parent()?)
+    } else {
+        (None, run_dir.parent()?)
+    };
+    if build.file_name()? != "build" {
+        return None;
+    }
+    let profile = build.parent()?;
+    let mut watched = vec![
+        (profile.to_path_buf(), Watch::Profile),
+        (build.to_path_buf(), if per_unit { Watch::BuildPerUnit } else { Watch::Build }),
+        (run_dir.to_path_buf(), Watch::Run),
+        (profile.join("deps"), Watch::Deps),
+    ];
+    if let Some(package) = package_dir {
+        watched.push((package.to_path_buf(), Watch::Package));
+    }
+    let mut snapshot = Snapshot::new();
+    for (dir, watch) in watched {
+        let Ok(items) = fs::read_dir(&dir) else { continue };
+        for item in items.flatten() {
+            let name = item.file_name().to_string_lossy().into_owned();
+            let is_dir = item.file_type().is_ok_and(|kind| kind.is_dir());
+            // The script's own run directory is watched separately, entry by entry.
+            if cargo_owned(watch, &name, is_dir) || item.path() == run_dir {
+                continue;
+            }
+            if let Ok(meta) = item.metadata() {
+                snapshot.insert(item.path(), (meta.len(), mtime_ns(&meta)));
+            }
+        }
+    }
+    Some(snapshot)
+}
+
+/// Other units compile, link and run scripts while this script runs, so their artifacts and
+/// directories are not the script's doing.
+fn cargo_owned(watch: Watch, name: &str, is_dir: bool) -> bool {
+    match watch {
+        Watch::Profile => PROFILE_DIR_ENTRIES.contains(&name),
+        Watch::Run => RUN_DIR_FILES.contains(&name),
+        Watch::Build | Watch::Deps => has_hash_suffix(name),
+        // Every directory is some package's, created by whichever unit starts first.
+        Watch::BuildPerUnit => is_dir,
+        Watch::Package => is_hex16(name) || has_hash_suffix(name),
+    }
+}
+
+fn is_hex16(text: &str) -> bool {
+    text.len() == 16 && text.bytes().all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+}
+
+/// `libfoo-0123456789abcdef.rlib`, `foo-0123456789abcdef`: a stem ending in `-` and 16 hex digits.
+fn has_hash_suffix(name: &str) -> bool {
+    let stem = name.split('.').next().unwrap_or(name);
+    stem.rsplit_once('-').is_some_and(|(_, hash)| is_hex16(hash))
+}
+
+fn clear_dir(dir: &Path) -> io::Result<()> {
+    for item in fs::read_dir(dir)? {
+        let path = item?.path();
+        if fs::symlink_metadata(&path)?.is_dir() {
+            fs::remove_dir_all(&path)?;
+        } else {
+            fs::remove_file(&path)?;
+        }
+    }
+    Ok(())
+}
+
+#[cfg(unix)]
+fn file_mode(meta: &fs::Metadata) -> u32 {
+    use std::os::unix::fs::PermissionsExt;
+    meta.permissions().mode() & 0o7777
+}
+
+#[cfg(not(unix))]
+fn file_mode(_meta: &fs::Metadata) -> u32 {
+    0o644
+}
+
+/// Only the executable bit is preserved; restored files are otherwise ordinary 0644 outputs.
+#[cfg(unix)]
+fn apply_mode(path: &Path, mode: u32) -> io::Result<()> {
+    use std::os::unix::fs::PermissionsExt;
+    let mode = if mode & 0o111 != 0 { 0o755 } else { 0o644 };
+    fs::set_permissions(path, fs::Permissions::from_mode(mode))
+}
+
+#[cfg(not(unix))]
+fn apply_mode(_path: &Path, _mode: u32) -> io::Result<()> {
+    Ok(())
+}
+
+#[cfg(unix)]
+fn make_symlink(target: &str, link: &Path) -> io::Result<()> {
+    std::os::unix::fs::symlink(target, link)
+}
+
+#[cfg(not(unix))]
+fn make_symlink(_target: &str, _link: &Path) -> io::Result<()> {
+    Err(io::ErrorKind::Unsupported.into())
+}
