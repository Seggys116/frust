+        fs::write(system.join("libz.so"), b"shared is not bundled").unwrap();
+        let with = |static_flag: Option<&str>| {
+            let mut cmd = command(&cache);
+            cmd.arg("-L").arg(format!("native={}", system.display()));
+            if let Some(flag) = static_flag {
+                cmd.arg("-l").arg(flag);
+            }
+            key_of(&cache, &cmd)
+        };
+        // Without a static link the system directory is not an input.
+        let dynamic = with(Some("dylib=z"));
+        fs::write(system.join("libz.a"), b"zlib two, different").unwrap();
+        assert_eq!(dynamic, with(Some("dylib=z")));
+        assert_eq!(with(None), with(None));
+
+        let first = with(Some("static=z"));
+        assert_ne!(first, dynamic);
+        fs::write(system.join("libz.a"), b"zlib three").unwrap();
+        assert_ne!(first, with(Some("static=z")));
+        let modifiers = with(Some("static:+whole-archive=z"));
+        // Lengths differ at every step so the per-process hash memo cannot mask a change.
+        fs::write(system.join("libz.a"), b"zlib four, longer still").unwrap();
+        assert_ne!(modifiers, with(Some("static:+whole-archive=z")));
+        // Shared objects never enter the digest.
+        let before = with(Some("static=z"));
+        fs::write(system.join("libz.so"), b"changed shared object").unwrap();
+        assert_eq!(before, with(Some("static=z")));
+    }
