+    /// Writes an entry holding `size` bytes of output plus a 20 byte dep-info, aged `age_secs`.
+    fn put_entry(store: &Store, src_dir: &Path, seed: u8, size: usize, age_secs: u64) -> String {
+        let key = format!("{seed:02x}").repeat(32);
+        let src = src_dir.join(format!("out-{seed}"));
+        fs::write(&src, vec![seed; size]).unwrap();
+        let dep_info = ("x.d".to_string(), vec![b'd'; 20]);
+        store
+            .write_entry(&key, "tc", &[("libx.rlib".to_string(), src)], dep_info, Vec::new(), Recorded::default())
+            .unwrap()
+            .unwrap();
+        let when = FileTime::from_unix_time(now_unix() as i64 - age_secs as i64, 0);
+        for item in fs::read_dir(store.entry_dir(&key)).unwrap().flatten() {
+            filetime::set_file_mtime(item.path(), when).unwrap();
+        }
+        key
+    }
