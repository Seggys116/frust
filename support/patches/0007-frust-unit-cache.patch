+    #[test]
+    fn tree_round_trip_keeps_modes_symlinks_and_empty_dirs() {
+        let (tmp, store) = fixture();
+        let cache = script_cache(tmp.path(), "a", &store);
+        let bin = program(tmp.path(), "script v1");
+        let cmd = command(&cache, &bin);
+        let key = run_and_store(&cache, &cmd);
+        let entry = read_entry(&store, &key);
+        assert_eq!(entry.kind, KIND);
+        assert_eq!(entry.bound_dir.as_deref(), cache.build_dir.to_str());
+
+        clear_dir(&cache.out_dir).unwrap();
+        fs::write(cache.out_dir.join("leftover"), "must disappear").unwrap();
+        let started = SystemTime::now() - Duration::from_secs(2);
+        let ScriptLookup::Hit { stdout, stderr } = cache.lookup(&cmd) else { panic!("expected a hit") };
+        assert_eq!((stdout.as_slice(), stderr.as_slice()), (OUT, ERR));
+
+        let out = &cache.out_dir;
+        assert!(!out.join("leftover").exists());
+        assert_eq!(fs::read_to_string(out.join("gen.rs")).unwrap(), "pub const X: u32 = 1;");
+        assert_eq!(fs::read_to_string(out.join("sub").join("data.txt")).unwrap(), "data");
+        assert!(out.join("empty").is_dir());
+        assert!(out.join("sub").join("deeper").is_dir());
+        let tool = fs::metadata(out.join("sub").join("tool.sh")).unwrap();
+        assert_eq!(tool.permissions().mode() & 0o777, 0o755);
+        let data = fs::metadata(out.join("sub").join("data.txt")).unwrap();
+        assert_eq!(data.permissions().mode() & 0o777, 0o644);
+        assert_eq!(fs::read_link(out.join("sub").join("link")).unwrap(), Path::new("data.txt"));
+        assert_eq!(fs::read_link(out.join("sub").join("up")).unwrap(), Path::new("../gen.rs"));
+        assert_eq!(fs::read_to_string(out.join("sub").join("up")).unwrap(), "pub const X: u32 = 1;");
+        assert!(data.modified().unwrap() >= started, "restored files are stamped now");
+    }
