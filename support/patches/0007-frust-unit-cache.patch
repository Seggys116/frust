+    #[test]
+    fn key_is_stable_and_sensitive_to_every_input() {
+        let (tmp, store) = fixture();
+        let cache = script_cache(tmp.path(), "a", &store);
+        let bin = program(tmp.path(), "script v1");
+        let base = key_of(&cache, &command(&cache, &bin));
+        assert_eq!(base, key_of(&cache, &command(&cache, &bin)));
+
+        let mut cmd = command(&cache, &bin);
+        cmd.env("SOME_VAR", "1");
+        let with_var = key_of(&cache, &cmd);
+        assert_ne!(base, with_var);
+        cmd.env("SOME_VAR", "2");
+        assert_ne!(with_var, key_of(&cache, &cmd));
+
+        let mut cmd = command(&cache, &bin);
+        cmd.arg("--flag");
+        assert_ne!(base, key_of(&cache, &cmd));
+
+        let mut other = script_cache(tmp.path(), "a", &store);
+        other.package = "heavy 1.0.1\nregistry\nchecksum".to_string();
+        assert_ne!(base, key_of(&other, &command(&other, &bin)));
+        let mut other = script_cache(tmp.path(), "a", &store);
+        other.toolchain.verbose_version = "rustc 2.0.0 (test)".to_string();
+        assert_ne!(base, key_of(&other, &command(&other, &bin)));
+    }
