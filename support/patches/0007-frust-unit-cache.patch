+    #[test]
+    fn one_pass_hashes_and_copies_each_byte_once() {
+        let tmp = tempdir().unwrap();
+        let len = 3 * HASH_BUF + 17;
+        let data: Vec<u8> = (0..len).map(|i| (i * 31 % 251) as u8).collect();
+        let mut reader = CountingReader { data: data.clone(), pos: 0, reads: 0 };
+        let copy_path = tmp.path().join("copy");
+        let mut copy = OpenOptions::new().write(true).create_new(true).open(&copy_path).unwrap();
+        let (size, hash) = stream_blake3(&mut reader, len as u64, Some(&mut copy)).unwrap();
+        drop(copy);
+        assert_eq!(size, len as u64);
+        assert_eq!(hash, *blake3::hash(&data).as_bytes());
+        assert_eq!(fs::read(&copy_path).unwrap(), data);
+        // Three full 1 MiB reads, the 17 byte tail and the end-of-file read: no second pass.
+        assert_eq!((reader.pos, reader.reads), (len, 5));
+
+        let mut hash_only = CountingReader { data, pos: 0, reads: 0 };
+        let (_, again) = stream_blake3(&mut hash_only, len as u64, None).unwrap();
+        assert_eq!(again, hash);
+        assert_eq!(hash_only.reads, 5);
+    }
