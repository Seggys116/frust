+    /// Writes what a successful rustc run leaves behind; `deps` extend the dep-info file list.
+    fn fake_compile(cache: &UnitCache, deps: &[&Path], env_lines: &[&str]) {
+        for (path, body) in cache.outputs.iter().zip(["rlib-bytes", "rmeta-bytes"]) {
+            // A real compile replaces whatever a restore left behind.
+            let _ = fs::remove_file(path);
+            fs::write(path, body).unwrap();
+        }
+        let src = cache.pkg_root.join("src").join("lib.rs");
+        let mut first = format!("{}: {}", cache.dep_info.display(), src.display());
+        for dep in deps {
+            first.push_str(&format!(" {}", dep.display()));
+        }
+        let mut text = format!("{first}\n\n{}:\n", src.display());
+        for dep in deps {
+            text.push_str(&format!("{}:\n", dep.display()));
+        }
+        for line in env_lines {
+            text.push_str(&format!("\n# env-dep:{line}"));
+        }
+        text.push('\n');
+        fs::write(&cache.dep_info, text).unwrap();
+    }
+
+    fn remove_outputs(cache: &UnitCache) {
+        for path in cache.outputs.iter().chain([&cache.dep_info]) {
