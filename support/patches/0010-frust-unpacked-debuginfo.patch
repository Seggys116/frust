+#[derive(Debug)]
+struct SplitOutputs {
+    prefix: String,
+    apple_target: bool,
+}
+
+impl SplitOutputs {
+    fn from_rustc(
+        args: &[&OsStr],
+        dep_info: &Path,
+        apple_target: bool,
+    ) -> Result<Option<Self>, &'static str> {
+        const UNSUPPORTED: &str = "split-debuginfo-custom-outputs";
+        let mut emits = args.iter().filter(|arg| {
+            let arg = arg.as_encoded_bytes();
+            arg == b"--emit" || arg.starts_with(b"--emit=")
+        });
+        let emit = emits.next().ok_or(UNSUPPORTED)?.as_encoded_bytes();
+        if emits.next().is_some() {
+            return Err(UNSUPPORTED);
+        }
+        if emit == b"--emit=dep-info,metadata" {
+            return Ok(None);
+        }
+        if !matches!(emit, b"--emit=dep-info,metadata,link" | b"--emit=dep-info,link") {
+            return Err(UNSUPPORTED);
+        }
+        let custom = args.iter().any(|arg| {
+            let arg = arg.as_encoded_bytes();
+            let option = arg.strip_prefix(b"-C").or_else(|| arg.strip_prefix(b"-Z")).unwrap_or(arg);
+            arg.starts_with(b"-o") || [
+                b"temps-dir".as_slice(),
+                b"dwarf-out-dir",
+                b"dwo-out-dir",
+                b"codegen-backend",
+                b"save-temps",
+            ].into_iter().any(|name| option == name ||
+                option.strip_prefix(name).is_some_and(|tail| tail.starts_with(b"=")))
+        });
+        if custom {
+            return Err(UNSUPPORTED);
+        }
+        let stem = dep_info.file_stem().and_then(OsStr::to_str).ok_or(UNSUPPORTED)?;
+        Ok(Some(Self { prefix: format!("{stem}."), apple_target }))
+    }
+
+    fn matches(&self, name: &str) -> bool {
+        let Some(cgu) = name.strip_prefix(&self.prefix) else { return false };
+        cgu.ends_with(".rcgu.o")
+            || cgu.ends_with(".rcgu.asm.o")
+            || (!self.apple_target && cgu.ends_with(".rcgu.dwo"))
+    }
+
+    fn list(&self, out_dir: &Path) -> io::Result<Vec<PathBuf>> {
+        let entries = match fs::read_dir(out_dir) {
+            Ok(entries) => entries,
+            Err(err) if err.kind() == io::ErrorKind::NotFound => return Ok(Vec::new()),
+            Err(err) => return Err(err),
+        };
+        let mut paths = Vec::new();
+        for entry in entries {
+            let entry = entry?;
+            if entry.file_name().to_str().is_some_and(|name| self.matches(name)) {
+                if !entry.file_type()?.is_file() {
+                    return Err(io::Error::other("debug companion is not a regular file"));
+                }
+                paths.push(entry.path());
+            }
+        }
+        paths.sort_unstable();
+        Ok(paths)
+    }
+
+    fn clear(&self, out_dir: &Path) -> io::Result<()> {
+        // Called only on a miss under Cargo's build locks, before rustc starts.
+        for path in self.list(out_dir)? {
+            fs::remove_file(path)?;
+        }
+        Ok(())
+    }
+}
