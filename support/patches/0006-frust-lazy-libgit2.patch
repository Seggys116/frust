diff --git a/src/util/vcs.rs b/src/util/vcs.rs
index 2d747e1..aef085d 100644
--- a/src/util/vcs.rs
+++ b/src/util/vcs.rs
@@ -2,6 +2,32 @@ use crate::util::CargoResult;
 use cargo_util::ProcessBuilder;
 use cargo_util::paths;
 use std::path::Path;
+use std::sync::Once;
+use std::sync::atomic::{AtomicBool, Ordering};
+
+static GIT_OWNER_VALIDATION_OFF: AtomicBool = AtomicBool::new(false);
+static GIT_INIT: Once = Once::new();
+
+/// Records that the binary wants libgit2 owner validation disabled. The
+/// option is applied by the first [`ensure_git_init`] call, so builds that
+/// never touch git avoid initializing libgit2 and its TLS stack.
+pub fn defer_git_init() {
+    GIT_OWNER_VALIDATION_OFF.store(true, Ordering::Release);
+}
+
+/// Initializes libgit2 on first use. Call before any libgit2 repository,
+/// config or transport entry point.
+pub fn ensure_git_init() {
+    GIT_INIT.call_once(|| {
+        if GIT_OWNER_VALIDATION_OFF.load(Ordering::Acquire) {
+            // SAFETY: runs once, before any repository is opened.
+            unsafe {
+                git2::opts::set_verify_owner_validation(false)
+                    .expect("set_verify_owner_validation should never fail");
+            }
+        }
+    });
+}
 
