+++ b/src/compiler/build_runner/frust_retention.rs
@@ -0,0 +1,80 @@
+use super::BuildRunner;
+use crate::compiler::CompileKind;
+use std::collections::{BTreeMap, BTreeSet};
+use std::fs;
+use std::io;
+use std::path::Path;
+
+const KEEP_INACTIVE: usize = 3;
+const SEEN: &str = ".frust-retention";
+
+pub(super) fn collect(build: &BuildRunner<'_, '_>) {
+    let bcx = build.bcx;
+    if !bcx.ws.frust_manages_target()
+        || bcx.gctx.get_env_os("FRUST_GC").is_some_and(|value| value == "0")
+        || bcx.gctx.cli_unstable().fine_grain_locking
+        || bcx.unit_graph.keys().any(|unit| unit.kind != CompileKind::Host)
+        || !build.files().layout(CompileKind::Host).build_dir().frust_has_build_lock()
+    {
+        return;
+    }
+    let result = prune(build);
+    if let Err(error) = result {
+        tracing::debug!(%error, "fRust managed build retention skipped");
+    }
+}
+
+fn prune(build: &BuildRunner<'_, '_>) -> io::Result<()> {
+    let roots: Vec<_> = build.bcx.roots.iter().map(|unit| {
+        build.files().out_dir_new_layout(unit).with_file_name(SEEN)
+    }).collect();
+    if roots.iter().all(|marker| marker.is_file()) {
+        return Ok(());
+    }
+
+    let mut packages = BTreeMap::new();
+    for unit in build.bcx.unit_graph.keys().chain(build.bcx.roots.iter()) {
+        let output = build.files().out_dir_new_layout(unit);
+        if let Some(unit_dir) = output.parent()
+            && let Some(package) = unit_dir.parent()
+            && let Some(hash) = unit_dir.file_name()
+        {
+            packages.entry(package.to_path_buf()).or_insert_with(BTreeSet::new)
+                .insert(hash.to_owned());
+        }
+    }
+    for (path, live) in packages {
+        if !is_real_dir(&path) {
+            continue;
+        }
+        let mut inactive = Vec::new();
+        for entry in fs::read_dir(path)? {
+            let entry = entry?;
+            let name = entry.file_name();
+            let valid_hash = name.to_str().is_some_and(|text|
+                text.len() == 16 && text.bytes().all(|byte| byte.is_ascii_hexdigit()));
+            if !valid_hash || live.contains(&name) || !entry.file_type()?.is_dir() {
+                continue;
+            }
+            let unit = entry.path();
+            if is_real_dir(&unit.join("fingerprint")) {
+                inactive.push((entry.metadata()?.modified()?, unit));
+            }
+        }
+        inactive.sort_unstable_by(|left, right| right.cmp(left));
+        for (_, unit) in inactive.into_iter().skip(KEEP_INACTIVE) {
+            fs::remove_dir_all(unit)?;
+        }
+    }
+
+    for marker in roots {
+        if marker.parent().is_some_and(is_real_dir) && !marker.exists() {
+            drop(fs::OpenOptions::new().write(true).create_new(true).open(marker)?);
+        }
+    }
+    Ok(())
+}
+
+fn is_real_dir(path: &Path) -> bool {
+    fs::symlink_metadata(path).is_ok_and(|metadata| metadata.is_dir())
+}
